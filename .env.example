# BotoView Environment Variables Example
# Copy this file to .env or .dev.vars for local development

# IndexNow verification key for search engine instant indexing (Bing, DuckDuckGo, etc.)
INDEXNOW_KEY=your_indexnow_key_here

# Google Search Console verification token (for <meta name="google-site-verification">)
GOOGLE_SITE_VERIFICATION=your_google_verification_token

