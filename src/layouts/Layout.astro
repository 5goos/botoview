---
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
	keywords?: string;
	canonical?: string;
	ogType?: string;
	bodyClass?: string;
	robots?: string;
	jsonLd?: Record<string, any> | Array<Record<string, any>>;
	googleSiteVerification?: string;
}
const {
	title = "BotoView — AWS Boto3 Changelog & Release Notes",
	description = "Track and filter AWS Boto3 changelogs and release notes by service. Explore Boto3 version updates, breaking changes, and SDK history in real time.",
	keywords = "boto3 changelog, botocore release notes, aws boto3 updates, boto3 changelog by service, aws python sdk tracker, botoview, 5goos",
	canonical,
	ogType = "website",
	bodyClass = "min-h-screen w-full transition-colors duration-500",
	robots = "index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1",
	jsonLd,
	googleSiteVerification = process.env.GOOGLE_SITE_VERIFICATION || (import.meta.env as any)?.PUBLIC_GOOGLE_SITE_VERIFICATION || "yNlBXN3mZgfAx_NAuIyOfebJcgd9H0sczXDus8gfYPA",
} = Astro.props;

const normalizeCanonical = (urlStr?: string): string => {
	if (!urlStr) {
		const rawPath = Astro.url.pathname;
		const hasExt = /\.[a-zA-Z0-9]+$/.test(rawPath);
		const normalizedPath = hasExt || rawPath.endsWith('/') ? rawPath : `${rawPath}/`;
		return new URL(normalizedPath, Astro.site || 'https://botoview.5goos.com').href;
	}
	try {
		const parsed = new URL(urlStr);
		const hasExt = /\.[a-zA-Z0-9]+$/.test(parsed.pathname);
		if (!hasExt && !parsed.pathname.endsWith('/')) {
			parsed.pathname = `${parsed.pathname}/`;
		}
		return parsed.href;
	} catch {
		return urlStr.endsWith('/') ? urlStr : `${urlStr}/`;
	}
};

const canonicalUrl = normalizeCanonical(canonical);

const userGraph = Array.isArray(jsonLd) ? jsonLd : (jsonLd ? [jsonLd] : []);
const hasCustomFaq = userGraph.some((node: any) => node?.["@type"] === "FAQPage");

const defaultGraph = [
	{
		"@type": "WebSite",
		"@id": "https://botoview.5goos.com/#website",
		"url": "https://botoview.5goos.com/",
		"name": "BotoView",
		"alternateName": ["BotoView by 5goos", "5goos BotoView", "BotoView App"],
		"publisher": { "@id": "https://5goos.com/#organization" },
		"description": description,
		"potentialAction": {
			"@type": "SearchAction",
			"target": "https://botoview.5goos.com/?s={search_term_string}",
			"query-input": "required name=search_term_string"
		}
	},
	{
		"@type": "Organization",
		"@id": "https://5goos.com/#organization",
		"name": "5goos",
		"url": "https://5goos.com/",
		"logo": {
			"@type": "ImageObject",
			"url": "https://botoview.5goos.com/favicon.png",
			"width": 512,
			"height": 512
		},
		"sameAs": [
			"https://github.com/5goos",
			"https://github.com/5goos/botoview"
		]
	},
	{
		"@type": "SoftwareApplication",
		"@id": "https://botoview.5goos.com/#software",
		"name": "BotoView",
		"alternateName": ["BotoView by 5goos", "5goos BotoView"],
		"applicationCategory": "DeveloperApplication",
		"operatingSystem": "Web",
		"url": "https://botoview.5goos.com/",
		"author": { "@id": "https://5goos.com/#organization" },
		"creator": { "@id": "https://5goos.com/#organization" },
		"description": description,
		"offers": {
			"@type": "Offer",
			"price": "0",
			"priceCurrency": "USD"
		}
	}
];

const structuredData = {
	"@context": "https://schema.org",
	"@graph": [
		...defaultGraph,
		...userGraph
	]
};
---
<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="keywords" content={keywords} />
		<meta name="author" content="Naveen Thurimerla" />
		<meta name="robots" content={robots} />
		<link rel="canonical" href={canonicalUrl} />

		<meta name="msvalidate.01" content="EA96FCA4764C5D0B8E4B3EB0811BD6DE" />
		<meta name="google-site-verification" content={googleSiteVerification} />

		<meta name="theme-color" content="#07090e" media="(prefers-color-scheme: dark)" />
		<meta name="theme-color" content="#f8fafc" media="(prefers-color-scheme: light)" />
		<meta name="mobile-web-app-capable" content="yes" />
		<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />

		<meta property="og:type" content={ogType} />
		<meta property="og:locale" content="en_US" />
		<meta property="og:site_name" content="BotoView by 5goos" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:image" content="https://botoview.5goos.com/og-image.png" />
		<meta property="og:image:alt" content="BotoView — AWS Boto3 Changelog Explorer" />
		<meta property="og:image:type" content="image/png" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:site" content="@5goos" />
		<meta name="twitter:creator" content="@thurimerla" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content="https://botoview.5goos.com/og-image.png" />
		<meta name="twitter:image:alt" content="BotoView — AWS Boto3 Changelog Explorer" />

		<link rel="manifest" href="/site.webmanifest" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<link rel="icon" href="/favicon.ico" sizes="32x32" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />

		<script is:inline>
			(function() {
				const getPreferredTheme = () => {
					const saved = localStorage.getItem('theme');
					if (saved === 'dark' || saved === 'light') return saved;
					return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
				};
				const theme = getPreferredTheme();
				document.documentElement.classList.toggle('dark', theme === 'dark');

				window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (e) => {
					if (!localStorage.getItem('theme')) {
						document.documentElement.classList.toggle('dark', e.matches);
					}
				});
			})();
		</script>

		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap" />
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet" media="print" onload="this.media='all'" />
		<noscript>
			<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet" />
		</noscript>

		<script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
	</head>
	<body class={bodyClass}>
		<a href="#mainScrollArea" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[200] focus:px-4 focus:py-2 focus:rounded-lg focus:bg-indigo-600 focus:text-white focus:text-sm focus:font-bold focus:shadow-lg">Skip to content</a>
		<noscript>
			<div style="padding: 0.75rem 1.25rem; background: #eef2ff; color: #1e1b4b; font-family: sans-serif; font-size: 0.85rem; border-bottom: 1px solid #c7d2fe;">
				<strong>BotoView:</strong> Enable JavaScript for interactive filtering, or browse the <a href="/services/" style="text-decoration: underline; font-weight: 700;">AWS Services Directory</a> and <a href="/releases/" style="text-decoration: underline; font-weight: 700;">Boto3 Releases Archive</a>.
			</div>
		</noscript>
		<slot />
	</body>
</html>
