---
import '../styles/global.css';
import CommandPalette from '../components/CommandPalette.astro';

interface Props {
	title?: string;
	description?: string;
	keywords?: string;
	canonical?: string;
	ogType?: string;
	bodyClass?: string;
	robots?: string;
	jsonLd?: Record<string, unknown> | Array<Record<string, unknown>>;
	includeDefaultApp?: boolean;
	googleSiteVerification?: string;
}

const {
	title = "BotoView — AWS Boto3 Changelogs & Release Notes",
	description = "Browse AWS Boto3 changelogs and release notes by service with BotoView. Search API changes, bug fixes, and SDK updates across 580+ AWS services.",
	keywords = "botoview, boto3 changelogs, aws boto3 changelogs, botocore release notes, aws python sdk changelog",
	canonical,
	ogType = "website",
	bodyClass = "min-h-screen w-full transition-colors duration-200",
	robots = "index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1",
	jsonLd,
	includeDefaultApp = true,
	googleSiteVerification = process.env.GOOGLE_SITE_VERIFICATION || (import.meta.env as Record<string, string | undefined>)?.PUBLIC_GOOGLE_SITE_VERIFICATION || "yNlBXN3mZgfAx_NAuIyOfebJcgd9H0sczXDus8gfYPA",
} = Astro.props;

const normalizeCanonical = (urlStr?: string): string => {
	if (!urlStr) {
		const rawPath = Astro.url.pathname;
		const hasExt = /\.[a-zA-Z0-9]+$/.test(rawPath);
		const normalizedPath = hasExt || rawPath.endsWith('/') ? rawPath : `${rawPath}/`;
		return new URL(normalizedPath, Astro.site || 'https://botoview.5goos.com').href;
	}
	try {
		const parsed = new URL(urlStr);
		const hasExt = /\.[a-zA-Z0-9]+$/.test(parsed.pathname);
		if (!hasExt && !parsed.pathname.endsWith('/')) {
			parsed.pathname = `${parsed.pathname}/`;
		}
		return parsed.href;
	} catch {
		return urlStr.endsWith('/') ? urlStr : `${urlStr}/`;
	}
};

const canonicalUrl = normalizeCanonical(canonical);
const userGraph = Array.isArray(jsonLd) ? jsonLd : (jsonLd ? [jsonLd] : []);

const defaultGraph: Array<Record<string, unknown>> = [
	{
		"@type": "WebSite",
		"@id": "https://botoview.5goos.com/#website",
		"url": "https://botoview.5goos.com/",
		"name": "BotoView",
		"alternateName": ["BotoView by 5goos", "5goos BotoView", "BotoView AWS Boto3 Changelogs"],
		"inLanguage": "en-US",
		"publisher": { "@id": "https://5goos.com/#organization" },
		"description": description,
		"potentialAction": {
			"@type": "SearchAction",
			"target": "https://botoview.5goos.com/?s={search_term_string}",
			"query-input": "required name=search_term_string"
		}
	},
	{
		"@type": "Organization",
		"@id": "https://5goos.com/#organization",
		"name": "5goos",
		"url": "https://5goos.com/",
		"logo": {
			"@type": "ImageObject",
			"url": "https://botoview.5goos.com/favicon.png",
			"width": 512,
			"height": 512
		},
		"sameAs": [
			"https://github.com/5goos",
			"https://github.com/5goos/botoview"
		]
	}
];

if (includeDefaultApp) {
	defaultGraph.push({
		"@type": "SoftwareApplication",
		"@id": "https://botoview.5goos.com/#software",
		"name": "BotoView",
		"alternateName": ["BotoView by 5goos", "5goos BotoView"],
		"applicationCategory": "DeveloperApplication",
		"operatingSystem": "Web",
		"url": "https://botoview.5goos.com/",
		"author": { "@id": "https://5goos.com/#organization" },
		"creator": { "@id": "https://5goos.com/#organization" },
		"description": description,
		"offers": {
			"@type": "Offer",
			"price": "0",
			"priceCurrency": "USD"
		}
	});
}

const structuredData = {
	"@context": "https://schema.org",
	"@graph": [
		...defaultGraph,
		...userGraph
	]
};
---
<!DOCTYPE html>
<html lang="en" class="dark">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="keywords" content={keywords} />
		<meta name="author" content="Naveen Thurimerla" />
		<meta name="robots" content={robots} />
		<link rel="canonical" href={canonicalUrl} />

		<meta name="msvalidate.01" content="EA96FCA4764C5D0B8E4B3EB0811BD6DE" />
		<meta name="google-site-verification" content={googleSiteVerification} />

		<meta name="theme-color" content="#090b10" />
		<meta name="mobile-web-app-capable" content="yes" />
		<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />

		<meta property="og:type" content={ogType} />
		<meta property="og:locale" content="en_US" />
		<meta property="og:site_name" content="BotoView" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:image" content="https://botoview.5goos.com/og-image.png" />
		<meta property="og:image:alt" content="BotoView — AWS Boto3 Changelog Explorer" />
		<meta property="og:image:type" content="image/png" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:site" content="@5goos" />
		<meta name="twitter:creator" content="@thurimerla" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content="https://botoview.5goos.com/og-image.png" />
		<meta name="twitter:image:alt" content="BotoView — AWS Boto3 Changelog Explorer" />

		<link rel="manifest" href="/site.webmanifest" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<link rel="icon" href="/favicon.ico" sizes="32x32" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />

		<script is:inline>
			(function() {
				var theme = 'dark';
				try {
					var saved = localStorage.getItem('theme');
					if (saved === 'light' || saved === 'dark') {
						theme = saved;
					}
				} catch (e) {}
				var isDark = theme === 'dark';
				document.documentElement.classList.toggle('dark', isDark);
				var metaColor = isDark ? '#090b10' : '#f4f6fa';
				var metas = document.querySelectorAll('meta[name="theme-color"]');
				for (var i = 0; i < metas.length; i++) {
					metas[i].setAttribute('content', metaColor);
				}
			})();
		</script>

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&display=swap" />
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet" media="print" onload="this.media='all'" />
		<noscript>
			<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet" />
		</noscript>

		<script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
	</head>
	<body class={bodyClass}>
		<a href="#mainScrollArea" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[200] focus:px-4 focus:py-2 focus:rounded-lg focus:bg-indigo-600 focus:text-white focus:text-sm focus:font-semibold focus:shadow-lg">Skip to content</a>
		<noscript>
			<div style="padding: 0.75rem 1.25rem; background: #11151e; color: #e2e8f0; font-family: sans-serif; font-size: 0.85rem;">
				<strong>BotoView:</strong> Enable JavaScript for interactive filtering, or browse the <a href="/services/" style="text-decoration: underline; font-weight: 600; color: #818cf8;">AWS Services Directory</a> and <a href="/releases/" style="text-decoration: underline; font-weight: 600; color: #818cf8;">Boto3 Releases Archive</a>.
			</div>
		</noscript>
		<slot />
		<CommandPalette />
		<div x-data="toastStore"
		     @boto:toast.window="show($event.detail?.message)"
		     x-show="visible"
		     x-cloak
		     x-transition:enter="transition ease-out duration-200"
		     x-transition:enter-start="opacity-0 translate-y-2 scale-95"
		     x-transition:enter-end="opacity-100 translate-y-0 scale-100"
		     x-transition:leave="transition ease-in duration-150"
		     x-transition:leave-start="opacity-100 translate-y-0 scale-100"
		     x-transition:leave-end="opacity-0 translate-y-2 scale-95"
		     role="status"
		     aria-live="polite"
		     class="fixed bottom-5 left-1/2 -translate-x-1/2 sm:left-auto sm:translate-x-0 sm:right-6 z-[140] px-4 py-2.5 rounded-full command-modal text-xs mono font-medium text-emerald-700 dark:text-emerald-300 flex items-center gap-2 pointer-events-none">
			<svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path></svg>
			<span x-text="message"></span>
		</div>
		<script>
			import { registerAlpineComponent } from '../utils/client';

			let timer: ReturnType<typeof setTimeout> | undefined;
			registerAlpineComponent('toastStore', () => ({
				visible: false,
				message: '',
				show(msg?: string) {
					if (!msg) return;
					this.message = msg;
					this.visible = true;
					if (timer) clearTimeout(timer);
					timer = setTimeout(() => {
						this.visible = false;
					}, 2200);
				}
			}));
		</script>
	</body>
</html>
