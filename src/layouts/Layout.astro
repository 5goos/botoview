---
import '../styles/global.css';

interface Props {
	title?: string;
}
const { title = "BotoView — AWS Boto3 Changelog Explorer & Release Notes Tracker" } = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
	<head>
		<link rel="preload" href="/data/track.json" as="fetch" crossorigin="anonymous" />
		
		<!-- Google tag (gtag.js) -->
		<script type="text/partytown" async src="https://www.googletagmanager.com/gtag/js?id=G-L9MXJPQ4BW"></script>
		<script type="text/partytown">
		  window.dataLayer = window.dataLayer || [];
		  function gtag(){dataLayer.push(arguments);}
		  gtag('js', new Date());
		  gtag('config', 'G-L9MXJPQ4BW');
		</script>
		<meta name="msvalidate.01" content="4950DCD271185D133A4FA2B7A215D7D5" />
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{title}</title>
		<meta name="description" content="An interactive web application to track, filter, and explore AWS Boto3 changelogs. Filter SDK updates by AWS service (S3, Bedrock, Lambda), compare versions, and inspect breaking changes." />
		<meta name="keywords" content="botoview, boto changelogs, boto3 changelog, boto3 release notes, boto3 changelog filter by service, aws boto3 version updates, botocore changelog, boto3 updates, aws sdk tracker, python aws development, aws changelog" />
		<meta name="author" content="5goos" />
		
		<meta name="theme-color" content="#0a0a0a" media="(prefers-color-scheme: dark)" />
		<meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
		<meta name="mobile-web-app-capable" content="yes" />
		<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
		
		<!-- Open Graph / Facebook -->
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="BotoView" />
		<meta property="og:title" content="BotoView — AWS Boto3 Changelog Explorer & Release Notes Tracker" />
		<meta property="og:description" content="An interactive web application to track, filter, and explore AWS Boto3 changelogs. Filter SDK updates by AWS service (S3, Bedrock, Lambda), compare versions, and inspect breaking changes." />
		<meta property="og:url" content="https://botoview.5goos.com/" />
		<meta property="og:image" content="https://botoview.5goos.com/og-image.png" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />

		<!-- Twitter -->
		<meta property="twitter:card" content="summary_large_image" />
		<meta property="twitter:title" content="BotoView — AWS Boto3 Changelog Explorer & Release Notes Tracker" />
		<meta property="twitter:description" content="An interactive web application to track, filter, and explore AWS Boto3 changelogs. Filter SDK updates by AWS service (S3, Bedrock, Lambda), compare versions, and inspect breaking changes." />
		<meta property="twitter:image" content="https://botoview.5goos.com/og-image.png" />

		<link rel="canonical" href={new URL(Astro.url.pathname, Astro.site || 'https://botoview.5goos.com')} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />

		<script is:inline>
			(function() {
				const setTheme = () => {
					const darkMode = window.matchMedia('(prefers-color-scheme: dark)').matches;
					document.documentElement.classList.toggle('dark', darkMode);
				};
				setTheme();
				window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', setTheme);
			})();
		</script>

		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;600;900&family=JetBrains+Mono:wght@400;700&display=swap">
		<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;600;900&family=JetBrains+Mono:wght@400;700&display=swap" rel="stylesheet" />
		
		<script type="application/ld+json">
		{
		  "@context": "https://schema.org",
		  "@graph": [
			{
			  "@type": "WebSite",
			  "@id": "https://botoview.5goos.com/#website",
			  "url": "https://botoview.5goos.com/",
			  "name": "BotoView",
			  "publisher": { "@id": "https://5goos.com/#organization" },
			  "description": "An interactive web application to track, filter, and explore AWS Boto3 changelogs. Filter SDK updates by AWS service (S3, Bedrock, Lambda), compare versions, and inspect breaking changes."
			},
			{
			  "@type": "Organization",
			  "@id": "https://5goos.com/#organization",
			  "name": "5goos",
			  "url": "https://5goos.com/",
			  "logo": "https://botoview.5goos.com/favicon.png",
			  "sameAs": [
				"https://github.com/5goos"
			  ]
			},
			{
			  "@type": "SoftwareApplication",
			  "@id": "https://botoview.5goos.com/#software",
			  "name": "BotoView",
			  "applicationCategory": "DeveloperApplication",
			  "operatingSystem": "Web",
			  "url": "https://botoview.5goos.com/",
			  "author": { "@id": "https://5goos.com/#organization" },
			  "description": "An interactive web application to track, filter, and explore AWS Boto3 changelogs. Filter SDK updates by AWS service (S3, Bedrock, Lambda), compare versions, and inspect breaking changes."
			},
			{
			  "@type": "FAQPage",
			  "mainEntity": [
				{
				  "@type": "Question",
				  "name": "What is BotoView?",
				  "acceptedAnswer": {
					"@type": "Answer",
					"text": "BotoView is an interactive web application to track, filter, and explore AWS Boto3 changelogs and Botocore release notes. It provides a real-time searchable timeline of all AWS updates."
				  }
				},
				{
				  "@type": "Question",
				  "name": "How to filter boto3 changelog by service?",
				  "acceptedAnswer": {
					"@type": "Answer",
					"text": "Using BotoView, you can easily filter boto3 changelogs by service (such as S3, Bedrock, Lambda, DynamoDB, and EC2) to track AWS SDK version updates, compare releases, and inspect breaking changes."
				  }
				},
				{
				  "@type": "Question",
				  "name": "Where can I find AWS Boto3 release notes and version updates?",
				  "acceptedAnswer": {
					"@type": "Answer",
					"text": "BotoView provides comprehensive AWS Boto3 release notes and version updates, indexing all changes across Boto3 and Botocore with instant service-level filtering and fast search."
				  }
				}
			  ]
			}
		  ]
		}
		</script>
	</head>
	<body class="h-screen w-full overflow-hidden bg-main transition-colors duration-500">
		<noscript>
			<div style="padding: 2rem; background: #fff; color: #000; font-family: sans-serif;">
				<h1>BotoView — AWS Boto3 Changelog Explorer & Release Notes Tracker</h1>
				<p>
					<strong>BotoView</strong> is an interactive web application to track, filter, and explore <strong>boto changelogs</strong>, <strong>boto3 changelog</strong>, and <strong>boto3 release notes</strong>. 
					Filter boto3 changelog by service (such as S3, Bedrock, Lambda) and inspect AWS Boto3 version updates across the entire AWS SDK ecosystem.
				</p>
			</div>
		</noscript>
		<slot />
	</body>
</html>
