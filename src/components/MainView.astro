---
import {
    formatDate,
    formatDescription,
    getServiceColorClass,
    makeEntryAnchorId,
    normalizeChangeType,
    slugifyService
} from '../utils/formatting';

interface Props {
    initialChanges?: Array<{ category: string; description: string; type: string }>;
    latestVersion?: { id: string; date: string };
}

const { initialChanges = [], latestVersion = { id: '', date: '' } } = Astro.props;

const initialServices = Array.from(
    new Set(initialChanges.map((c) => (c?.category || '').toLowerCase().trim()).filter(Boolean))
).sort();

let initialApiCount = 0;
let initialFeatureCount = 0;
let initialEnhancementCount = 0;
let initialFixCount = 0;

for (const c of initialChanges) {
    const meta = normalizeChangeType(c.type, c.description);
    if (meta.key === 'api-change') initialApiCount++;
    else if (meta.key === 'feature') initialFeatureCount++;
    else if (meta.key === 'enhancement') initialEnhancementCount++;
    else initialFixCount++;
}
---

<main id="mainScrollArea"
      @scroll="showBackToTop = $event.target.scrollTop > 350; isScrolled = $event.target.scrollTop > 10"
      class="flex-1 overflow-y-auto relative custom-scroll h-full min-h-0 bg-transparent theme-transition scroll-smooth min-w-0"
      aria-label="Main Changelog Content"
      tabindex="-1">

    <div class="pointer-events-none fixed inset-0 z-0 ambient-glow" aria-hidden="true"></div>

    <div class="sticky top-0 z-30 glass-header transition-all duration-200" :class="isScrolled ? 'glass-header-scrolled' : ''">
        <header class="h-14 flex items-center">
            <div class="w-full max-w-4xl xl:max-w-5xl mx-auto px-3 sm:px-6 lg:px-8 h-full flex items-center justify-between gap-2 min-w-0">
                <div class="flex items-center gap-1.5 sm:gap-2.5 min-w-0 flex-1">
                    <button type="button"
                            @click="showMobileVersions = true"
                            aria-label="Toggle navigation drawer"
                            class="lg:hidden flex items-center justify-center p-2 -ml-1.5 rounded-xl text-slate-600 dark:text-slate-300 hover:bg-black/5 dark:hover:bg-white/[0.07] transition-colors shrink-0 cursor-pointer tap-target">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M4 6h16M4 12h16M4 18h10"></path></svg>
                    </button>

                    <div x-show="viewMode === 'release'" class="flex items-center gap-2 min-w-0 flex-1">
                        <h1 class="text-sm sm:text-base font-semibold text-slate-900 dark:text-slate-100 truncate tracking-tight flex items-center gap-1.5 min-w-0">
                            <span class="hidden md:inline text-slate-500 dark:text-slate-400 font-medium truncate">AWS Boto3 Changelogs</span>
                            <span class="mono font-bold text-slate-900 dark:text-white shrink-0" x-text="'v' + (selectedVersion || '...')">{latestVersion.id ? `v${latestVersion.id}` : ''}</span>
                        </h1>

                        <span x-show="!isClientHydrated || (versions.length > 0 && selectedVersion === versions[0]?.id)"
                              class="hidden sm:inline-flex items-center px-2 py-0.5 rounded-full bg-emerald-500/12 text-emerald-700 dark:text-emerald-400 text-[10px] mono font-semibold tracking-wide shrink-0">
                            Latest
                        </span>

                        <template x-if="selectedDate">
                            <time :datetime="selectedDate" class="text-xs mono text-slate-500 dark:text-slate-400 hidden md:inline shrink-0 tabular-nums" x-text="formatDate(selectedDate)"></time>
                        </template>
                        {latestVersion.date && (
                            <time x-show="!isClientHydrated" datetime={latestVersion.date} class="text-xs mono text-slate-500 dark:text-slate-400 hidden md:inline shrink-0 tabular-nums">
                                {formatDate(latestVersion.date)}
                            </time>
                        )}

                        <div class="flex items-center gap-0.5 shrink-0 ml-0.5 p-0.5 rounded-full bg-black/[0.05] dark:bg-white/[0.06]">
                            <button type="button"
                                    @click="adjacentVersions.newer && selectVersion(adjacentVersions.newer, true)"
                                    :disabled="!adjacentVersions.newer"
                                    title="Newer release (k)"
                                    aria-label="Newer release"
                                    :class="adjacentVersions.newer ? 'hover:bg-indigo-500/12 hover:text-indigo-700 dark:hover:bg-white/15 text-slate-700 dark:text-slate-200 cursor-pointer' : 'text-slate-300 dark:text-slate-600 cursor-not-allowed'"
                                    class="w-9 h-9 sm:w-7 sm:h-7 flex items-center justify-center rounded-full transition-all">
                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M15 19l-7-7 7-7"></path></svg>
                            </button>
                            <button type="button"
                                    @click="adjacentVersions.older && selectVersion(adjacentVersions.older, true)"
                                    :disabled="!adjacentVersions.older"
                                    title="Older release (j)"
                                    aria-label="Older release"
                                    :class="adjacentVersions.older ? 'hover:bg-indigo-500/12 hover:text-indigo-700 dark:hover:bg-white/15 text-slate-700 dark:text-slate-200 cursor-pointer' : 'text-slate-300 dark:text-slate-600 cursor-not-allowed'"
                                    class="w-9 h-9 sm:w-7 sm:h-7 flex items-center justify-center rounded-full transition-all">
                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M9 5l7 7-7 7"></path></svg>
                            </button>
                        </div>
                    </div>

                    <div x-show="viewMode === 'service' && !navigatedFromVersion" x-cloak class="flex items-center gap-2 min-w-0 flex-1 truncate">
                        <button type="button"
                                @click="backToRelease()"
                                title="Back to latest release (Esc)"
                                class="inline-flex items-center gap-1 text-xs mono font-medium text-slate-500 hover:text-indigo-600 dark:text-slate-400 dark:hover:text-indigo-400 transition-colors cursor-pointer shrink-0 min-h-[40px] sm:min-h-0">
                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M15 19l-7-7 7-7"></path></svg>
                            <span class="hidden sm:inline">Releases</span>
                        </button>
                        <span class="text-slate-300 dark:text-slate-600 shrink-0 text-xs">/</span>
                        <span class="text-sm font-bold mono uppercase text-slate-900 dark:text-white truncate min-w-0 tracking-tight" x-text="activeService"></span>
                        <span class="hidden md:inline-block px-2 py-0.5 rounded-full bg-indigo-500/10 text-indigo-600 dark:text-indigo-400 text-[10px] mono font-semibold shrink-0 tabular-nums"
                              x-text="serviceHistory.length + ' updates'"></span>
                    </div>

                    <div x-show="viewMode === 'service' && navigatedFromVersion" x-cloak class="flex items-center gap-1.5 min-w-0 flex-1 truncate">
                        <button type="button"
                                @click="backToRelease()"
                                :title="'Back to Release v' + navigatedFromVersion + ' (Esc)'"
                                class="inline-flex items-center gap-0.5 text-xs sm:text-sm mono font-semibold text-indigo-600 dark:text-indigo-400 hover:underline transition-colors cursor-pointer shrink-0 min-h-[40px] sm:min-h-0">
                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M15 19l-7-7 7-7"></path></svg>
                            <span>v<span x-text="navigatedFromVersion"></span></span>
                        </button>
                        <span class="text-slate-300 dark:text-slate-600 shrink-0 text-xs">/</span>
                        <span class="text-sm font-bold mono uppercase text-slate-900 dark:text-white truncate min-w-0 tracking-tight" x-text="activeService"></span>
                        <span class="hidden md:inline-block px-2 py-0.5 rounded-full bg-indigo-500/10 text-indigo-600 dark:text-indigo-400 text-[10px] mono font-semibold shrink-0 tabular-nums"
                              x-text="serviceHistory.length + ' updates'"></span>
                    </div>
                </div>

                <div class="flex items-center gap-1 sm:gap-1.5 shrink-0">
                    <nav class="hidden sm:flex items-center gap-0.5 mr-1" aria-label="Directory links">
                        <a href="/services/" class="px-3 py-1.5 rounded-full text-xs font-medium text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white hover:bg-black/[0.04] dark:hover:bg-white/[0.06] transition-colors">
                            Services
                        </a>
                        <a href="/releases/" class="px-3 py-1.5 rounded-full text-xs font-medium text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white hover:bg-black/[0.04] dark:hover:bg-white/[0.06] transition-colors">
                            Releases
                        </a>
                    </nav>

                    <button type="button"
                            @click="openPalette()"
                            aria-label="Open command search (Cmd/Ctrl+K)"
                            title="Quick jump (Cmd/Ctrl + K)"
                            class="inline-flex items-center gap-1.5 px-2.5 py-1.5 rounded-full text-xs font-medium text-slate-600 dark:text-slate-300 bg-black/[0.04] dark:bg-white/[0.06] hover:bg-black/[0.08] dark:hover:bg-white/[0.1] transition-colors cursor-pointer shrink-0 min-h-[40px] sm:min-h-0">
                        <svg class="w-3.5 h-3.5 text-slate-500 dark:text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
                        <span class="hidden md:inline text-[11px]">Jump</span>
                        <kbd class="kbd-badge hidden sm:inline-flex">⌘K</kbd>
                    </button>

                    <button type="button"
                            @click="toggleTheme()"
                            aria-label="Toggle color theme"
                            title="Toggle dark / light theme (t)"
                            class="rounded-full text-slate-500 hover:text-slate-900 dark:text-slate-400 dark:hover:text-slate-100 hover:bg-black/[0.04] dark:hover:bg-white/[0.07] transition-colors cursor-pointer shrink-0 tap-target flex items-center justify-center">
                        <svg x-show="!isDarkMode" x-cloak class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.9" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path></svg>
                        <svg x-show="isDarkMode" class="w-4 h-4 text-amber-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.9" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path></svg>
                    </button>

                    <a href="https://github.com/5goos/botoview" target="_blank" rel="noopener noreferrer"
                       title="View on GitHub"
                       aria-label="GitHub Repository"
                       class="rounded-full text-slate-500 hover:text-slate-900 dark:text-slate-400 dark:hover:text-slate-100 hover:bg-black/[0.04] dark:hover:bg-white/[0.07] transition-colors shrink-0 tap-target flex items-center justify-center">
                        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
                    </a>
                </div>
            </div>
        </header>

        <section aria-label="Changelog filters" class="pb-3 pt-1">
            <div class="w-full max-w-4xl xl:max-w-5xl mx-auto px-3 sm:px-6 lg:px-8 space-y-2.5">
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 min-w-0">
                    <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed truncate">
                        Track daily AWS Boto3 &amp; Botocore API changes, features, and fixes by release or service.
                    </p>

                    <div x-show="viewMode === 'release'" class="flex items-center gap-1.5 shrink-0 max-w-full min-w-0">
                        <div class="inline-flex items-center gap-1 p-1 rounded-xl soft-card max-w-full overflow-x-auto hide-scrollbar">
                            <button type="button"
                                    @click="pinTool = pinTool === 'pip' ? 'uv' : 'pip'"
                                    title="Switch between pip and uv"
                                    class="px-2 py-1 rounded-lg text-[10px] mono font-semibold uppercase bg-black/[0.045] dark:bg-white/[0.07] text-slate-600 dark:text-slate-300 hover:text-indigo-600 dark:hover:text-indigo-300 transition-colors cursor-pointer shrink-0">
                                <span x-text="pinTool">pip</span>
                            </button>
                            <code class="px-1.5 text-[11px] mono text-indigo-700 dark:text-indigo-300 font-medium whitespace-nowrap select-all"
                                  x-text="pinTool === 'uv' ? 'uv add boto3==' + (selectedVersion || '{latestVersion.id}') : 'pip install boto3==' + (selectedVersion || '{latestVersion.id}')">
                                pip install boto3=={latestVersion.id}
                            </code>
                            <button type="button"
                                    @click="copyPipCommand()"
                                    aria-label="Copy version install command"
                                    title="Copy install pin"
                                    class="inline-flex items-center gap-1 px-2 py-1 rounded-lg text-[10.5px] mono font-medium text-slate-500 hover:text-indigo-600 dark:text-slate-400 dark:hover:text-indigo-300 hover:bg-black/[0.04] dark:hover:bg-white/[0.07] transition-colors cursor-pointer shrink-0">
                                <svg x-show="!showPipCopied" class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path></svg>
                                <span x-show="showPipCopied" x-cloak class="text-emerald-600 dark:text-emerald-400 font-semibold">Copied</span>
                            </button>
                        </div>
                        <button type="button"
                                @click="copyReleaseLink()"
                                title="Copy permalink to this release"
                                aria-label="Copy release permalink"
                                class="w-9 h-9 sm:w-8 sm:h-8 rounded-xl soft-card flex items-center justify-center text-slate-400 hover:text-indigo-600 dark:hover:text-indigo-300 transition-colors cursor-pointer shrink-0">
                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"></path></svg>
                        </button>
                    </div>
                </div>

                <div x-show="viewMode === 'release'" class="flex flex-col md:flex-row md:items-center justify-between gap-2">
                    <div class="relative flex-1 group min-w-0">
                        <input type="text" id="versionSearch" name="versionSearch" x-model.debounce.150ms="versionSearch"
                               placeholder="Filter changes in this release (s3, bedrock, operation)..."
                               aria-label="Filter changes in this release"
                               class="w-full glass-input rounded-2xl py-2.5 sm:py-1.5 pl-9 pr-14 text-xs font-medium text-slate-900 dark:text-slate-100 placeholder:text-slate-400 dark:placeholder:text-slate-500 focus:outline-none" />
                        <svg class="absolute left-3 top-[12px] sm:top-[8px] w-3.5 h-3.5 text-slate-400 group-focus-within:text-indigo-500 transition-colors pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
                        <kbd x-show="!versionSearch" class="hidden sm:inline-flex absolute right-2.5 top-[6px] kbd-badge pointer-events-none">/</kbd>
                        <button type="button" x-show="versionSearch" x-cloak @click="versionSearch = ''" aria-label="Clear filter input" class="absolute right-2.5 top-[9px] sm:top-[6px] text-slate-400 hover:text-slate-700 dark:hover:text-slate-200 p-1 cursor-pointer">
                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                        </button>
                    </div>

                    <div class="flex items-center gap-1 p-1 glass-segmented rounded-2xl mono text-[10.5px] shrink-0 overflow-x-auto hide-scrollbar w-full md:w-auto tabular-nums">
                        <button type="button"
                                @click="activeFilter = 'all'"
                                :class="activeFilter === 'all' ? 'bg-indigo-500/14 dark:bg-white/[0.11] text-indigo-700 dark:text-white font-semibold' : 'text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-200 hover:bg-slate-900/[0.04] dark:hover:bg-white/[0.05]'"
                                class="px-3 py-1.5 sm:py-1 rounded-xl transition-all cursor-pointer whitespace-nowrap">
                            All <span class="opacity-65 ml-0.5" x-text="versionCounts.total">{initialChanges.length}</span>
                        </button>
                        <button type="button"
                                @click="activeFilter = 'api-change'"
                                :class="activeFilter === 'api-change' ? 'bg-teal-500/15 dark:bg-teal-500/20 text-teal-700 dark:text-teal-300 font-semibold' : 'text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-200 hover:bg-slate-900/[0.04] dark:hover:bg-white/[0.05]'"
                                class="px-3 py-1.5 sm:py-1 rounded-xl transition-all cursor-pointer whitespace-nowrap">
                            API <span class="opacity-65 ml-0.5" x-text="versionCounts.apiChanges">{initialApiCount}</span>
                        </button>
                        <button type="button"
                                @click="activeFilter = 'feature'"
                                :class="activeFilter === 'feature' ? 'bg-emerald-500/15 dark:bg-emerald-500/20 text-emerald-700 dark:text-emerald-300 font-semibold' : 'text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-200 hover:bg-slate-900/[0.04] dark:hover:bg-white/[0.05]'"
                                class="px-3 py-1.5 sm:py-1 rounded-xl transition-all cursor-pointer whitespace-nowrap">
                            Features <span class="opacity-65 ml-0.5" x-text="versionCounts.features">{initialFeatureCount}</span>
                        </button>
                        <button type="button"
                                @click="activeFilter = 'enhancement'"
                                :class="activeFilter === 'enhancement' ? 'bg-sky-500/15 dark:bg-sky-500/20 text-sky-700 dark:text-sky-300 font-semibold' : 'text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-200 hover:bg-slate-900/[0.04] dark:hover:bg-white/[0.05]'"
                                class="px-3 py-1.5 sm:py-1 rounded-xl transition-all cursor-pointer whitespace-nowrap">
                            Enhance <span class="opacity-65 ml-0.5" x-text="versionCounts.enhancements">{initialEnhancementCount}</span>
                        </button>
                        <button type="button"
                                @click="activeFilter = 'bugfix'"
                                :class="activeFilter === 'bugfix' ? 'bg-rose-500/15 dark:bg-rose-500/20 text-rose-700 dark:text-rose-300 font-semibold' : 'text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-200 hover:bg-slate-900/[0.04] dark:hover:bg-white/[0.05]'"
                                class="px-3 py-1.5 sm:py-1 rounded-xl transition-all cursor-pointer whitespace-nowrap">
                            Fixes <span class="opacity-65 ml-0.5" x-text="versionCounts.fixes">{initialFixCount}</span>
                        </button>
                    </div>
                </div>

                <div x-show="viewMode === 'service'" x-cloak class="flex flex-col md:flex-row md:items-center justify-between gap-2">
                    <div class="relative flex-1 group min-w-0">
                        <input type="text"
                               id="serviceHistorySearch"
                               name="serviceHistorySearch"
                               x-model.debounce.150ms="serviceHistorySearch"
                               @input="serviceHistoryLimit = 40"
                               :placeholder="'Search ' + (serviceHistory.length || '') + ' ' + (activeService || '').toUpperCase() + ' updates...'"
                               aria-label="Search service changelogs"
                               class="w-full glass-input rounded-2xl py-2.5 sm:py-1.5 pl-9 pr-9 text-xs font-medium text-slate-900 dark:text-slate-100 placeholder:text-slate-400 dark:placeholder:text-slate-500 focus:outline-none" />
                        <svg class="absolute left-3 top-[12px] sm:top-[8px] w-3.5 h-3.5 text-slate-400 group-focus-within:text-indigo-500 transition-colors pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
                        <button type="button" x-show="serviceHistorySearch" x-cloak @click="serviceHistorySearch = ''; serviceHistoryLimit = 40" aria-label="Clear service history search" class="absolute right-2.5 top-[9px] sm:top-[6px] text-slate-400 hover:text-slate-700 dark:hover:text-slate-200 p-1 cursor-pointer">
                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                        </button>
                    </div>

                    <div class="flex items-center gap-2 flex-wrap">
                        <div class="flex items-center gap-1 p-1 glass-segmented rounded-2xl mono text-[10.5px] tabular-nums overflow-x-auto hide-scrollbar max-w-full">
                            <button type="button"
                                    @click="serviceHistoryFilter = 'all'; serviceHistoryLimit = 40"
                                    :class="serviceHistoryFilter === 'all' ? 'bg-indigo-500/14 dark:bg-white/[0.11] text-indigo-700 dark:text-white font-semibold' : 'text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-200 hover:bg-slate-900/[0.04] dark:hover:bg-white/[0.05]'"
                                    class="px-3 py-1.5 sm:py-1 rounded-xl transition-all cursor-pointer whitespace-nowrap">
                                All <span class="opacity-65 ml-0.5" x-text="serviceHistoryCounts.total"></span>
                            </button>
                            <button type="button"
                                    @click="serviceHistoryFilter = 'api-change'; serviceHistoryLimit = 40"
                                    :class="serviceHistoryFilter === 'api-change' ? 'bg-teal-500/15 dark:bg-teal-500/20 text-teal-700 dark:text-teal-300 font-semibold' : 'text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-200 hover:bg-slate-900/[0.04] dark:hover:bg-white/[0.05]'"
                                    class="px-3 py-1.5 sm:py-1 rounded-xl transition-all cursor-pointer whitespace-nowrap">
                                API <span class="opacity-65 ml-0.5" x-text="serviceHistoryCounts.apiChanges"></span>
                            </button>
                            <button type="button"
                                    @click="serviceHistoryFilter = 'feature'; serviceHistoryLimit = 40"
                                    :class="serviceHistoryFilter === 'feature' ? 'bg-emerald-500/15 dark:bg-emerald-500/20 text-emerald-700 dark:text-emerald-300 font-semibold' : 'text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-200 hover:bg-slate-900/[0.04] dark:hover:bg-white/[0.05]'"
                                    class="px-3 py-1.5 sm:py-1 rounded-xl transition-all cursor-pointer whitespace-nowrap">
                                Features <span class="opacity-65 ml-0.5" x-text="serviceHistoryCounts.features"></span>
                            </button>
                            <button type="button"
                                    @click="serviceHistoryFilter = 'bugfix'; serviceHistoryLimit = 40"
                                    :class="serviceHistoryFilter === 'bugfix' ? 'bg-rose-500/15 dark:bg-rose-500/20 text-rose-700 dark:text-rose-300 font-semibold' : 'text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-200 hover:bg-slate-900/[0.04] dark:hover:bg-white/[0.05]'"
                                    class="px-3 py-1.5 sm:py-1 rounded-xl transition-all cursor-pointer whitespace-nowrap">
                                Fixes <span class="opacity-65 ml-0.5" x-text="serviceHistoryCounts.fixes"></span>
                            </button>
                        </div>

                        <template x-if="availableServiceVersionPrefixes.length > 0">
                            <select x-model="serviceVersionFilter" @change="serviceHistoryLimit = 40"
                                    aria-label="Filter by release series"
                                    class="glass-input rounded-xl px-3 py-1.5 text-slate-700 dark:text-slate-300 font-medium text-[11px] focus:outline-none cursor-pointer mono">
                                <option value="all">All Versions</option>
                                <template x-for="pfx in availableServiceVersionPrefixes" :key="pfx">
                                    <option :value="pfx" x-text="'v' + pfx + '.x'"></option>
                                </template>
                            </select>
                        </template>

                        <div class="flex items-center gap-2 mono text-slate-500 dark:text-slate-400 text-[10.5px] sm:ml-auto tabular-nums">
                            <span><strong class="text-slate-900 dark:text-white font-semibold" x-text="visibleServiceHistory.length">40</strong>/<strong x-text="filteredServiceHistory.length">40</strong></span>
                            <button type="button"
                                    x-show="serviceHistorySearch || serviceHistoryFilter !== 'all' || serviceVersionFilter !== 'all'"
                                    x-cloak
                                    @click="serviceHistorySearch = ''; serviceHistoryFilter = 'all'; serviceVersionFilter = 'all'; serviceHistoryLimit = 40"
                                    class="text-indigo-600 dark:text-indigo-400 font-semibold hover:underline cursor-pointer">
                                Reset
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </div>

    <div class="relative z-10 w-full max-w-4xl xl:max-w-5xl mx-auto px-3 sm:px-6 lg:px-8 pt-3 pb-20 sm:pb-16 space-y-5 min-h-[calc(100vh-140px)] flex flex-col min-w-0">
        <div x-show="viewMode === 'release'" class="space-y-4 flex-1 w-full max-w-full min-w-0" role="region" aria-label="Release changelog" aria-live="polite" aria-atomic="false">
            <section aria-label="Services in this release" class="px-1 py-1 space-y-2 w-full max-w-full min-w-0">
                <div class="flex items-center justify-between gap-2 flex-wrap w-full max-w-full min-w-0">
                    <div class="flex items-center gap-2 min-w-0">
                        <h2 class="text-xs font-semibold text-slate-500 dark:text-slate-400">
                            Modified services
                        </h2>
                        <span class="px-2 py-0.5 rounded-full bg-black/[0.04] dark:bg-white/[0.06] text-[10px] mono font-semibold text-slate-600 dark:text-slate-300 tabular-nums"
                              x-text="currentVersionServices.size">{initialServices.length}</span>
                    </div>

                    <template x-if="releaseServiceFilter">
                        <div class="flex items-center gap-2 text-xs flex-wrap">
                            <span class="px-2.5 py-0.5 rounded-full bg-indigo-600 text-white font-semibold mono uppercase text-[10px]" x-text="releaseServiceFilter"></span>
                            <button type="button" @click="releaseServiceFilter = ''" class="text-slate-500 hover:text-rose-500 text-[11px] font-medium cursor-pointer" title="Clear service filter">Clear</button>
                            <a :href="'/services/' + slugifyService(releaseServiceFilter) + '/'"
                               @click.prevent="openService(releaseServiceFilter, true, true)"
                               class="text-indigo-600 dark:text-indigo-400 font-semibold hover:underline text-[11px] mono cursor-pointer">
                                Full <span class="uppercase" x-text="releaseServiceFilter"></span> history &rarr;
                            </a>
                        </div>
                    </template>
                </div>

                <div class="flex items-center gap-1.5 flex-wrap w-full max-w-full min-w-0">
                    <div x-show="!isClientHydrated" class="contents">
                        {initialServices.map((svc) => (
                            <a href={`/services/${slugifyService(svc)}/`}
                               class={`inline-flex items-center px-3 py-1 rounded-full text-[11px] mono font-semibold uppercase transition-all ${getServiceColorClass(svc)}`}>
                                <span>{svc}</span>
                            </a>
                        ))}
                    </div>

                    <div x-show="isClientHydrated" x-cloak class="contents">
                        <template x-for="svc in Array.from(currentVersionServices).sort()" :key="svc">
                            <a :href="'/services/' + slugifyService(svc) + '/'"
                               @click.prevent="toggleReleaseServiceFilter(svc)"
                               @mouseenter="prefetchService(svc)"
                               :class="releaseServiceFilter === svc
                                   ? 'bg-indigo-600 text-white shadow-sm'
                                   : getServiceColorClass(svc)"
                               :title="'Filter v' + selectedVersion + ' by ' + svc.toUpperCase()"
                               class="inline-flex items-center px-3 py-1 rounded-full text-[11px] mono font-semibold uppercase transition-all active:scale-95 cursor-pointer max-w-full">
                                <span class="truncate max-w-[200px] sm:max-w-none" x-text="svc"></span>
                            </a>
                        </template>
                    </div>
                    <span x-show="currentVersionServices.size === 0" x-cloak class="text-xs mono text-slate-400">Core SDK updates</span>
                </div>
            </section>

            <div class="space-y-3.5">
                <div x-show="!isClientHydrated" class="space-y-3.5" id="ssr-changelog-stream">
                    {initialChanges.map((change, idx) => {
                        const serviceSlug = slugifyService(change.category);
                        const meta = normalizeChangeType(change.type, change.description);
                        const anchorId = makeEntryAnchorId(change.category, idx);
                        return (
                            <article id={anchorId} class="changelog-card rounded-2xl p-4 sm:p-5 scroll-mt-36">
                                <div class="flex items-center justify-between gap-2 mb-2.5 flex-wrap">
                                    <div class="flex items-center gap-2 flex-wrap min-w-0">
                                        <a href={`/services/${serviceSlug}/`}
                                           class={`px-2.5 py-0.5 rounded-full text-[11px] mono font-semibold uppercase tracking-wide ${getServiceColorClass(change.category)}`}>
                                            {change.category}
                                        </a>
                                        <span class={`inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[10px] mono font-medium ${meta.badgeClass}`}>
                                            <span class={`w-1.5 h-1.5 rounded-full ${meta.dotClass}`}></span>
                                            <span>{meta.label}</span>
                                        </span>
                                    </div>
                                    <a href={`#${anchorId}`}
                                       aria-label={`Deep link to ${change.category} change`}
                                       class="text-slate-400 hover:text-indigo-500 mono text-xs px-1.5 py-1 rounded-lg">
                                        #
                                    </a>
                                </div>
                                <p class="text-slate-700 dark:text-slate-200 leading-[1.7] text-[14px] break-words" set:html={formatDescription(change.description)}></p>
                            </article>
                        );
                    })}
                </div>

                <div x-show="isClientHydrated" x-cloak class="space-y-3.5">
                    <template x-for="(change, changeIndex) in filteredVersionData" :key="(selectedVersion || '') + '-' + change.category + '-' + change.type + '-' + changeIndex">
                        <article :id="makeEntryAnchorId(change.category, changeIndex)" class="changelog-card rounded-2xl p-4 sm:p-5 group scroll-mt-36">
                            <div class="flex items-center justify-between gap-2 mb-2.5 flex-wrap">
                                <div class="flex items-center gap-2 flex-wrap min-w-0">
                                    <a :href="'/services/' + slugifyService(change.category) + '/'"
                                       @click.prevent="openService(change.category, true, true)"
                                       @mouseenter="prefetchService(change.category)"
                                       :class="getServiceColorClass(change.category)"
                                       :title="'View full ' + change.category.toUpperCase() + ' changelog'"
                                       class="group/svc inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[11px] mono font-semibold uppercase tracking-wide transition-colors cursor-pointer">
                                        <span x-html="highlight(change.category, versionSearch)"></span>
                                        <svg class="w-2.5 h-2.5 opacity-0 group-hover/svc:opacity-80 group-hover/svc:translate-x-0.5 transition-all" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"></path></svg>
                                    </a>

                                    <div :class="getTypeMeta(change.type, change.description).badgeClass"
                                         class="flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[10px] mono font-medium">
                                        <span :class="getTypeMeta(change.type, change.description).dotClass" class="w-1.5 h-1.5 rounded-full"></span>
                                        <span x-text="getTypeMeta(change.type, change.description).label"></span>
                                    </div>
                                </div>

                                <div class="flex items-center gap-1 shrink-0">
                                    <button type="button"
                                            @click="copyAnchorLink(makeEntryAnchorId(change.category, changeIndex))"
                                            title="Copy direct link to entry"
                                            aria-label="Copy direct link to entry"
                                            class="tap-target sm:opacity-45 group-hover:opacity-100 focus:opacity-100 inline-flex items-center justify-center rounded-xl text-slate-400 hover:text-indigo-600 dark:hover:text-indigo-400 hover:bg-black/[0.04] dark:hover:bg-white/[0.06] transition-all cursor-pointer mono text-xs">
                                        #
                                    </button>
                                    <button type="button"
                                            @click="copyItem(change, changeIndex)"
                                            title="Copy change entry"
                                            aria-label="Copy change entry"
                                            class="tap-target sm:opacity-45 group-hover:opacity-100 focus:opacity-100 inline-flex items-center justify-center gap-1 px-2 rounded-xl text-slate-400 hover:text-indigo-600 dark:hover:text-indigo-400 hover:bg-black/[0.04] dark:hover:bg-white/[0.06] transition-all cursor-pointer">
                                        <svg x-show="copiedItemIndex !== changeIndex" class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path></svg>
                                        <span x-show="copiedItemIndex === changeIndex" x-cloak class="inline-flex items-center gap-1 text-[10.5px] mono font-semibold text-emerald-600 dark:text-emerald-400">
                                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path></svg>
                                            Copied
                                        </span>
                                    </button>
                                </div>
                            </div>

                            <div class="space-y-2">
                                <p :class="isLongText(change.description) && !isExpanded('rel-' + changeIndex) ? 'line-clamp-3' : ''"
                                   class="text-slate-700 dark:text-slate-200 leading-[1.7] text-[14px] font-normal break-words"
                                   x-html="formatDescription(change.description, versionSearch)"></p>
                                <template x-if="isLongText(change.description)">
                                    <button type="button"
                                            @click="toggleExpand('rel-' + changeIndex)"
                                            class="text-[11px] mono font-semibold text-indigo-600 dark:text-indigo-400 hover:underline cursor-pointer"
                                            x-text="isExpanded('rel-' + changeIndex) ? 'Show less' : 'Expand full diff'">
                                    </button>
                                </template>
                            </div>
                        </article>
                    </template>

                    <template x-if="currentVersionData.length > 0 && filteredVersionData.length === 0">
                        <div class="py-12 text-center soft-card rounded-2xl p-6">
                            <h2 class="text-xs font-semibold uppercase tracking-wider text-slate-700 dark:text-slate-300">No matching updates in release v<span x-text="selectedVersion"></span></h2>
                            <button type="button" @click="resetReleaseFilters()" class="mt-3 px-4 py-2 rounded-full bg-indigo-600 text-white text-xs font-semibold cursor-pointer hover:bg-indigo-700 transition-colors">
                                Reset Filters
                            </button>
                        </div>
                    </template>
                </div>
            </div>
        </div>

        <div x-show="viewMode === 'service'" x-cloak class="space-y-4 flex-1 w-full max-w-full min-w-0" role="region" aria-label="Service changelog" aria-live="polite" aria-atomic="false">
            <div class="px-1 py-1 flex items-center justify-between gap-3 flex-wrap">
                <div class="flex items-center gap-2.5 min-w-0">
                    <div class="w-7 h-7 rounded-xl flex items-center justify-center mono text-[10px] font-bold uppercase shrink-0"
                         :class="getServiceColorClass(activeService)"
                         x-text="(activeService || '').substring(0, 2).toUpperCase()"></div>
                    <div class="flex items-center gap-2 min-w-0 flex-wrap">
                        <span class="text-sm font-bold text-slate-900 dark:text-white uppercase mono truncate" x-text="'AWS ' + (activeService || '')"></span>
                        <span class="text-xs mono text-slate-500 dark:text-slate-400 tabular-nums" x-text="serviceHistoryCounts.total + ' updates'"></span>
                    </div>
                </div>

                <a :href="'/services/' + slugifyService(activeService) + '/'"
                   class="inline-flex items-center gap-1 text-xs mono font-semibold text-indigo-600 dark:text-indigo-400 hover:underline shrink-0">
                    <span>Open service page</span>
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
                </a>
            </div>

            <div class="space-y-3.5">
                <template x-if="serviceHistoryLoading">
                    <div class="space-y-3.5 animate-pulse">
                        <template x-for="i in 5">
                            <div class="h-24 bg-slate-900/[0.045] dark:bg-white/[0.04] rounded-2xl"></div>
                        </template>
                    </div>
                </template>

                <template x-for="(log, idx) in visibleServiceHistory" :key="(activeService || '') + '-' + log.v + '-' + idx">
                    <article :id="'svc-' + log.v.replace(/\./g, '-') + '-' + idx" class="changelog-card rounded-2xl p-4 sm:p-5 group scroll-mt-36">
                        <div class="flex items-center justify-between gap-2 mb-2.5 flex-wrap">
                            <div class="flex items-center gap-2">
                                <button type="button"
                                        @click="selectVersion(log.v, true); viewMode = 'release';"
                                        :title="'Switch to Release v' + log.v"
                                        class="px-2.5 py-0.5 rounded-full bg-indigo-500/12 text-indigo-700 dark:text-indigo-300 hover:bg-indigo-600 hover:text-white mono text-[11px] font-semibold transition-colors cursor-pointer tabular-nums"
                                        x-text="'v' + log.v">
                                </button>

                                <span :class="getTypeMeta('', log.t).badgeClass"
                                      class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[10px] mono font-medium">
                                    <span :class="getTypeMeta('', log.t).dotClass" class="w-1.5 h-1.5 rounded-full"></span>
                                    <span x-text="getTypeMeta('', log.t).label"></span>
                                </span>
                            </div>

                            <div class="flex items-center gap-1.5 shrink-0">
                                <time :datetime="getVersionDate(log.v)" class="text-[11px] mono text-slate-500 dark:text-slate-400 tabular-nums" x-text="formatDate(getVersionDate(log.v))"></time>
                                <button type="button"
                                        @click="copyAnchorLink('svc-' + log.v.replace(/\./g, '-') + '-' + idx)"
                                        title="Copy direct link to entry"
                                        aria-label="Copy direct link to entry"
                                        class="tap-target sm:opacity-45 group-hover:opacity-100 focus:opacity-100 inline-flex items-center justify-center rounded-xl text-slate-400 hover:text-indigo-600 dark:hover:text-indigo-400 hover:bg-black/[0.04] dark:hover:bg-white/[0.06] transition-all cursor-pointer mono text-xs">
                                    #
                                </button>
                                <button type="button"
                                        @click="copyItem({ category: activeService, description: log.t, version: log.v }, 'svc-' + idx)"
                                        title="Copy change entry"
                                        aria-label="Copy change entry"
                                        class="tap-target sm:opacity-45 group-hover:opacity-100 focus:opacity-100 inline-flex items-center justify-center gap-1 px-2 rounded-xl text-slate-400 hover:text-indigo-600 dark:hover:text-indigo-400 hover:bg-black/[0.04] dark:hover:bg-white/[0.06] transition-all cursor-pointer">
                                    <svg x-show="copiedItemIndex !== 'svc-' + idx" class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path></svg>
                                    <span x-show="copiedItemIndex === 'svc-' + idx" x-cloak class="inline-flex items-center gap-1 text-[10.5px] mono font-semibold text-emerald-600 dark:text-emerald-400">
                                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path></svg>
                                        Copied
                                    </span>
                                </button>
                            </div>
                        </div>

                        <div class="space-y-2">
                            <div :class="isLongText(log.t) && !isExpanded('svc-' + idx) ? 'line-clamp-3' : ''"
                                 class="text-slate-700 dark:text-slate-200 leading-[1.7] text-[14px] font-normal break-words"
                                 x-html="formatDescription(log.t, serviceHistorySearch)"></div>
                            <template x-if="isLongText(log.t)">
                                <button type="button"
                                        @click="toggleExpand('svc-' + idx)"
                                        class="text-[11px] mono font-semibold text-indigo-600 dark:text-indigo-400 hover:underline cursor-pointer"
                                        x-text="isExpanded('svc-' + idx) ? 'Show less' : 'Expand full diff'">
                                </button>
                            </template>
                        </div>
                    </article>
                </template>

                <template x-if="!serviceHistoryLoading && hasMoreServiceHistory">
                    <div class="pt-1">
                        <button type="button"
                                @click="loadMoreServiceHistory()"
                                class="w-full py-2.5 px-4 rounded-2xl soft-card text-indigo-600 dark:text-indigo-400 text-xs mono font-semibold transition-all cursor-pointer flex items-center justify-center gap-2 hover:shadow-md">
                            <span>Load More Updates (+40)</span>
                            <span class="text-[11px] opacity-75 font-normal tabular-nums" x-text="'(' + (filteredServiceHistory.length - visibleServiceHistory.length) + ' remaining)'"></span>
                        </button>
                    </div>
                </template>

                <template x-if="!serviceHistoryLoading && filteredServiceHistory.length === 0">
                    <div class="py-16 text-center soft-card rounded-2xl p-6">
                        <h2 class="text-xs font-semibold uppercase tracking-wider text-slate-700 dark:text-slate-300">No updates matching your criteria</h2>
                        <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">Try a different search term or reset the version/type filters.</p>
                        <button type="button" @click="serviceHistorySearch = ''; serviceHistoryFilter = 'all'; serviceVersionFilter = 'all'; serviceHistoryLimit = 40" class="mt-3 px-4 py-2 rounded-full bg-indigo-600 text-white text-xs font-semibold cursor-pointer hover:bg-indigo-700 transition-colors">
                            Reset Filters
                        </button>
                    </div>
                </template>
            </div>
        </div>

        <section aria-label="About BotoView" class="pt-6 text-xs text-slate-500 dark:text-slate-400 leading-relaxed space-y-2">
            <h2 class="text-xs font-semibold text-slate-700 dark:text-slate-300">
                BotoView — AWS Boto3 Changelogs &amp; Service Release Explorer
            </h2>
            <p>
                <strong>BotoView</strong> indexes every official <strong>AWS Boto3</strong> and <strong>Botocore changelog</strong> so Python developers can search API changes, new service operations, and SDK bug fixes by release or by AWS service. Jump directly to any service in the <a href="/services/" class="text-indigo-600 dark:text-indigo-400 hover:underline font-medium">AWS Services Directory</a> or browse chronological updates in the <a href="/releases/" class="text-indigo-600 dark:text-indigo-400 hover:underline font-medium">Boto3 Releases Archive</a>.
            </p>
            <nav aria-label="Core AWS services" class="flex items-center gap-x-3 gap-y-1 flex-wrap text-[11px] mono">
                <span class="text-slate-500 dark:text-slate-400 font-sans">Core services:</span>
                <a href="/services/s3/" class="hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">s3</a>
                <a href="/services/ec2/" class="hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">ec2</a>
                <a href="/services/bedrock/" class="hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">bedrock</a>
                <a href="/services/lambda/" class="hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">lambda</a>
                <a href="/services/dynamodb/" class="hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">dynamodb</a>
                <a href="/services/iam/" class="hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">iam</a>
                <a href="/services/sagemaker/" class="hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">sagemaker</a>
                <a href="/services/rds/" class="hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">rds</a>
            </nav>
        </section>

        <footer class="mt-auto pt-6 pb-4 text-xs text-slate-500 dark:text-slate-400 flex flex-col sm:flex-row items-center justify-between gap-3">
            <div class="flex items-center gap-2 flex-wrap justify-center">
                <img src="/favicon.svg" width="14" height="14" alt="BotoView" class="w-3.5 h-3.5 opacity-80" />
                <span class="font-semibold text-slate-800 dark:text-slate-200">BotoView</span>
                <span>by <a href="https://5goos.com/" target="_blank" rel="noopener noreferrer" class="hover:text-indigo-600 dark:hover:text-indigo-400 font-medium underline decoration-slate-300 dark:decoration-slate-700 underline-offset-2">5goos</a></span>
            </div>

            <div class="flex items-center gap-3 flex-wrap justify-center">
                <a href="/services/" class="hover:text-indigo-600 dark:hover:text-indigo-400 font-medium">Services</a>
