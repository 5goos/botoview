---
import { getServiceColorClass, formatDescription, formatDate } from '../utils/formatting';

interface Props {
    initialChanges?: Array<{ category: string; description: string; type: string }>;
    latestVersion?: { id: string; date: string };
    allServices?: string[];
}
const { initialChanges = [], latestVersion = { id: '', date: '' }, allServices = [] } = Astro.props;
---

<main id="mainScrollArea"
      @scroll="showBackToTop = $event.target.scrollTop > 350"
      class="flex-1 overflow-y-auto relative custom-scroll h-full min-h-0 bg-transparent theme-transition scroll-smooth"
      aria-label="Main Changelog Content">

    <header class="sticky top-0 z-30 h-12 glass-header backdrop-blur-md flex items-center">
        <div class="w-full max-w-6xl 2xl:max-w-7xl mx-auto px-3 sm:px-6 lg:px-8 h-full flex items-center justify-between gap-2">
            <!-- Left cluster (flex items-center gap-2 min-w-0 flex-1): Hamburger/drawer button (shrink-0) + dynamic title/breadcrumb (min-w-0 truncate) -->
            <div class="flex items-center gap-2 min-w-0 flex-1">
                <!-- Hamburger/drawer button (shrink-0) -->
                <button @click="showMobileVersions = true"
                        aria-label="Toggle navigation drawer"
                        class="lg:hidden flex items-center justify-center p-1.5 rounded-lg text-slate-600 dark:text-slate-300 hover:bg-slate-200/50 dark:hover:bg-white/10 transition-colors active:scale-95 shrink-0 cursor-pointer">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7"></path></svg>
                </button>

                <!-- Dynamic Title & Breadcrumb Container (flex-1 min-w-0 truncate) -->
                <!-- State A: User selects a Version (e.g., 1.35.92) -->
                <div x-show="viewMode === 'release'" class="flex items-center gap-2 min-w-0 flex-1 truncate">
                    <span class="text-xs sm:text-sm md:text-base font-bold mono text-slate-800 dark:text-slate-200 truncate min-w-0 tracking-tight" x-text="'v' + (selectedVersion || '...')"></span>
                    <template x-if="selectedDate">
                        <span class="text-xs mono text-slate-400 dark:text-slate-500 hidden md:inline shrink-0" x-text="'(' + formatDate(selectedDate) + ' • ' + getRelativeDate(selectedDate) + ')'"></span>
                    </template>
                    <div class="hidden sm:flex items-center gap-0.5 shrink-0 ml-1">
                        <button @click="adjacentVersions.newer && selectVersion(adjacentVersions.newer, true)"
                                :disabled="!adjacentVersions.newer"
                                title="Newer release (k)"
                                :class="adjacentVersions.newer ? 'hover:bg-slate-200/60 dark:hover:bg-white/10 text-slate-600 dark:text-slate-300 cursor-pointer' : 'text-slate-300 dark:text-white/10 cursor-not-allowed'"
                                class="p-1 rounded-lg transition-all active:scale-90">
                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7"></path></svg>
                        </button>
                        <button @click="adjacentVersions.older && selectVersion(adjacentVersions.older, true)"
                                :disabled="!adjacentVersions.older"
                                title="Older release (j)"
                                :class="adjacentVersions.older ? 'hover:bg-slate-200/60 dark:hover:bg-white/10 text-slate-600 dark:text-slate-300 cursor-pointer' : 'text-slate-300 dark:text-white/10 cursor-not-allowed'"
                                class="p-1 rounded-lg transition-all active:scale-90">
                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"></path></svg>
                        </button>
                    </div>
                </div>

                <!-- State B: User selects a Service directly (e.g., s3 or bedrock) -->
                <div x-show="viewMode === 'service' && !navigatedFromVersion" x-cloak class="flex items-center gap-1.5 min-w-0 flex-1 truncate">
                    <span class="text-xs sm:text-sm md:text-base font-bold mono uppercase text-slate-900 dark:text-white truncate min-w-0 tracking-tight" x-text="activeService"></span>
                    <span class="hidden md:inline-block px-1.5 py-0.5 rounded-full bg-indigo-500/10 text-indigo-600 dark:text-indigo-400 text-[9px] mono font-semibold shrink-0"
                          x-text="serviceHistory.length + ' updates'"></span>
                </div>

                <!-- State C: User navigates to a Service from a specific Version -->
                <div x-show="viewMode === 'service' && navigatedFromVersion" x-cloak class="flex items-center gap-1.5 min-w-0 flex-1 truncate">
                    <button @click="backToRelease()"
                            :title="'Back to Release v' + navigatedFromVersion + ' (Esc)'"
                            class="inline-flex items-center gap-0.5 text-xs sm:text-sm mono font-bold text-indigo-600 dark:text-indigo-400 hover:underline transition-all active:scale-95 cursor-pointer shrink-0">
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7"></path></svg>
                        <span>v<span x-text="navigatedFromVersion"></span></span>
                    </button>
                    <span class="text-slate-300 dark:text-white/20 shrink-0 text-xs sm:text-sm">/</span>
                    <span class="text-xs sm:text-sm md:text-base font-bold mono uppercase text-slate-900 dark:text-white truncate min-w-0 tracking-tight" x-text="activeService"></span>
                    <span class="hidden md:inline-block px-1.5 py-0.5 rounded-full bg-indigo-500/10 text-indigo-600 dark:text-indigo-400 text-[9px] mono font-semibold shrink-0"
                          x-text="serviceHistory.length + ' updates'"></span>
                </div>
            </div>

            <!-- Right cluster (flex items-center gap-1.5 shrink-0): Theme toggle + GitHub icon -->
            <div class="flex items-center gap-1.5 shrink-0">
                <div class="hidden md:flex items-center gap-2.5 text-[10px] mono text-slate-400 dark:text-slate-500 pr-1 select-none">
                    <span><kbd class="kbd-badge">/</kbd> filter</span>
                    <span><kbd class="kbd-badge">j</kbd><kbd class="kbd-badge ml-0.5">k</kbd> releases</span>
                    <span><kbd class="kbd-badge">t</kbd> theme</span>
                </div>

                <button @click="toggleTheme()"
                        aria-label="Toggle color theme"
                        title="Toggle dark / light theme (t)"
                        class="p-1.5 sm:p-2 rounded-xl text-slate-400 hover:text-slate-700 dark:hover:text-slate-200 hover:bg-slate-200/50 dark:hover:bg-white/10 transition-all active:scale-90 cursor-pointer shrink-0">
                    <svg x-show="!isDarkMode" class="w-4 h-4 text-slate-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path></svg>
                    <svg x-show="isDarkMode" x-cloak class="w-4 h-4 text-amber-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path></svg>
                </button>

                <a href="https://github.com/5goos/botoview" target="_blank" rel="noopener noreferrer"
                   title="Star BotoView on GitHub"
                   aria-label="GitHub Repository"
                   class="p-1.5 sm:p-2 rounded-xl text-slate-400 hover:text-slate-700 dark:hover:text-slate-200 hover:bg-slate-200/50 dark:hover:bg-white/10 transition-all active:scale-90 shrink-0">
                    <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
                </a>
            </div>
        </div>
    </header>

    <section aria-label="Changelog filters" class="sticky top-12 z-30 glass-toolbar backdrop-blur-md py-2 sm:py-2.5">
        <div class="w-full max-w-6xl 2xl:max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div x-show="viewMode === 'release'" class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 sm:gap-3">
                <div class="relative flex-1 group">
                    <input type="text" id="versionSearch" name="versionSearch" x-model.debounce.150ms="versionSearch"
                           placeholder="Filter changes in this release (e.g. s3, ami, fix)..."
                           aria-label="Filter changes in this release"
                           class="w-full glass-input rounded-xl py-1.5 pl-8 pr-7 text-[11px] font-medium text-slate-900 dark:text-white placeholder:text-slate-400 focus:outline-none">
                    <svg class="absolute left-2.5 top-[8px] w-3.5 h-3.5 text-slate-400 group-focus-within:text-indigo-500 transition-colors pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
                    <button x-show="versionSearch" @click="versionSearch = ''" aria-label="Clear filter input" class="absolute right-2 top-[7px] text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 p-0.5 cursor-pointer">
                        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                    </button>
                </div>

                <div class="flex items-center gap-1 p-0.5 glass-segmented rounded-xl mono text-[9.5px] flex-shrink-0 self-start sm:self-auto">
                    <button @click="activeFilter = 'all'"
                            :class="activeFilter === 'all' ? 'bg-white dark:bg-white/10 text-indigo-600 dark:text-indigo-400 font-bold shadow-xs' : 'text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white'"
                            class="px-2.5 py-1 rounded-lg uppercase transition-all cursor-pointer">
                        All (<span x-text="versionCounts.total"></span>)
                    </button>
                    <button @click="activeFilter = 'feature'"
                            :class="activeFilter === 'feature' ? 'bg-white dark:bg-white/10 text-emerald-600 dark:text-emerald-400 font-bold shadow-xs' : 'text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white'"
                            class="px-2.5 py-1 rounded-lg uppercase transition-all cursor-pointer">
                        Features (<span x-text="versionCounts.features"></span>)
                    </button>
                    <button @click="activeFilter = 'fix'"
                            :class="activeFilter === 'fix' ? 'bg-white dark:bg-white/10 text-rose-600 dark:text-rose-400 font-bold shadow-xs' : 'text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white'"
                            class="px-2.5 py-1 rounded-lg uppercase transition-all cursor-pointer">
                        Fixes (<span x-text="versionCounts.fixes"></span>)
                    </button>
                </div>
            </div>

            <div x-show="viewMode === 'service'" x-cloak class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 sm:gap-3">
                <div class="relative flex-1 group">
                    <input type="text" 
                           id="serviceHistorySearch" 
                           name="serviceHistorySearch" 
                           x-model.debounce.150ms="serviceHistorySearch" 
                           @input="serviceHistoryLimit = 40" 
                           :placeholder="'Search all ' + (serviceHistory.length || '') + ' ' + (activeService || '').toUpperCase() + ' updates...'"
                           aria-label="Search service changelogs"
                           class="w-full glass-input rounded-xl py-1.5 pl-8 pr-7 text-[11px] font-medium text-slate-900 dark:text-white placeholder:text-slate-400 focus:outline-none">
                    <svg class="absolute left-2.5 top-[8px] w-3.5 h-3.5 text-slate-400 group-focus-within:text-indigo-500 transition-colors pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
                    <button x-show="serviceHistorySearch" @click="serviceHistorySearch = ''; serviceHistoryLimit = 40" aria-label="Clear service history search" class="absolute right-2 top-[7px] text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 p-0.5 cursor-pointer">
                        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                    </button>
                </div>

                <div class="flex items-center gap-2 flex-wrap">
                    <div class="flex items-center gap-1 p-0.5 glass-segmented rounded-xl mono text-[9.5px]">
                        <button @click="serviceHistoryFilter = 'all'; serviceHistoryLimit = 40"
                                :class="serviceHistoryFilter === 'all' ? 'bg-white dark:bg-white/10 text-indigo-600 dark:text-indigo-400 font-bold shadow-xs' : 'text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white'"
                                class="px-2.5 py-1 rounded-lg uppercase transition-all cursor-pointer">
                            All (<span x-text="serviceHistoryCounts.total"></span>)
                        </button>
                        <button @click="serviceHistoryFilter = 'feature'; serviceHistoryLimit = 40"
                                :class="serviceHistoryFilter === 'feature' ? 'bg-white dark:bg-white/10 text-emerald-600 dark:text-emerald-400 font-bold shadow-xs' : 'text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white'"
                                class="px-2.5 py-1 rounded-lg uppercase transition-all cursor-pointer">
                            Features (<span x-text="serviceHistoryCounts.features"></span>)
                        </button>
                        <button @click="serviceHistoryFilter = 'fix'; serviceHistoryLimit = 40"
                                :class="serviceHistoryFilter === 'fix' ? 'bg-white dark:bg-white/10 text-rose-600 dark:text-rose-400 font-bold shadow-xs' : 'text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white'"
                                class="px-2.5 py-1 rounded-lg uppercase transition-all cursor-pointer">
                            Fixes (<span x-text="serviceHistoryCounts.fixes"></span>)
                        </button>
                    </div>

                    <template x-if="availableServiceVersionPrefixes.length > 0">
                        <select x-model="serviceVersionFilter" @change="serviceHistoryLimit = 40"
                                aria-label="Filter by major version"
                                class="glass-input rounded-lg px-2 py-1 text-slate-700 dark:text-slate-300 font-medium text-[10px] focus:outline-none cursor-pointer mono">
                            <option value="all">All Releases</option>
                            <template x-for="pfx in availableServiceVersionPrefixes" :key="pfx">
                                <option :value="pfx" x-text="'v' + pfx + '.x'"></option>
                            </template>
                        </select>
                    </template>

                    <div class="flex items-center gap-2 mono text-slate-400 dark:text-slate-500 text-[10px] sm:ml-auto">
                        <span>Showing <strong class="text-slate-900 dark:text-white font-bold" x-text="visibleServiceHistory.length"></strong> of <strong x-text="filteredServiceHistory.length"></strong></span>
                        <button x-show="serviceHistorySearch || serviceHistoryFilter !== 'all' || serviceVersionFilter !== 'all'"
                                x-cloak
                                @click="serviceHistorySearch = ''; serviceHistoryFilter = 'all'; serviceVersionFilter = 'all'; serviceHistoryLimit = 40"
                                class="text-indigo-600 dark:text-indigo-400 font-bold hover:underline cursor-pointer">
                            Reset
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <div class="w-full max-w-6xl 2xl:max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-4 pb-28 sm:pb-24 space-y-4 min-h-[calc(100vh-140px)] flex flex-col min-w-0">
        <div x-show="viewMode === 'release'" class="space-y-4 flex-1 w-full max-w-full min-w-0">
            <section aria-label="Services in this release" class="soft-card rounded-2xl p-4 sm:p-5 space-y-3 w-full max-w-full min-w-0 overflow-hidden">
                <div class="flex items-center justify-between gap-2 flex-wrap w-full max-w-full min-w-0">
                    <div class="flex items-center justify-between sm:justify-start gap-2 w-full sm:w-auto max-w-full min-w-0 flex-wrap">
                        <h2 class="text-xs font-bold uppercase tracking-wider text-slate-800 dark:text-slate-200 mono flex items-center gap-2 shrink-0">
                            <span class="w-1.5 h-1.5 rounded-full bg-indigo-500 shrink-0"></span>
                            <span>Services</span>
                        </h2>
                        <span class="px-2 py-0.5 rounded-full bg-slate-200/50 dark:bg-white/10 text-[9.5px] mono font-bold text-slate-600 dark:text-slate-400 shrink-0 whitespace-nowrap"
                              x-text="currentVersionServices.size + ' services'"></span>
                    </div>

                    <template x-if="releaseServiceFilter">
                        <div class="flex items-center gap-2 text-xs flex-wrap w-full sm:w-auto max-w-full min-w-0 pt-1 sm:pt-0">
                            <span class="text-slate-500 text-[11px] shrink-0">Filtered to:</span>
                            <span class="px-2.5 py-0.5 rounded-full bg-indigo-600 text-white font-bold mono uppercase text-[9.5px] shrink-0" x-text="releaseServiceFilter"></span>
                            <button @click="releaseServiceFilter = ''" class="text-slate-400 hover:text-rose-500 text-[10.5px] font-bold cursor-pointer shrink-0" title="Clear service filter">✕ Clear</button>
                            <a :href="'/services/' + (releaseServiceFilter || '').toLowerCase()" @click.prevent="openService(releaseServiceFilter, true, true)" class="text-indigo-600 dark:text-indigo-400 font-bold hover:underline text-[11px] mono cursor-pointer truncate max-w-[200px] sm:max-w-none">
                                Explore all <span class="uppercase" x-text="releaseServiceFilter"></span> updates &rarr;
                            </a>
                        </div>
                    </template>
                </div>

                <div class="flex items-center gap-1.5 flex-wrap pt-0.5 w-full max-w-full min-w-0">
                    <template x-for="svc in Array.from(currentVersionServices)" :key="svc">
                        <a :href="'/services/' + (svc || '').toLowerCase()" 
                           @click.prevent="toggleReleaseServiceFilter(svc)"
                           @mouseenter="prefetchService(svc)"
                           :class="releaseServiceFilter === svc ? 'bg-indigo-600 text-white font-bold shadow-xs scale-105' : getServiceColorClass(svc)"
                           :title="releaseServiceFilter === svc ? 'Clear ' + svc + ' filter' : 'Filter changelog to ' + svc"
                           class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg text-[10px] mono font-bold uppercase transition-all hover:scale-105 active:scale-95 cursor-pointer max-w-full">
                            <span class="truncate max-w-[200px] sm:max-w-none" x-text="svc"></span>
                            <span x-show="releaseServiceFilter === svc" x-cloak class="text-[8px] shrink-0">✕</span>
                        </a>
                    </template>
                    <span x-show="currentVersionServices.size === 0" class="text-[11px] mono text-slate-400">Core SDK changes only</span>
                </div>
            </section>

            <div class="space-y-3 pt-1">
                <!-- Static initial render for SEO crawlers and instant boot -->
                <div x-show="!isClientHydrated" class="space-y-3" id="ssr-changelog-stream">
                    {initialChanges.map((change) => {
                        const serviceSlug = change.category.toLowerCase().replace(/[\._\s]+/g, '-').replace(/-+/g, '-').replace(/^-|-$/g, '');
                        return (
                            <article class="soft-card rounded-2xl p-4 sm:p-5">
                                <div class="flex items-center justify-between gap-2 mb-2.5 flex-wrap">
                                    <div class="flex items-center gap-2 flex-wrap min-w-0">
                                        <a href={`/services/${serviceSlug}`} 
                                           class={`px-2.5 py-0.5 rounded-full text-[10px] mono font-bold uppercase tracking-wider ${getServiceColorClass(change.category)}`}>
                                            {change.category}
                                        </a>
                                        <span class="px-2 py-0.5 rounded-full bg-slate-100 dark:bg-white/[0.05] text-[9px] mono font-bold uppercase text-slate-600 dark:text-slate-400">
                                            {change.type}
                                        </span>
                                    </div>
                                </div>
                                <p class="text-slate-700 dark:text-slate-200 leading-relaxed text-[13.5px] sm:text-[14px] break-words" set:html={formatDescription(change.description)}></p>
                            </article>
                        );
                    })}
                </div>

                <div x-show="isClientHydrated" x-cloak class="space-y-3">
                    <template x-for="(change, changeIndex) in filteredVersionData" :key="change.category + '-' + change.type + '-' + change.description">
                        <article class="soft-card rounded-2xl p-4 sm:p-5 group">
                            <div class="flex items-center justify-between gap-2 mb-2.5 flex-wrap">
                                <div class="flex items-center gap-2 flex-wrap">
                                    <a :href="'/services/' + (change.category || '').toLowerCase().trim()"
                                       @click.prevent="openService(change.category, true, true)"
                                       @mouseenter="prefetchService(change.category)"
                                       :class="getServiceColorClass(change.category)"
                                       :title="'View complete history for ' + change.category"
                                       class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[10px] mono font-bold uppercase tracking-wider transition-all hover:scale-105 active:scale-95 cursor-pointer">
                                        <span x-html="highlight(change.category, versionSearch)"></span>
                                    </a>

                                    <div :class="{
                                        'text-rose-600 dark:text-rose-400 bg-rose-500/10': change.type.toLowerCase().includes('fix'),
                                        'text-blue-600 dark:text-blue-400 bg-blue-500/10': change.type.toLowerCase().includes('enhan'),
                                        'text-emerald-600 dark:text-emerald-400 bg-emerald-500/10': change.type.toLowerCase().includes('feature') || change.type.toLowerCase().includes('api'),
                                        'text-slate-600 dark:text-slate-400 bg-slate-500/10': !['fix', 'enhan', 'feature', 'api'].some(t => change.type.toLowerCase().includes(t))
                                    }" class="flex items-center gap-1.5 px-2 py-0.5 rounded-full text-[9px] mono font-bold uppercase tracking-wider">
                                        <span :class="{
                                            'bg-rose-500': change.type.toLowerCase().includes('fix'),
                                            'bg-blue-500': change.type.toLowerCase().includes('enhan'),
                                            'bg-emerald-500': change.type.toLowerCase().includes('feature') || change.type.toLowerCase().includes('api'),
                                            'bg-slate-500': !['fix', 'enhan', 'feature', 'api'].some(t => change.type.toLowerCase().includes(t))
                                        }" class="w-1.5 h-1.5 rounded-full"></span>
                                        <span x-text="change.type.includes('api') ? 'API Change' : change.type"></span>
                                    </div>
                                </div>

                                <button @click="copyItem(change, changeIndex)"
                                        title="Copy change entry"
                                        class="p-1 rounded-lg text-slate-400 hover:text-indigo-600 dark:hover:text-indigo-400 hover:bg-slate-100 dark:hover:bg-white/10 transition-colors cursor-pointer">
                                    <svg x-show="copiedItemIndex !== changeIndex" class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path></svg>
                                    <svg x-show="copiedItemIndex === changeIndex" x-cloak class="w-3.5 h-3.5 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path></svg>
                                </button>
                            </div>

                            <p class="text-slate-700 dark:text-slate-200 leading-relaxed text-[13.5px] sm:text-[14px] font-normal break-words" x-html="formatDescription(change.description, versionSearch)"></p>
                        </article>
                    </template>

                    <template x-if="currentVersionData.length > 0 && filteredVersionData.length === 0">
                        <div class="py-12 text-center soft-card rounded-2xl p-6">
                            <h2 class="text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">No matching updates in release v<span x-text="selectedVersion"></span></h2>
                            <button @click="versionSearch = ''; activeFilter = 'all'; releaseServiceFilter = ''" class="mt-3 px-3.5 py-1.5 rounded-full bg-indigo-600 text-white text-xs font-bold cursor-pointer hover:bg-indigo-700 transition-colors">
                                Reset Filters
                            </button>
                        </div>
                    </template>
                </div>
            </div>
        </div>

        <div x-show="viewMode === 'service'" x-cloak class="space-y-4 flex-1 w-full max-w-full min-w-0">
            <div class="space-y-3 pt-1">
                <template x-if="serviceHistoryLoading">
                    <div class="space-y-3 animate-pulse">
                        <template x-for="i in 5">
                            <div class="h-24 bg-white/50 dark:bg-white/[0.02] rounded-2xl"></div>
                        </template>
                    </div>
                </template>

                <template x-for="(log, idx) in visibleServiceHistory" :key="log.v + log.t">
                    <article class="soft-card rounded-2xl p-4 sm:p-5 group">
                        <div class="flex items-center justify-between gap-2 mb-2.5 flex-wrap">
                            <div class="flex items-center gap-2">
                                <button @click="selectVersion(log.v, true); viewMode = 'release';"
                                        :title="'Switch to Release ' + log.v"
                                        class="px-2.5 py-0.5 rounded-full bg-indigo-50 dark:bg-indigo-500/10 text-indigo-700 dark:text-indigo-300 hover:bg-indigo-600 hover:text-white mono text-[10px] font-bold transition-all active:scale-95 cursor-pointer"
                                        x-text="'v' + log.v">
                                </button>

                                <span :class="log.t.toLowerCase().includes('fix') ? 'bg-rose-500/10 text-rose-600 dark:text-rose-400' : 'bg-emerald-500/10 text-emerald-600 dark:text-emerald-400'"
                                      class="px-2 py-0.5 rounded-full text-[9px] mono font-bold uppercase"
                                      x-text="log.t.toLowerCase().includes('fix') ? 'Fix' : 'Feature / API'">
                                </span>

                                <button @click="copyToClipboard((activeService || '').toUpperCase() + ': ' + log.t + ' (' + log.v + ')')"
                                        title="Copy change entry"
                                        class="p-1 rounded-lg text-slate-400 hover:text-indigo-600 dark:hover:text-indigo-400 hover:bg-slate-100 dark:hover:bg-white/10 transition-colors cursor-pointer">
                                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path></svg>
                                </button>
                            </div>

                            <time class="text-[10px] mono text-slate-400 dark:text-slate-500 font-medium" x-text="getVersionDate(log.v)"></time>
                        </div>

                        <div class="text-slate-700 dark:text-slate-200 leading-relaxed text-[13.5px] sm:text-[14px] font-normal break-words" x-html="formatDescription(log.t, serviceHistorySearch)"></div>
                    </article>
                </template>

                <template x-if="!serviceHistoryLoading && hasMoreServiceHistory">
                    <div class="pt-2">
                        <button @click="loadMoreServiceHistory()"
                                class="w-full py-3 px-4 rounded-2xl bg-white/60 dark:bg-white/[0.03] hover:bg-indigo-50 dark:hover:bg-indigo-500/15 text-indigo-700 dark:text-indigo-300 text-xs mono font-bold uppercase tracking-wider transition-all active:scale-98 cursor-pointer flex items-center justify-center gap-2">
                            <span>Load More Updates (+40)</span>
                            <span class="text-[10px] opacity-75 font-normal" x-text="'(' + (filteredServiceHistory.length - visibleServiceHistory.length) + ' remaining)'"></span>
                        </button>
                    </div>
                </template>

                <template x-if="!serviceHistoryLoading && filteredServiceHistory.length === 0">
                    <div class="py-16 text-center soft-card rounded-2xl p-6">
                        <h2 class="text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">No updates matching your criteria</h2>
                        <p class="text-xs text-slate-400 mt-1">Try a different search term or reset the version/type filters.</p>
                        <button @click="serviceHistorySearch = ''; serviceHistoryFilter = 'all'; serviceVersionFilter = 'all'; serviceHistoryLimit = 40" class="mt-3 px-3.5 py-1.5 rounded-full bg-indigo-600 text-white text-xs font-bold cursor-pointer hover:bg-indigo-700 transition-colors">
                            Reset Filters
                        </button>
                    </div>
                </template>
            </div>
        </div>

        <footer class="mt-auto pt-10 pb-12 sm:pb-8 sm:pr-28 text-xs text-slate-400 dark:text-slate-500 flex flex-col sm:flex-row items-center justify-between gap-3">
            <div class="flex items-center gap-2">
                <img src="/favicon.svg" width="16" height="16" alt="BotoView" class="w-4 h-4 opacity-80" />
                <span class="font-bold text-slate-700 dark:text-slate-300">BotoView</span>
                <span>•</span>
                <span>Real-time AWS Boto3 SDK Explorer</span>
            </div>

            <div class="flex items-center gap-3">
                <a href="https://github.com/5goos/botoview" target="_blank" rel="noopener noreferrer" class="hover:text-indigo-600 dark:hover:text-indigo-400 font-medium">GitHub</a>
                <span>•</span>
                <span>Crafted by <a href="https://www.thurimerla.com/" target="_blank" rel="noopener noreferrer" class="hover:text-indigo-600 dark:hover:text-indigo-400 font-semibold underline decoration-slate-300 dark:decoration-slate-700 underline-offset-2">Naveen Thurimerla</a></span>
            </div>
        </footer>
    </div>

    <button x-show="showBackToTop"
            x-cloak
            x-transition:enter="transition ease-out duration-200"
            x-transition:enter-start="opacity-0 translate-y-2"
            x-transition:enter-end="opacity-100 translate-y-0"
            x-transition:leave="transition ease-in duration-150"
            x-transition:leave-start="opacity-100 translate-y-0"
            x-transition:leave-end="opacity-0 translate-y-2"
            @click="document.getElementById('mainScrollArea').scrollTo({ top: 0, behavior: 'smooth' })"
            aria-label="Scroll back to top"
            class="fixed bottom-6 right-6 z-40 flex items-center gap-1.5 px-3.5 py-1.5 rounded-full bg-slate-900/85 dark:bg-indigo-600/85 hover:bg-slate-900 dark:hover:bg-indigo-600 text-white backdrop-blur-xl shadow-lg border border-white/20 text-[11px] mono font-bold active:scale-95 cursor-pointer transition-all">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 10l7-7m0 0l7 7m-7-7v18"></path></svg>
        <span>Top</span>
    </button>
</main>
