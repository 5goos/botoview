<aside :class="{ 'translate-x-0': showMobileServices, 'translate-x-full': !showMobileServices }"
       class="fixed md:relative inset-y-0 right-0 translate-x-full md:translate-x-0 w-72 xl:w-80 max-w-[85vw] border-l border-slate-200/80 dark:border-white/5 bg-sidebar flex flex-col z-[100] md:z-10 transition-all duration-500 ease-in-out theme-transition">

    <div class="md:hidden flex items-center justify-between px-5 py-4 border-b border-subtle bg-card">
        <div class="flex items-center gap-2.5">
            <span class="w-2 h-2 rounded-full bg-indigo-500 shadow-[0_0_8px_rgba(99,102,241,0.6)]"></span>
            <div class="flex flex-col">
                <h2 class="text-xs mono text-slate-900 dark:text-white uppercase tracking-[0.2em] font-black italic leading-none">Services Directory</h2>
                <span class="text-[8px] mono text-slate-400 dark:text-slate-500 uppercase tracking-widest mt-0.5 font-bold" x-text="filteredServices.length + ' indexed services'"></span>
            </div>
        </div>
        <button @click="showMobileServices = false" aria-label="Close services sidebar" class="p-2 bg-slate-100 dark:bg-white/5 hover:bg-slate-200 dark:hover:bg-white/10 rounded-xl text-slate-400 hover:text-indigo-600 dark:hover:text-indigo-400 transition-all active:scale-90 cursor-pointer">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12"></path></svg>
        </button>
    </div>

    <div class="p-5 border-b border-slate-200/80 dark:border-white/5 bg-sidebar hidden md:block theme-transition">
        <div class="flex items-center justify-between mb-5">
            <div class="flex items-center gap-2">
                <h2 class="text-[10px] mono text-slate-500 dark:text-slate-400 uppercase tracking-[0.4em] font-black">Directory</h2>
                <template x-if="serviceSearch">
                    <span class="text-[8px] mono px-1.5 py-0.5 rounded-full bg-indigo-500/10 text-indigo-700 dark:text-indigo-300 font-bold" x-text="filteredServices.length + ' found'"></span>
                </template>
                <template x-if="!serviceSearch && currentVersionServices.size > 0">
                    <span class="text-[8px] mono px-1.5 py-0.5 rounded-full bg-indigo-500/10 text-indigo-700 dark:text-indigo-300 font-bold" x-text="currentVersionServices.size + ' active'"></span>
                </template>
            </div>
            <div class="flex gap-1.5 items-center">
                <div class="w-1 h-1 rounded-full bg-slate-200 dark:bg-slate-800"></div>
                <div class="w-1.5 h-1.5 rounded-full bg-indigo-500 shadow-[0_0_8px_rgba(99,102,241,0.6)]"></div>
            </div>
        </div>

        <div class="relative group/search">
            <input type="text" id="serviceSearch" name="serviceSearch" aria-label="Search services" x-model.debounce.200ms="serviceSearch"
                   x-ref="serviceSearch"
                   placeholder="Filter services..."
                   class="w-full bg-slate-50 dark:bg-white/[0.03] border border-slate-200/80 dark:border-white/10 rounded-2xl py-2.5 pl-10 pr-9 text-[11px] focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500/40 transition-all text-slate-900 dark:text-white placeholder:text-slate-400 dark:placeholder:text-slate-500 font-medium">
            <svg class="absolute left-3.5 top-[11px] w-3.5 h-3.5 text-slate-400 dark:text-slate-500 group-focus-within/search:text-indigo-500 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
            <div class="absolute right-3.5 top-[10px] flex items-center">
                <button x-show="serviceSearch" @click="serviceSearch = ''" aria-label="Clear service search" class="text-slate-400 hover:text-slate-600 dark:hover:text-slate-200">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                </button>
                <div x-show="!serviceSearch" class="hidden lg:flex items-center opacity-25 group-focus-within/search:opacity-0 transition-opacity pointer-events-none">
                    <span class="text-[10px] mono border border-slate-400 dark:border-slate-600 rounded px-1.5">/</span>
                </div>
            </div>
        </div>
    </div>

    <div class="md:hidden p-4 border-b border-subtle bg-sidebar">
        <div class="relative group/search">
            <input type="text" id="serviceSearchMobile" name="serviceSearchMobile" aria-label="Search services on mobile" x-model.debounce.200ms="serviceSearch" placeholder="Search AWS services (e.g. s3, bedrock)..."
                   class="w-full bg-white dark:bg-white/[0.04] border border-slate-200/90 dark:border-white/10 rounded-xl py-2.5 pl-10 pr-9 text-xs focus:outline-none focus:ring-2 focus:ring-indigo-500/25 focus:border-indigo-500 transition-all text-slate-900 dark:text-white placeholder:text-slate-400 dark:placeholder:text-slate-500 shadow-xs font-medium">
            <svg class="absolute left-3.5 top-[11px] w-4 h-4 text-slate-400 dark:text-slate-500 group-focus-within/search:text-indigo-500 transition-colors pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
            <button x-show="serviceSearch" @click="serviceSearch = ''" aria-label="Clear service search" class="absolute right-3 top-2.5 text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 p-0.5">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
            </button>
        </div>
    </div>

    <div class="flex-1 overflow-y-auto p-4 sm:p-6 space-y-1.5 custom-scroll bg-sidebar">
        <template x-for="service in filteredServices" :key="service">
            <button @click="openService(service); if(isMobile(768)) showMobileServices = false;"
                    @mouseenter="prefetchService(service)"
                    :aria-label="'View release history for ' + service"
                    class="w-full text-left px-4 py-3 rounded-xl bg-white dark:bg-white/[0.02] border border-slate-200/80 dark:border-white/5 shadow-sm hover:border-indigo-500/30 dark:hover:border-indigo-500/40 hover:shadow-md group transition-all flex items-center justify-between relative overflow-hidden active:scale-95 mb-2 cursor-pointer">

                <div class="flex items-center gap-4 relative z-10">
                    <div class="w-8 h-8 rounded-lg flex items-center justify-center mono text-[10px] font-black transition-all border group-hover:scale-105"
                         :class="getServiceColorClass(service)"
                         x-text="service.substring(0,2).toUpperCase()"></div>
                    <div class="flex flex-col">
                        <div class="flex items-center gap-2">
                            <span class="mono text-[11px] text-slate-700 dark:text-slate-300 group-hover:text-slate-900 dark:group-hover:text-white font-bold tracking-tight transition-colors uppercase" x-html="highlight(service, serviceSearch)"></span>
                            <span x-show="currentVersionServices.has(service.toLowerCase())" x-cloak class="w-1.5 h-1.5 rounded-full bg-indigo-500 shadow-[0_0_8px_rgba(99,102,241,0.8)]" title="Updated in current release"></span>
                        </div>
                    </div>
                </div>
                <svg class="w-4 h-4 text-slate-300 dark:text-slate-600 group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-all -translate-x-1 group-hover:translate-x-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
            </button>
        </template>
    </div>
</aside>
