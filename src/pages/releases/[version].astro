---
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import { getServiceColorClass, formatDescription, formatDate } from '../../utils/formatting';
import fs from 'node:fs';
import path from 'node:path';

export async function getStaticPaths() {
    const trackPath = path.resolve('./public/data/track.json');
    let versions: Array<{ id: string; date: string }> = [];
    try {
        const raw = fs.readFileSync(trackPath, 'utf-8');
        const parsed = JSON.parse(raw);
        versions = parsed.versions || [];
    } catch (e) {
        versions = [];
    }

    return versions.map((v, index) => {
        let changes: Array<{ category: string; description: string; type: string }> = [];
        try {
            const vPath = path.resolve(`./public/data/versions/${v.id}.json`);
            if (fs.existsSync(vPath)) {
                changes = JSON.parse(fs.readFileSync(vPath, 'utf-8'));
            }
        } catch (e) {}

        const newerVersion = index > 0 ? versions[index - 1]?.id : null;
        const olderVersion = index < versions.length - 1 ? versions[index + 1]?.id : null;

        return {
            params: { version: v.id },
            props: {
                version: v.id,
                date: v.date || '',
                changes,
                newerVersion,
                olderVersion
            }
        };
    });
}

const { version, date, changes, newerVersion, olderVersion } = Astro.props;

// Compute unique services modified in this release
const servicesModified = Array.from(new Set(changes.map(c => c.category).filter(Boolean))).sort();
const totalChanges = changes.length;

const pageTitle = `AWS Boto3 v${version} Changelog & Release Notes | BotoView`;
const pageDescription = `Complete AWS Boto3 v${version} changelog${date ? ' (' + date + ')' : ''}. Explore ${totalChanges} updates across ${servicesModified.length} AWS services, breaking changes, and API updates.`;
const canonicalUrl = `https://botoview.5goos.com/releases/${version}`;

const breadcrumbSchema = {
    "@type": "BreadcrumbList",
    "itemListElement": [
        {
            "@type": "ListItem",
            "position": 1,
            "name": "Home",
            "item": "https://botoview.5goos.com/"
        },
        {
            "@type": "ListItem",
            "position": 2,
            "name": "Releases",
            "item": "https://botoview.5goos.com/releases"
        },
        {
            "@type": "ListItem",
            "position": 3,
            "name": `v${version}`,
            "item": canonicalUrl
        }
    ]
};

const articleSchema = {
    "@type": "TechArticle",
    "@id": `${canonicalUrl}#article`,
    "headline": `AWS Boto3 v${version} Changelog & Release Notes`,
    "description": pageDescription,
    "url": canonicalUrl,
    "datePublished": date || new Date().toISOString().split('T')[0],
    "author": {
        "@type": "Organization",
        "name": "5goos",
        "url": "https://botoview.5goos.com/"
    },
    "publisher": {
        "@type": "Organization",
        "name": "BotoView",
        "url": "https://botoview.5goos.com/"
    }
};

const faqSchema = {
    "@type": "FAQPage",
    "mainEntity": [
        {
            "@type": "Question",
            "name": `When was AWS Boto3 v${version} released?`,
            "acceptedAnswer": {
                "@type": "Answer",
                "text": date 
                    ? `AWS Boto3 v${version} was released on ${formatDate(date)} (${date}).`
                    : `AWS Boto3 v${version} release date is tracked in BotoView.`
            }
        },
        {
            "@type": "Question",
            "name": `Which AWS services were updated in Boto3 v${version}?`,
            "acceptedAnswer": {
                "@type": "Answer",
                "text": servicesModified.length > 0 
                    ? `Boto3 v${version} updated ${servicesModified.length} AWS services: ${servicesModified.slice(0, 10).join(', ')}${servicesModified.length > 10 ? ' and others' : ''}.`
                    : `Boto3 v${version} contains general core SDK updates.`
            }
        },
        {
            "@type": "Question",
            "name": `How to install AWS Boto3 v${version}?`,
            "acceptedAnswer": {
                "@type": "Answer",
                "text": `To install this specific version, run: pip install boto3==${version}`
            }
        }
    ]
};
---

<Layout 
    title={pageTitle} 
    description={pageDescription} 
    canonical={canonicalUrl}
    bodyClass="min-h-screen w-full overflow-y-auto text-[var(--text-secondary)] transition-colors duration-500"
    jsonLd={[breadcrumbSchema, articleSchema, faqSchema]}
>
    <div class="min-h-screen flex flex-col bg-transparent" x-data="{ search: '', activeFilter: 'all', copiedIdx: null }">
        <header class="h-12 flex items-center justify-between px-3.5 sm:px-8 glass-header sticky top-0 z-40">
            <div class="flex items-center gap-2 sm:gap-3 min-w-0">
                <a href="/" class="flex items-center gap-2 group cursor-pointer flex-shrink-0" aria-label="BotoView Home">
                    <img src="/favicon.svg" width="22" height="22" alt="BotoView logo" class="w-5 sm:w-6 h-5 sm:h-6 drop-shadow-xs group-hover:scale-105 transition-transform" />
                    <span class="text-xs sm:text-sm font-black italic tracking-tighter uppercase text-slate-900 dark:text-white leading-none">BotoView</span>
                </a>
                <span class="text-slate-300 dark:text-white/10 hidden sm:inline">/</span>
                <a href="/releases" class="hidden sm:inline text-xs mono font-bold uppercase tracking-wider text-slate-500 hover:text-indigo-600 dark:text-slate-400 dark:hover:text-indigo-400 transition-colors">
                    Releases
                </a>
                <span class="text-slate-300 dark:text-white/10">/</span>
                <span class="text-xs mono font-black uppercase text-indigo-600 dark:text-indigo-400 truncate max-w-[120px] sm:max-w-none">
                    v{version}
                </span>
            </div>

            <div class="flex items-center gap-2 sm:gap-3 flex-shrink-0">
                <div class="flex items-center gap-1">
                    {newerVersion && (
                        <a href={`/releases/${newerVersion}`} 
                           title={`Newer release v${newerVersion}`} 
                           class="p-1 sm:px-2.5 sm:py-1 rounded-lg text-slate-500 hover:text-indigo-600 dark:text-slate-400 dark:hover:text-indigo-400 hover:bg-slate-200/50 dark:hover:bg-white/10 text-xs mono transition-all flex items-center gap-1">
                            <span>&larr;</span>
                            <span class="hidden sm:inline">v{newerVersion}</span>
                        </a>
                    )}
                    {olderVersion && (
                        <a href={`/releases/${olderVersion}`} 
                           title={`Older release v${olderVersion}`} 
                           class="p-1 sm:px-2.5 sm:py-1 rounded-lg text-slate-500 hover:text-indigo-600 dark:text-slate-400 dark:hover:text-indigo-400 hover:bg-slate-200/50 dark:hover:bg-white/10 text-xs mono transition-all flex items-center gap-1">
                            <span class="hidden sm:inline">v{olderVersion}</span>
                            <span>&rarr;</span>
                        </a>
                    )}
                </div>

                <a href={`/?v=${version}`} 
                   title="Open in interactive timeline explorer"
                   class="inline-flex items-center gap-1.5 px-2.5 sm:px-3.5 py-1.5 bg-indigo-600 hover:bg-indigo-700 text-white rounded-full text-xs font-bold transition-all active:scale-95 shadow-sm shadow-indigo-500/25 flex-shrink-0">
                    <span class="hidden sm:inline">Interactive Timeline</span>
                    <span class="sm:hidden text-[11px]">Timeline</span>
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
                </a>
            </div>
        </header>

        <main class="flex-1 max-w-5xl w-full mx-auto px-4 sm:px-6 py-6 sm:py-10 space-y-6">
            <nav class="flex items-center gap-2 text-xs mono text-slate-400" aria-label="Breadcrumb">
                <a href="/" class="hover:text-indigo-600 dark:hover:text-indigo-400">Home</a>
                <span>/</span>
                <a href="/releases" class="hover:text-indigo-600 dark:hover:text-indigo-400">Releases</a>
                <span>/</span>
                <span class="text-slate-700 dark:text-slate-200 font-bold">v{version}</span>
            </nav>

            <header class="soft-card p-5 sm:p-6 rounded-3xl space-y-4">
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                    <div class="space-y-1">
                        <div class="flex items-center gap-2.5 flex-wrap">
                            <h1 class="text-2xl sm:text-3xl font-black mono text-slate-900 dark:text-white tracking-tight">
                                AWS Boto3 v{version}
                            </h1>
                            <span class="px-2.5 py-0.5 rounded-full bg-indigo-500/10 text-indigo-700 dark:text-indigo-300 text-xs mono font-bold">
                                {totalChanges} updates
                            </span>
                        </div>
                        {date && (
                            <p class="text-xs sm:text-sm mono text-slate-500 dark:text-slate-400">
                                Released on <time datetime={date}>{formatDate(date)}</time> ({date})
                            </p>
                        )}
                    </div>

                    <div class="flex items-center gap-2 p-1.5 pl-3 bg-slate-100 dark:bg-white/[0.04] rounded-xl border border-black/[0.04] dark:border-white/[0.06] mono text-xs self-start sm:self-auto">
                        <span class="text-slate-500 select-none">$</span>
                        <code class="text-indigo-600 dark:text-indigo-400 font-semibold select-all">pip install boto3=={version}</code>
                    </div>
                </div>

                {servicesModified.length > 0 && (
                    <div class="pt-2 border-t border-black/[0.04] dark:border-white/[0.06] space-y-2">
                        <div class="flex items-center gap-2">
                            <span class="text-xs font-bold uppercase tracking-wider text-slate-600 dark:text-slate-400 mono">
                                Services Modified ({servicesModified.length})
                            </span>
                        </div>
                        <div class="flex items-center gap-1.5 flex-wrap">
                            {servicesModified.map(svc => (
                                <a href={`/services/${svc}`} 
                                   title={`View all ${svc} changelog history`}
                                   class={`inline-flex items-center gap-1 px-2.5 py-1 rounded-lg text-[10px] mono font-bold uppercase transition-all hover:scale-105 active:scale-95 ${getServiceColorClass(svc)}`}>
                                    <span>{svc}</span>
                                </a>
                            ))}
                        </div>
                    </div>
                )}
            </header>

            <div class="soft-card p-2.5 sm:p-3 rounded-2xl flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-2.5">
                <div class="relative flex-1 group">
                    <input type="text" 
                           x-model.debounce.150ms="search" 
                           placeholder={`Filter ${totalChanges} updates in v${version} (e.g. s3, fix, bucket)...`} 
                           aria-label={`Filter updates in v${version}`}
                           class="w-full glass-input rounded-xl py-1.5 pl-8 pr-7 text-[11px] focus:outline-none text-slate-900 dark:text-white placeholder:text-slate-400 font-medium transition-all" />
                    <svg class="absolute left-2.5 top-[8px] w-3.5 h-3.5 text-slate-400 group-focus-within:text-indigo-500 transition-colors pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
                    <button x-show="search" @click="search = ''" aria-label="Clear filter" class="absolute right-2 top-[7px] text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 p-0.5">
                        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                    </button>
                </div>

                <div class="flex items-center gap-1 p-0.5 glass-segmented rounded-xl mono text-[9.5px] flex-shrink-0">
                    <button @click="activeFilter = 'all'" 
                            :class="activeFilter === 'all' ? 'bg-white dark:bg-white/10 text-indigo-600 dark:text-indigo-400 font-bold shadow-xs' : 'text-slate-500 hover:text-slate-900 dark:hover:text-white'"
                            class="px-2.5 py-1 rounded-lg uppercase transition-all cursor-pointer">
                        All ({totalChanges})
                    </button>
                    <button @click="activeFilter = 'feature'" 
                            :class="activeFilter === 'feature' ? 'bg-white dark:bg-white/10 text-emerald-600 dark:text-emerald-400 font-bold shadow-xs' : 'text-slate-500 hover:text-slate-900 dark:hover:text-white'"
                            class="px-2.5 py-1 rounded-lg uppercase transition-all cursor-pointer">
                        Features
                    </button>
                    <button @click="activeFilter = 'fix'" 
                            :class="activeFilter === 'fix' ? 'bg-white dark:bg-white/10 text-rose-600 dark:text-rose-400 font-bold shadow-xs' : 'text-slate-500 hover:text-slate-900 dark:hover:text-white'"
                            class="px-2.5 py-1 rounded-lg uppercase transition-all cursor-pointer">
                        Fixes
                    </button>
                </div>
            </div>

            <section aria-label={`Changelog entries in v${version}`} class="space-y-3">
                {changes.map((change, idx) => {
                    const isFix = change.type.toLowerCase().includes('fix');
                    const isFeature = change.type.toLowerCase().includes('feature') || change.type.toLowerCase().includes('api');
                    return (
                        <article class="soft-card rounded-2xl p-4 sm:p-5 group" 
                                 x-show={`(!search || '${change.category}'.toLowerCase().includes(search.toLowerCase()) || '${change.description}'.toLowerCase().includes(search.toLowerCase())) && (activeFilter === 'all' || (activeFilter === 'fix' && '${change.type}'.toLowerCase().includes('fix')) || (activeFilter === 'feature' && ('${change.type}'.toLowerCase().includes('feature') || '${change.type}'.toLowerCase().includes('api'))))`}>
                            <div class="flex items-center justify-between gap-2 mb-2 flex-wrap">
                                <div class="flex items-center gap-2">
                                    <a href={`/services/${change.category}`} 
                                       title={`Explore all ${change.category} updates`}
                                       class={`px-2.5 py-0.5 rounded-full text-[10px] mono font-bold uppercase tracking-wider transition-all hover:scale-105 ${getServiceColorClass(change.category)}`}>
                                        {change.category}
                                    </a>
                                    <span class={`px-2 py-0.5 rounded-full text-[9px] mono font-bold uppercase tracking-wider ${isFix ? 'bg-rose-500/10 text-rose-600 dark:text-rose-400' : (isFeature ? 'bg-emerald-500/10 text-emerald-600 dark:text-emerald-400' : 'bg-slate-500/10 text-slate-600 dark:text-slate-400')}`}>
                                        {change.type.includes('api') ? 'API Change' : change.type}
                                    </span>
                                </div>

                                <button @click={`navigator.clipboard.writeText('${change.category}: ${change.description.replace(/'/g, "\\'")} (v${version})'); copiedIdx = ${idx}; setTimeout(() => copiedIdx = null, 2000)`}
                                        title="Copy change entry"
                                        class="p-1 rounded-lg text-slate-400 hover:text-indigo-600 dark:hover:text-indigo-400 hover:bg-slate-100 dark:hover:bg-white/10 transition-colors cursor-pointer">
                                    <span x-show={`copiedIdx !== ${idx}`} class="text-[10px] mono">Copy</span>
                                    <span x-show={`copiedIdx === ${idx}`} x-cloak class="text-[10px] mono text-emerald-500 font-bold">Copied!</span>
                                </button>
                            </div>
                            <p class="text-slate-700 dark:text-slate-200 leading-relaxed text-[13.5px] sm:text-[14px]" set:html={formatDescription(change.description)}></p>
                        </article>
                    );
                })}
            </section>
        </main>

        <!-- Footer -->
        <footer class="mt-auto py-10 px-4 sm:px-8 border-t border-black/[0.04] dark:border-white/[0.06] bg-transparent">
            <div class="max-w-5xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-4 text-xs">
                <div class="flex items-center gap-2">
                    <img src="/favicon.svg" width="18" height="18" alt="BotoView" class="w-4 h-4 opacity-80" />
                    <span class="font-bold text-slate-700 dark:text-slate-300">BotoView</span>
                    <span class="text-slate-400">&copy; {new Date().getFullYear()}</span>
                </div>
                <div class="flex items-center gap-4 text-slate-500">
                    <a href="/" class="hover:text-indigo-600 dark:hover:text-indigo-400">Timeline Explorer</a>
                    <a href="/services" class="hover:text-indigo-600 dark:hover:text-indigo-400">Services Directory</a>
                    <a href="/releases" class="hover:text-indigo-600 dark:hover:text-indigo-400">Releases Directory</a>
                    <a href="https://github.com/5goos/botoview" target="_blank" rel="noopener noreferrer" class="hover:text-indigo-600 dark:hover:text-indigo-400">GitHub</a>
                </div>
            </div>
        </footer>
    </div>
</Layout>
