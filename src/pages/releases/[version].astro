---
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import { getServiceColorClass, formatDescription, formatDate, slugifyService } from '../../utils/formatting';
import { loadReleaseChanges } from '../../utils/data';
import trackData from '../../../public/data/track.json';

export async function getStaticPaths() {
    const versions: Array<{ id: string; date: string }> = trackData?.versions || [];

    return versions.map((v, index) => {
        const changes = loadReleaseChanges(v.id);
        const newerVersion = index > 0 ? versions[index - 1]?.id : null;
        const olderVersion = index < versions.length - 1 ? versions[index + 1]?.id : null;

        return {
            params: { version: v.id },
            props: {
                version: v.id,
                date: v.date || '',
                changes,
                newerVersion,
                olderVersion
            }
        };
    });
}

const version = Astro.props.version || Astro.params.version || '';
const versions: Array<{ id: string; date: string }> = trackData?.versions || [];
const versionIndex = versions.findIndex(v => v.id === version);
const newerVersion = Astro.props.newerVersion !== undefined 
    ? Astro.props.newerVersion 
    : (versionIndex > 0 ? versions[versionIndex - 1]?.id : null);
const olderVersion = Astro.props.olderVersion !== undefined 
    ? Astro.props.olderVersion 
    : (versionIndex >= 0 && versionIndex < versions.length - 1 ? versions[versionIndex + 1]?.id : null);
const date = Astro.props.date || (versionIndex >= 0 ? versions[versionIndex]?.date : '') || '';

let changes: Array<{ category: string; description: string; type: string }> = Astro.props.changes;
if (!changes || changes.length === 0) {
    changes = loadReleaseChanges(version);
}
changes = changes || [];

const servicesModified = Array.from(new Set(changes.map(c => c.category).filter(Boolean))).sort();
const totalChanges = changes.length;

const pageTitle = `AWS Boto3 v${version} Changelog & Release Notes | BotoView`;
const pageDescription = `Complete AWS Boto3 v${version} changelog${date ? ' (' + date + ')' : ''}. Explore ${totalChanges} updates across ${servicesModified.length} AWS services, breaking changes, and API updates.`;
const canonicalUrl = `https://botoview.5goos.com/releases/${version}/`;

const breadcrumbSchema = {
    "@type": "BreadcrumbList",
    "itemListElement": [
        {
            "@type": "ListItem",
            "position": 1,
            "name": "Home",
            "item": "https://botoview.5goos.com/"
        },
        {
            "@type": "ListItem",
            "position": 2,
            "name": "Releases",
            "item": "https://botoview.5goos.com/releases/"
        },
        {
            "@type": "ListItem",
            "position": 3,
            "name": `v${version}`,
            "item": canonicalUrl
        }
    ]
};

const articleSchema = {
    "@type": "TechArticle",
    "@id": `${canonicalUrl}#article`,
    "headline": `AWS Boto3 v${version} Changelog & Release Notes`,
    "description": pageDescription,
    "url": canonicalUrl,
    "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": canonicalUrl
    },
    "image": "https://botoview.5goos.com/og-image.png",
    "datePublished": date || new Date().toISOString().split('T')[0],
    "dateModified": date || new Date().toISOString().split('T')[0],
    "author": {
        "@type": "Organization",
        "@id": "https://5goos.com/#organization",
        "name": "5goos",
        "url": "https://5goos.com/"
    },
    "publisher": {
        "@type": "Organization",
        "@id": "https://5goos.com/#organization",
        "name": "5goos",
        "url": "https://5goos.com/",
        "logo": {
            "@type": "ImageObject",
            "url": "https://botoview.5goos.com/favicon.png"
        }
    }
};

const faqSchema = {
    "@type": "FAQPage",
    "mainEntity": [
        {
            "@type": "Question",
            "name": `When was AWS Boto3 v${version} released?`,
            "acceptedAnswer": {
                "@type": "Answer",
                "text": date 
                    ? `AWS Boto3 v${version} was released on ${formatDate(date)} (${date}).`
                    : `AWS Boto3 v${version} release date is tracked in BotoView.`
            }
        },
        {
            "@type": "Question",
            "name": `Which AWS services were updated in Boto3 v${version}?`,
            "acceptedAnswer": {
                "@type": "Answer",
                "text": servicesModified.length > 0 
                    ? `Boto3 v${version} updated ${servicesModified.length} AWS services: ${servicesModified.slice(0, 10).join(', ')}${servicesModified.length > 10 ? ' and others' : ''}.`
                    : `Boto3 v${version} contains general core SDK updates.`
            }
        },
        {
            "@type": "Question",
            "name": `How to install AWS Boto3 v${version}?`,
            "acceptedAnswer": {
                "@type": "Answer",
                "text": `To install this specific version, run: pip install boto3==${version}`
            }
        }
    ]
};
---

<Layout 
    title={pageTitle} 
    description={pageDescription} 
    canonical={canonicalUrl}
    robots="noindex, follow"
    bodyClass="min-h-screen w-full overflow-y-auto text-[var(--text-secondary)] transition-colors duration-500"
    jsonLd={[breadcrumbSchema, articleSchema, faqSchema]}
>
    <div class="min-h-screen flex flex-col bg-transparent" x-data="releasePage" @keydown.window="handleKeydown($event)">
        <header class="h-12 glass-header sticky top-0 z-40 flex items-center">
            <div class="w-full max-w-5xl mx-auto px-4 sm:px-6 flex items-center justify-between gap-3">
                <div class="flex items-center gap-2 sm:gap-3 min-w-0">
                    <a href="/" class="flex items-center gap-2 group cursor-pointer shrink-0" aria-label="BotoView Home">
                        <img src="/favicon.svg" width="22" height="22" alt="BotoView logo" class="w-5 sm:w-6 h-5 sm:h-6 drop-shadow-xs group-hover:scale-105 transition-transform" />
                        <span class="text-xs sm:text-sm font-black italic tracking-tighter uppercase text-slate-900 dark:text-white leading-none">BotoView</span>
                    </a>
                    <span class="text-slate-300 dark:text-white/10 hidden sm:inline">/</span>
                    <a href="/releases/" class="hidden sm:inline text-xs mono font-bold uppercase tracking-wider text-slate-500 hover:text-indigo-600 dark:text-slate-400 dark:hover:text-indigo-400 transition-colors">
                        Releases
                    </a>
                    <span class="text-slate-300 dark:text-white/10">/</span>
                    <span class="text-xs mono font-black uppercase text-indigo-600 dark:text-indigo-400 truncate max-w-[120px] sm:max-w-none">
                        v{version}
                    </span>
                </div>

                <div class="flex items-center gap-2 sm:gap-3 shrink-0">
                    <div class="flex items-center gap-1">
                        {newerVersion && (
                            <a href={`/releases/${newerVersion}/`} 
                               title={`Newer release v${newerVersion}`} 
                               class="p-1 sm:px-2.5 sm:py-1 rounded-lg text-slate-500 hover:text-indigo-600 dark:text-slate-400 dark:hover:text-indigo-400 hover:bg-slate-200/50 dark:hover:bg-white/10 text-xs mono transition-all flex items-center gap-1">
                                <span>&larr;</span>
                                <span class="hidden sm:inline">v{newerVersion}</span>
                            </a>
                        )}
                        {olderVersion && (
                            <a href={`/releases/${olderVersion}/`} 
                               title={`Older release v${olderVersion}`} 
                               class="p-1 sm:px-2.5 sm:py-1 rounded-lg text-slate-500 hover:text-indigo-600 dark:text-slate-400 dark:hover:text-indigo-400 hover:bg-slate-200/50 dark:hover:bg-white/10 text-xs mono transition-all flex items-center gap-1">
                                <span class="hidden sm:inline">v{olderVersion}</span>
                                <span>&rarr;</span>
                            </a>
                        )}
                    </div>

                    <a href={`/?v=${version}`} 
                       title="Open in interactive timeline explorer"
                       class="inline-flex items-center gap-1.5 px-2.5 sm:px-3.5 py-1.5 bg-indigo-600 hover:bg-indigo-700 text-white rounded-full text-xs font-bold transition-all active:scale-95 shadow-sm shadow-indigo-500/25 shrink-0">
                        <span class="hidden sm:inline">Interactive Timeline</span>
                        <span class="sm:hidden text-[11px]">Timeline</span>
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
                    </a>

                    <button @click="toggleTheme()" 
                            aria-label="Toggle dark mode"
                            class="p-1.5 sm:p-2 rounded-xl text-slate-400 hover:text-slate-700 dark:hover:text-slate-200 hover:bg-slate-200/50 dark:hover:bg-white/10 transition-all cursor-pointer shrink-0">
                        <svg x-show="!isDarkMode" class="w-4 h-4 text-slate-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path></svg>
                        <svg x-show="isDarkMode" x-cloak class="w-4 h-4 text-amber-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path></svg>
                    </button>

                    <a href="https://github.com/5goos/botoview" target="_blank" rel="noopener noreferrer" aria-label="GitHub repository" class="p-1.5 sm:p-2 rounded-xl text-slate-400 hover:text-slate-700 dark:hover:text-slate-200 hover:bg-slate-200/50 dark:hover:bg-white/10 transition-all shrink-0">
                        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
                    </a>
                </div>
            </div>
        </header>

        <main id="mainScrollArea" tabindex="-1" class="flex-1 max-w-5xl w-full mx-auto px-4 sm:px-6 py-6 sm:py-10 space-y-5">
            <nav class="flex items-center gap-2 text-xs mono text-slate-400" aria-label="Breadcrumb">
                <a href="/" class="hover:text-indigo-600 dark:hover:text-indigo-400">Home</a>
                <span>/</span>
                <a href="/releases/" class="hover:text-indigo-600 dark:hover:text-indigo-400">Releases</a>
                <span>/</span>
                <span class="text-slate-700 dark:text-slate-200 font-bold">v{version}</span>
            </nav>

            <header class="soft-card p-5 sm:p-6 rounded-3xl space-y-4">
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                    <div class="space-y-1">
                        <div class="flex items-center gap-2.5 flex-wrap">
                            <h1 class="text-2xl sm:text-3xl font-black mono text-slate-900 dark:text-white tracking-tight">
                                AWS Boto3 v{version}
                            </h1>
                            <span class="px-2.5 py-0.5 rounded-full bg-indigo-500/10 text-indigo-700 dark:text-indigo-300 text-xs mono font-bold">
                                <span x-text="allChanges.length || totalChanges">{totalChanges}</span> updates
                            </span>
                        </div>
                        {date && (
                            <p class="text-xs sm:text-sm mono text-slate-500 dark:text-slate-400">
                                Released on <time datetime={date}>{formatDate(date)}</time> ({date})
                            </p>
                        )}
                    </div>

                    <div class="flex items-center gap-2 p-1.5 pl-3 bg-slate-100 dark:bg-white/[0.04] rounded-xl border border-black/[0.04] dark:border-white/[0.06] mono text-xs self-start sm:self-auto">
                        <span class="text-slate-500 select-none">$</span>
                        <code class="text-indigo-600 dark:text-indigo-400 font-semibold select-all">pip install boto3=={version}</code>
                    </div>
                </div>
            </header>

            <section aria-label="Services in this release" class="soft-card rounded-2xl p-4 sm:p-5 space-y-3 w-full max-w-full min-w-0">
                <div class="flex items-center justify-between gap-2 flex-wrap w-full max-w-full min-w-0">
                    <div class="flex items-center justify-between sm:justify-start gap-2 w-full sm:w-auto max-w-full min-w-0 flex-wrap">
                        <h2 class="text-xs font-bold uppercase tracking-wider text-slate-800 dark:text-slate-200 mono flex items-center gap-2 shrink-0">
                            <span class="w-1.5 h-1.5 rounded-full bg-indigo-500 shrink-0"></span>
                            <span>Services</span>
                        </h2>
                        <span class="px-2 py-0.5 rounded-full bg-slate-200/50 dark:bg-white/10 text-[9.5px] mono font-bold text-slate-600 dark:text-slate-400 shrink-0 whitespace-nowrap"
                              x-text="(servicesList.length || servicesModified.length) + ' services'">
                            {servicesModified.length} services
                        </span>
                    </div>

                    <template x-if="releaseServiceFilter">
                        <div class="flex items-center gap-2 text-xs flex-wrap w-full sm:w-auto max-w-full min-w-0 pt-1 sm:pt-0">
                            <span class="text-slate-500 text-[11px] shrink-0">Filtered to:</span>
                            <span class="px-2.5 py-0.5 rounded-full bg-indigo-600 text-white font-bold mono uppercase text-[9.5px] shrink-0" x-text="releaseServiceFilter"></span>
                            <button @click="releaseServiceFilter = ''" class="text-slate-400 hover:text-rose-500 text-[10.5px] font-bold cursor-pointer shrink-0" title="Clear service filter">✕ Clear</button>
                            <a :href="'/services/' + (releaseServiceFilter || '').toLowerCase() + '/'" class="text-indigo-600 dark:text-indigo-400 font-bold hover:underline text-[11px] mono cursor-pointer truncate max-w-[200px] sm:max-w-none">
                                Explore all <span class="uppercase" x-text="releaseServiceFilter"></span> updates &rarr;
                            </a>
                        </div>
                    </template>
                </div>

                <div class="flex items-center gap-1.5 flex-wrap pt-0.5 w-full max-w-full min-w-0">
                    <div x-show="!hasActiveFilter" class="flex items-center gap-1.5 flex-wrap">
                        {servicesModified.map(svc => (
                            <a href={`/services/${slugifyService(svc)}/`} 
                               title={`View all ${svc} changelog history`}
                               class={`inline-flex items-center gap-1 px-2.5 py-1 rounded-lg text-[10px] mono font-bold uppercase transition-all hover:scale-105 active:scale-95 ${getServiceColorClass(svc)}`}>
                                <span>{svc}</span>
                            </a>
                        ))}
                    </div>

                    <div x-show="hasActiveFilter" x-cloak class="flex items-center gap-1.5 flex-wrap">
                        <template x-for="svc in servicesList" :key="svc">
                            <a :href="'/services/' + (svc || '').toLowerCase() + '/'"
                               :class="getServiceColorClass(svc)"
                               :title="'View all ' + svc.toUpperCase() + ' changelog history'"
                               class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg text-[10px] mono font-bold uppercase transition-all hover:scale-105 active:scale-95 cursor-pointer max-w-full">
                                <span class="truncate max-w-[200px] sm:max-w-none" x-text="svc"></span>
                            </a>
                        </template>
                    </div>
                </div>
            </section>

            <div class="soft-card p-2.5 sm:p-3 rounded-2xl flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-2.5">
                <div class="relative flex-1 group">
                    <input type="text" 
                           x-model.debounce.150ms="search" 
                           placeholder={`Filter changes in this release (e.g. s3, ami, fix)...`} 
                           aria-label={`Filter updates in v${version}`}
                           class="w-full glass-input rounded-xl py-1.5 pl-8 pr-7 text-[11px] focus:outline-none text-slate-900 dark:text-white placeholder:text-slate-400 font-medium transition-all" />
                    <svg class="absolute left-2.5 top-[8px] w-3.5 h-3.5 text-slate-400 group-focus-within:text-indigo-500 transition-colors pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
                    <button x-show="search" @click="search = ''" aria-label="Clear filter" class="absolute right-2 top-[7px] text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 p-0.5 cursor-pointer">
                        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                    </button>
                </div>

                <div class="flex items-center gap-1 p-0.5 glass-segmented rounded-xl mono text-[9.5px] shrink-0">
                    <button @click="activeFilter = 'all'" 
                            :class="activeFilter === 'all' ? 'bg-white dark:bg-white/10 text-indigo-600 dark:text-indigo-400 font-bold shadow-xs' : 'text-slate-500 hover:text-slate-900 dark:hover:text-white'"
                            class="px-2.5 py-1 rounded-lg uppercase transition-all cursor-pointer">
                        All (<span x-text="versionCounts.total">{totalChanges}</span>)
                    </button>
                    <button @click="activeFilter = 'feature'" 
                            :class="activeFilter === 'feature' ? 'bg-white dark:bg-white/10 text-emerald-600 dark:text-emerald-400 font-bold shadow-xs' : 'text-slate-500 hover:text-slate-900 dark:hover:text-white'"
                            class="px-2.5 py-1 rounded-lg uppercase transition-all cursor-pointer">
                        Features (<span x-text="versionCounts.features"></span>)
                    </button>
                    <button @click="activeFilter = 'fix'" 
                            :class="activeFilter === 'fix' ? 'bg-white dark:bg-white/10 text-rose-600 dark:text-rose-400 font-bold shadow-xs' : 'text-slate-500 hover:text-slate-900 dark:hover:text-white'"
                            class="px-2.5 py-1 rounded-lg uppercase transition-all cursor-pointer">
                        Fixes (<span x-text="versionCounts.fixes"></span>)
                    </button>
                </div>
            </div>

            <section aria-label={`Changelog entries in v${version}`} class="space-y-3">
                <div x-show="!hasActiveFilter" class="space-y-3" id="ssr-changelog-stream">
                    {changes.map((change) => {
                        const isFix = change.type.toLowerCase().includes('fix');
                        const isEnhan = change.type.toLowerCase().includes('enhan');
                        const isFeature = change.type.toLowerCase().includes('feature') || change.type.toLowerCase().includes('api');
                        return (
                            <article class="soft-card rounded-2xl p-4 sm:p-5 group">
                                <div class="flex items-center justify-between gap-2 mb-2.5 flex-wrap">
                                    <div class="flex items-center gap-2 flex-wrap min-w-0">
                                        <a href={`/services/${slugifyService(change.category)}/`} 
                                           title={`Explore all ${change.category} updates`}
                                           class={`inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[10px] mono font-bold uppercase tracking-wider transition-all hover:scale-105 active:scale-95 ${getServiceColorClass(change.category)}`}>
                                            <span>{change.category}</span>
                                        </a>
                                        <div class={`flex items-center gap-1.5 px-2 py-0.5 rounded-full text-[9px] mono font-bold uppercase tracking-wider ${isFix ? 'text-rose-600 dark:text-rose-400 bg-rose-500/10' : (isEnhan ? 'text-blue-600 dark:text-blue-400 bg-blue-500/10' : (isFeature ? 'text-emerald-600 dark:text-emerald-400 bg-emerald-500/10' : 'text-slate-600 dark:text-slate-400 bg-slate-500/10'))}`}>
                                            <span class={`w-1.5 h-1.5 rounded-full ${isFix ? 'bg-rose-500' : (isEnhan ? 'bg-blue-500' : (isFeature ? 'bg-emerald-500' : 'bg-slate-500'))}`}></span>
                                            <span>{change.type.includes('api') ? 'API Change' : change.type}</span>
                                        </div>
                                    </div>
                                </div>
                                <p class="text-slate-700 dark:text-slate-200 leading-relaxed text-[13.5px] sm:text-[14px] font-normal break-words" set:html={formatDescription(change.description)}></p>
                            </article>
                        );
                    })}
                </div>

                <div x-show="hasActiveFilter" x-cloak class="space-y-3">
                    <template x-if="isLoading">
                        <div class="py-16 text-center soft-card rounded-2xl p-6 space-y-3">
                            <div class="w-8 h-8 border-2 border-indigo-600 border-t-transparent rounded-full animate-spin mx-auto"></div>
                            <p class="text-xs mono text-slate-400">Loading changelog updates...</p>
                        </div>
                    </template>

                    <template x-for="(change, idx) in filteredChanges" :key="change.category + '-' + change.type + '-' + change.description">
                        <article class="soft-card rounded-2xl p-4 sm:p-5 group">
                            <div class="flex items-center justify-between gap-2 mb-2.5 flex-wrap">
                                <div class="flex items-center gap-2 flex-wrap">
                                    <a :href="'/services/' + (change.category || '').toLowerCase().trim() + '/'" 
                                       :title="'View all ' + change.category.toUpperCase() + ' updates'"
                                       :class="getServiceColorClass(change.category)"
                                       class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[10px] mono font-bold uppercase tracking-wider transition-all hover:scale-105 active:scale-95 cursor-pointer">
                                        <span x-html="highlight(change.category, search)"></span>
                                    </a>

                                    <div :class="{
                                        'text-rose-600 dark:text-rose-400 bg-rose-500/10': change.type.toLowerCase().includes('fix'),
                                        'text-blue-600 dark:text-blue-400 bg-blue-500/10': change.type.toLowerCase().includes('enhan'),
                                        'text-emerald-600 dark:text-emerald-400 bg-emerald-500/10': change.type.toLowerCase().includes('feature') || change.type.toLowerCase().includes('api'),
                                        'text-slate-600 dark:text-slate-400 bg-slate-500/10': !['fix', 'enhan', 'feature', 'api'].some(t => change.type.toLowerCase().includes(t))
                                    }" class="flex items-center gap-1.5 px-2 py-0.5 rounded-full text-[9px] mono font-bold uppercase tracking-wider">
                                        <span :class="{
                                            'bg-rose-500': change.type.toLowerCase().includes('fix'),
                                            'bg-blue-500': change.type.toLowerCase().includes('enhan'),
                                            'bg-emerald-500': change.type.toLowerCase().includes('feature') || change.type.toLowerCase().includes('api'),
                                            'bg-slate-500': !['fix', 'enhan', 'feature', 'api'].some(t => change.type.toLowerCase().includes(t))
                                        }" class="w-1.5 h-1.5 rounded-full"></span>
                                        <span x-text="change.type.includes('api') ? 'API Change' : change.type"></span>
                                    </div>
                                </div>

                                <button @click="copyItem(change, idx)"
                                        title="Copy change entry"
                                        class="p-1 rounded-lg text-slate-400 hover:text-indigo-600 dark:hover:text-indigo-400 hover:bg-slate-100 dark:hover:bg-white/10 transition-colors cursor-pointer">
                                    <svg x-show="copiedIdx !== idx" class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path></svg>
                                    <svg x-show="copiedIdx === idx" x-cloak class="w-3.5 h-3.5 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path></svg>
                                </button>
                            </div>
                            <p class="text-slate-700 dark:text-slate-200 leading-relaxed text-[13.5px] sm:text-[14px] font-normal break-words" x-html="formatDescription(change.description, search)"></p>
                        </article>
                    </template>

                    <template x-if="!isLoading && allChanges.length > 0 && filteredChanges.length === 0">
                        <div class="py-16 text-center soft-card rounded-2xl p-6">
                            <h3 class="text-sm font-bold uppercase tracking-wider text-slate-800 dark:text-slate-200">No Matches Found</h3>
                            <p class="text-xs text-slate-400 mt-1">No updates match your filter criteria.</p>
                            <button @click="search = ''; activeFilter = 'all'; releaseServiceFilter = ''" class="mt-4 px-4 py-1.5 rounded-full bg-indigo-600 text-white text-xs font-bold cursor-pointer hover:bg-indigo-700 transition-colors">
                                Reset Filters
                            </button>
                        </div>
                    </template>

                    <template x-if="!isLoading && allChanges.length === 0">
                        <div class="py-16 text-center soft-card rounded-2xl p-6">
                            <h3 class="text-sm font-bold uppercase tracking-wider text-slate-800 dark:text-slate-200">No Changelog Available</h3>
                            <p class="text-xs text-slate-400 mt-1">No updates were recorded for release v<span x-text="currentVersion"></span>.</p>
                            <a href="/releases/" class="inline-block mt-4 px-4 py-1.5 rounded-full bg-indigo-600 text-white text-xs font-bold">
                                Browse All Releases &rarr;
                            </a>
                        </div>
                    </template>
                </div>
            </section>
        </main>

        <footer class="mt-auto py-8 px-4 sm:px-6 border-t border-black/[0.04] dark:border-white/[0.06] bg-transparent">
            <div class="max-w-5xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-4 text-xs font-mono">
                <div class="flex items-center gap-2">
                    <img src="/favicon.svg" width="18" height="18" alt="BotoView" class="w-4 h-4 opacity-80" />
                    <span class="font-bold text-slate-700 dark:text-slate-300">BotoView</span>
                    <span class="text-slate-400">by <a href="https://5goos.com/" target="_blank" rel="noopener noreferrer" class="hover:text-indigo-600 dark:hover:text-indigo-400 font-semibold underline decoration-slate-300 dark:decoration-slate-700 underline-offset-2">5goos</a></span>
                    <span class="text-slate-400">&copy; {new Date().getFullYear()}</span>
                </div>
                <div class="flex items-center gap-4 text-slate-500">
                    <a href="/" class="hover:text-indigo-600 dark:hover:text-indigo-400">Timeline Explorer</a>
                    <a href="/services/" class="hover:text-indigo-600 dark:hover:text-indigo-400">Services</a>
                    <a href="/releases/" class="hover:text-indigo-600 dark:hover:text-indigo-400">Releases</a>
                    <a href="https://github.com/5goos/botoview" target="_blank" rel="noopener noreferrer" class="hover:text-indigo-600 dark:hover:text-indigo-400">GitHub</a>
                </div>
            </div>
        </footer>
    </div>
</Layout>

<script define:vars={{ initialChangesJson: changes, currentVersion: version, totalChanges, newerVersion, olderVersion }}>
    const colorPalette = [
        'bg-indigo-500/10 text-indigo-700 dark:text-indigo-300 hover:bg-indigo-500/15',
        'bg-sky-500/10 text-sky-700 dark:text-sky-300 hover:bg-sky-500/15',
        'bg-emerald-500/10 text-emerald-700 dark:text-emerald-300 hover:bg-emerald-500/15',
        'bg-violet-500/10 text-violet-700 dark:text-violet-300 hover:bg-violet-500/15',
        'bg-rose-500/10 text-rose-700 dark:text-rose-300 hover:bg-rose-500/15',
        'bg-amber-500/10 text-amber-700 dark:text-amber-300 hover:bg-amber-500/15',
        'bg-cyan-500/10 text-cyan-700 dark:text-cyan-300 hover:bg-cyan-500/15',
        'bg-teal-500/10 text-teal-700 dark:text-teal-300 hover:bg-teal-500/15'
    ];

    function getServiceColor(name) {
        if (!name) return 'bg-slate-500/10 text-slate-700 dark:text-slate-300';
        let hash = 0;
        for (let i = 0; i < name.length; i++) {
            hash = name.charCodeAt(i) + ((hash << 5) - hash);
        }
        return colorPalette[Math.abs(hash) % colorPalette.length];
    }

    function releasePageData() {
        return {
            isClientHydrated: true,
            isHydrated: true,
            isLoading: false,
            isDarkMode: false,
            search: '',
            activeFilter: 'all',
            releaseServiceFilter: '',
            copiedIdx: null,
            currentVersion,
            newerVersion,
            olderVersion,
            totalChanges,
            allChanges: initialChangesJson || [],
            _serviceColorCache: {},

            get hasActiveFilter() {
                return Boolean((this.search && this.search.trim()) || this.activeFilter !== 'all' || this.releaseServiceFilter);
            },

            async init() {
                this.isDarkMode = document.documentElement.classList.contains('dark');
                if (!this.allChanges || this.allChanges.length === 0) {
                    this.isLoading = true;
                    try {
                        const res = await fetch(`/data/versions/${this.currentVersion}.json`);
                        if (res.ok) {
                            this.allChanges = await res.json();
                        }
                    } catch (e) {
                    } finally {
                        this.isLoading = false;
                    }
                }
            },

            toggleTheme() {
                this.isDarkMode = !this.isDarkMode;
                document.documentElement.classList.toggle('dark', this.isDarkMode);
                try {
                    localStorage.setItem('theme', this.isDarkMode ? 'dark' : 'light');
                } catch (e) {}
            },

            handleKeydown(e) {
                const isInput = ['INPUT', 'TEXTAREA', 'SELECT'].includes(e.target.tagName);
                if (!isInput) {
                    if (e.key === '/') {
                        e.preventDefault();
                        document.querySelector('input[type="text"]')?.focus();
                    } else if (e.key === 't' || e.key === 'T') {
                        e.preventDefault();
                        this.toggleTheme();
                    } else if (e.key === 'j' && this.olderVersion) {
                        window.location.href = `/releases/${this.olderVersion}/`;
                    } else if (e.key === 'k' && this.newerVersion) {
                        window.location.href = `/releases/${this.newerVersion}/`;
                    }
                } else {
                    if (e.key === 'Escape') {
                        e.target.blur();
                        if (this.search) this.search = '';
                    }
                }
            },

            get servicesList() {
                const s = new Set();
                for (const c of this.allChanges) {
                    if (c && c.category) s.add(c.category.toLowerCase().trim());
                }
                return Array.from(s).sort();
            },

            get versionCounts() {
                let features = 0;
                let fixes = 0;
                for (const c of this.allChanges) {
                    if (c && c.type && c.type.toLowerCase().includes('fix')) {
                        fixes++;
                    } else {
                        features++;
                    }
                }
                return {
                    total: this.allChanges.length,
                    features,
                    fixes
                };
            },

            getServiceColorClass(serviceName) {
                if (!serviceName) return 'bg-slate-500/10 text-slate-700 dark:text-slate-300';
                if (this._serviceColorCache[serviceName]) return this._serviceColorCache[serviceName];
                const result = getServiceColor(serviceName);
                this._serviceColorCache[serviceName] = result;
                return result;
            },

            getServiceColor(name) {
                return this.getServiceColorClass(name);
            },

            toggleReleaseServiceFilter(svc) {
                const s = (svc || '').toLowerCase().trim();
                if (this.releaseServiceFilter.toLowerCase().trim() === s) {
                    this.releaseServiceFilter = '';
                } else {
                    this.releaseServiceFilter = s;
                }
            },

            get filteredChanges() {
                let list = this.allChanges;
                if (this.activeFilter === 'feature') {
                    list = list.filter(c => !(c.type && c.type.toLowerCase().includes('fix')));
                } else if (this.activeFilter === 'fix') {
                    list = list.filter(c => c.type && c.type.toLowerCase().includes('fix'));
                }

                if (this.releaseServiceFilter) {
                    const s = this.releaseServiceFilter.toLowerCase().trim();
                    list = list.filter(c => c.category && c.category.toLowerCase().trim() === s);
                }

                if (this.search && this.search.trim()) {
                    const s = this.search.trim().toLowerCase();
                    list = list.filter(c => 
                        (c.category && c.category.toLowerCase().includes(s)) ||
                        (c.description && c.description.toLowerCase().includes(s))
                    );
                }
                return list;
            },

            escapeHtml(str) {
                if (!str) return '';
                return String(str)
                    .replace(/&/g, '&amp;')
                    .replace(/</g, '&lt;')
                    .replace(/>/g, '&gt;')
                    .replace(/"/g, '&quot;')
                    .replace(/'/g, '&#39;');
            },

            highlight(text, search) {
                if (!text) return '';
                let escaped = this.escapeHtml(text);
                if (!search || !search.trim()) return escaped;
                const s = search.trim();
                const regex = new RegExp(`(${s.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')})`, 'gi');
                return escaped.replace(regex, '<mark class="search-highlight">$1</mark>');
            },

            formatDescription(text, search) {
                if (!text) return '';
                let formatted = this.escapeHtml(text);

                formatted = formatted.replace(
                    /`([^`]+?)\s*&lt;(https?:\/\/[^&>]+?)&gt;`_+/g,
                    '<a href="$2" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-0.5 text-indigo-600 dark:text-indigo-400 hover:text-indigo-700 dark:hover:text-indigo-300 font-semibold underline decoration-indigo-400/40 hover:decoration-indigo-500 transition-colors">$1<svg class="w-2.5 h-2.5 opacity-70 inline ml-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg></a>'
                );

                formatted = formatted.replace(
                    /``([^`]+?)``/g,
                    '<code class="px-1.5 py-0.5 rounded-md bg-slate-200/50 dark:bg-white/10 text-[11px] mono text-indigo-700 dark:text-indigo-300 font-medium">$1</code>'
                );

                formatted = formatted.replace(
                    /`([^`]+?)`/g,
                    '<code class="px-1.5 py-0.5 rounded-md bg-slate-200/50 dark:bg-white/10 text-[11px] mono text-indigo-700 dark:text-indigo-300 font-medium">$1</code>'
                );

                formatted = formatted.replace(
                    /(^|[^"'])(https?:\/\/[a-zA-Z0-9\-\._~:\/\?#\[\]@!$&'()*+,;=%]+)/g,
                    '$1<a href="$2" target="_blank" rel="noopener noreferrer" class="text-indigo-600 dark:text-indigo-400 hover:underline font-medium break-all">$2</a>'
                );

                if (search && search.trim()) {
                    const s = search.trim();
                    const escapedSearch = s.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
                    const regex = new RegExp(`(?![^<]*>)(${escapedSearch})`, 'gi');
                    formatted = formatted.replace(regex, '<mark class="search-highlight">$1</mark>');
                }

                return formatted;
            },

            renderDescription(text, search) {
                return this.formatDescription(text, search);
            },

            async copyItem(item, idx) {
                try {
                    const text = `${(item.category || '').toUpperCase()}: ${item.description} (v${this.currentVersion})`;
                    await navigator.clipboard.writeText(text);
                    this.copiedIdx = idx;
                    setTimeout(() => {
                        if (this.copiedIdx === idx) this.copiedIdx = null;
                    }, 2000);
                } catch(e) {}
            }
        };
    }

    window.releasePageData = releasePageData;

    if (window.Alpine) {
        window.Alpine.data('releasePage', releasePageData);
    } else {
        document.addEventListener('alpine:init', () => {
            window.Alpine.data('releasePage', releasePageData);
        });
    }

    document.addEventListener('DOMContentLoaded', () => {
        if (window.Alpine) {
            window.Alpine.data('releasePage', releasePageData);
        }
    });
</script>
