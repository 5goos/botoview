---
export const prerender = true;

import Layout from '../layouts/Layout.astro';
import { getServiceColorClass } from '../utils/formatting';

const popularServices = [
    's3', 'bedrock', 'dynamodb', 'lambda', 'ec2',
    'iam', 'cloudwatch', 'sqs', 'rds', 'secretsmanager',
    'kms', 'sagemaker', 'ecs', 'eks'
];

const pageTitle = "404 — Page Not Found | BotoView";
const pageDescription = "The requested AWS Boto3 release or service changelog could not be found. Search 580+ AWS services or explore all Boto3 releases.";
const canonicalUrl = "https://botoview.5goos.com/404/";
---

<Layout
    title={pageTitle}
    description={pageDescription}
    canonical={canonicalUrl}
    robots="noindex, nofollow"
    includeDefaultApp={false}
    bodyClass="min-h-screen w-full overflow-y-auto text-[var(--text-secondary)] transition-colors duration-200"
>
    <div class="min-h-screen flex flex-col bg-transparent relative"
         x-data="notFoundPage"
         @scroll.window="isScrolled = window.scrollY > 10"
         @boto:theme-changed.window="isDarkMode = $event.detail.isDark">
        <div class="pointer-events-none fixed inset-0 z-0 ambient-glow" aria-hidden="true"></div>

        <header class="h-14 glass-header sticky top-0 z-40 flex items-center transition-all duration-200" :class="isScrolled ? 'glass-header-scrolled' : ''">
            <div class="w-full max-w-5xl mx-auto px-4 sm:px-6 flex items-center justify-between gap-2 min-w-0">
                <div class="flex items-center gap-2 sm:gap-3 min-w-0">
                    <a href="/" class="flex items-center gap-2 group cursor-pointer shrink-0" aria-label="BotoView Home">
                        <img src="/favicon.svg" width="22" height="22" alt="BotoView logo" class="w-5 h-5 group-hover:scale-105 transition-transform" />
                        <span class="text-[15px] font-semibold tracking-tight text-slate-900 dark:text-slate-100 leading-none">BotoView</span>
                    </a>
                    <span class="text-slate-300 dark:text-white/10 hidden sm:inline">/</span>
                    <span class="text-xs mono font-semibold uppercase text-rose-600 dark:text-rose-400 truncate">
                        404 Not Found
                    </span>
                </div>

                <div class="flex items-center gap-1 sm:gap-1.5 shrink-0">
                    <button type="button"
                            @click="openPalette()"
                            aria-label="Open command search (Cmd/Ctrl+K)"
                            title="Quick jump (Cmd/Ctrl + K)"
                            class="inline-flex items-center gap-1.5 px-2.5 py-1.5 rounded-full text-xs font-medium text-slate-600 dark:text-slate-300 bg-black/[0.04] dark:bg-white/[0.06] hover:bg-black/[0.08] dark:hover:bg-white/[0.1] transition-colors cursor-pointer shrink-0 min-h-[40px] sm:min-h-0">
                        <svg class="w-3.5 h-3.5 text-slate-500 dark:text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
                        <kbd class="kbd-badge hidden sm:inline-flex">⌘K</kbd>
                    </button>

                    <a href="/"
                       class="inline-flex items-center gap-1.5 px-2.5 sm:px-3.5 py-1.5 bg-indigo-600 hover:bg-indigo-700 text-white rounded-full text-xs font-semibold transition-all active:scale-95 shadow-sm shadow-indigo-500/25 shrink-0">
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
                        <span class="hidden sm:inline">Timeline Explorer</span>
                        <span class="sm:hidden text-[11px]">Timeline</span>
                    </a>

                    <button type="button"
                            @click="toggleTheme()"
                            aria-label="Toggle dark mode"
                            class="rounded-full text-slate-500 hover:text-slate-900 dark:text-slate-400 dark:hover:text-slate-100 hover:bg-black/[0.04] dark:hover:bg-white/[0.07] transition-all cursor-pointer shrink-0 tap-target flex items-center justify-center">
                        <svg x-show="!isDarkMode" x-cloak class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path></svg>
                        <svg x-show="isDarkMode" class="w-4 h-4 text-amber-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path></svg>
                    </button>

                    <a href="https://github.com/5goos/botoview" target="_blank" rel="noopener noreferrer" aria-label="GitHub repository" class="hidden sm:flex rounded-full text-slate-500 hover:text-slate-900 dark:text-slate-400 dark:hover:text-slate-100 hover:bg-black/[0.04] dark:hover:bg-white/[0.07] transition-all shrink-0 tap-target items-center justify-center">
                        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
                    </a>
                </div>
            </div>
        </header>

        <main id="mainScrollArea" tabindex="-1" class="relative z-10 flex-1 max-w-5xl w-full mx-auto px-4 sm:px-6 py-8 sm:py-14 space-y-6 min-w-0">
            <div class="soft-card p-6 sm:p-10 rounded-2xl text-center space-y-5">
                <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-rose-500/10 text-rose-600 dark:text-rose-400 text-xs mono font-semibold uppercase tracking-wider">
                    <span class="w-1.5 h-1.5 rounded-full bg-rose-500 animate-pulse"></span>
                    <span>HTTP 404 • Resource Not Found</span>
                </div>

                <div class="space-y-2 max-w-xl mx-auto">
                    <h1 class="text-3xl sm:text-4xl font-bold mono text-slate-900 dark:text-white tracking-tight">
                        Changelog Not Located
                    </h1>
                    <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 leading-relaxed font-medium">
                        The requested AWS Boto3 release, service directory, or page could not be found. It may have been moved, renamed, or not yet indexed.
                    </p>
                </div>

                <div class="max-w-md mx-auto pt-2">
                    <form @submit.prevent="handleQuickSearch()" class="relative flex items-center">
                        <input type="text"
                               x-model="quickQuery"
                               placeholder="Jump to service (bedrock, s3) or release (1.44.12)..."
                               aria-label="Quick jump to service or release"
                               class="w-full glass-input rounded-2xl py-2.5 pl-10 pr-20 text-xs focus:outline-none text-slate-900 dark:text-white placeholder:text-slate-400 font-medium transition-all" />
                        <svg class="absolute left-3.5 top-[11px] w-4 h-4 text-slate-400 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
                        <button type="submit"
                                class="absolute right-1.5 px-3 py-1.5 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-semibold transition-all active:scale-95 shadow-xs cursor-pointer">
                            Jump &rarr;
                        </button>
                    </form>
                </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                <a href="/" class="changelog-card p-5 rounded-2xl space-y-2 group block transition-all">
                    <div class="w-9 h-9 rounded-xl bg-indigo-500/12 text-indigo-600 dark:text-indigo-400 flex items-center justify-center group-hover:scale-105 transition-transform">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
                    </div>
                    <h2 class="text-sm font-bold text-slate-900 dark:text-white">Interactive Explorer</h2>
                    <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed">
                        Filter, compare, and search all Boto3 updates in the release and service timeline explorer.
                    </p>
                </a>

                <a href="/services/" class="changelog-card p-5 rounded-2xl space-y-2 group block transition-all">
                    <div class="w-9 h-9 rounded-xl bg-violet-500/12 text-violet-600 dark:text-violet-400 flex items-center justify-center group-hover:scale-105 transition-transform">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path></svg>
                    </div>
                    <h2 class="text-sm font-bold text-slate-900 dark:text-white">Services Directory</h2>
                    <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed">
                        Browse individual changelog pages for 580+ AWS SDK services from A to Z.
                    </p>
                </a>

                <a href="/releases/" class="changelog-card p-5 rounded-2xl space-y-2 group block transition-all">
                    <div class="w-9 h-9 rounded-xl bg-emerald-500/12 text-emerald-600 dark:text-emerald-400 flex items-center justify-center group-hover:scale-105 transition-transform">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                    </div>
                    <h2 class="text-sm font-bold text-slate-900 dark:text-white">Releases Archive</h2>
                    <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed">
                        Explore Boto3 release versions chronological history, release dates, and notes.
                    </p>
                </a>
            </div>

            <section class="soft-card p-5 sm:p-6 rounded-2xl space-y-3">
                <div class="flex items-center justify-between gap-2 flex-wrap">
                    <h2 class="text-xs font-bold uppercase tracking-wider text-slate-800 dark:text-slate-200 mono">
                        Popular AWS Services
                    </h2>
                    <a href="/services/" class="text-xs mono text-indigo-600 dark:text-indigo-400 font-bold hover:underline">
                        View All Services &rarr;
                    </a>
                </div>
                <div class="flex items-center gap-1.5 flex-wrap pt-1">
                    {popularServices.map((svc) => (
                        <a href={`/services/${svc}/`}
                           title={`View ${svc.toUpperCase()} changelog`}
                           class={`inline-flex items-center px-3 py-1.5 rounded-xl text-xs mono font-bold uppercase transition-all hover:scale-105 active:scale-95 ${getServiceColorClass(svc)}`}>
                            {svc}
                        </a>
                    ))}
                </div>
            </section>

            <div class="soft-card p-4 rounded-2xl flex flex-col sm:flex-row sm:items-center justify-between gap-3 text-xs min-w-0">
                <div class="flex items-center gap-2 flex-wrap min-w-0">
                    <span class="text-slate-500 font-mono select-none">$</span>
                    <span class="text-slate-600 dark:text-slate-400 font-medium">To update your AWS SDK installation:</span>
                    <code class="px-2 py-0.5 rounded bg-black/[0.04] dark:bg-white/[0.06] text-indigo-600 dark:text-indigo-400 mono font-semibold break-all">pip install --upgrade boto3</code>
                </div>
                <button type="button"
                        @click="copyPip()"
                        class="px-3 py-1.5 rounded-lg text-slate-500 hover:text-indigo-600 dark:hover:text-indigo-400 hover:bg-black/[0.04] dark:hover:bg-white/10 mono text-xs transition-colors self-start sm:self-auto cursor-pointer shrink-0">
                    <span x-show="!copied">Copy command</span>
                    <span x-show="copied" x-cloak class="text-emerald-600 dark:text-emerald-400 font-bold">Copied!</span>
                </button>
            </div>
        </main>

        <footer class="relative z-10 mt-auto py-8 px-4 sm:px-6 bg-transparent">
            <div class="max-w-5xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-4 text-xs font-mono">
                <div class="flex items-center gap-2">
                    <img src="/favicon.svg" width="18" height="18" alt="BotoView" class="w-4 h-4 opacity-80" />
                    <span class="font-bold text-slate-700 dark:text-slate-300">BotoView</span>
                    <span class="text-slate-500 dark:text-slate-400">by <a href="https://5goos.com/" target="_blank" rel="noopener noreferrer" class="hover:text-indigo-600 dark:hover:text-indigo-400 font-semibold underline decoration-slate-300 dark:decoration-slate-700 underline-offset-2">5goos</a></span>
                    <span class="text-slate-500 dark:text-slate-400">&copy; {new Date().getFullYear()}</span>
                </div>
                <div class="flex items-center gap-4 text-slate-500 dark:text-slate-400 flex-wrap justify-center">
                    <a href="/" class="hover:text-indigo-600 dark:hover:text-indigo-400">Timeline Explorer</a>
                    <a href="/services/" class="hover:text-indigo-600 dark:hover:text-indigo-400">Services</a>
                    <a href="/releases/" class="hover:text-indigo-600 dark:hover:text-indigo-400">Releases</a>
                    <a href="https://github.com/5goos/botoview" target="_blank" rel="noopener noreferrer" class="hover:text-indigo-600 dark:hover:text-indigo-400">GitHub</a>
                </div>
            </div>
        </footer>
    </div>
</Layout>

<script>
    import {
        copyToClipboardText,
        emitToast,
        openCommandPalette,
        registerAlpineComponent,
        slugifyService,
        toggleThemeState
    } from '../utils/client';

    registerAlpineComponent('notFoundPage', () => ({
        quickQuery: '',
        copied: false,
        isScrolled: false,
        isDarkMode: document.documentElement.classList.contains('dark'),

        toggleTheme() {
            this.isDarkMode = toggleThemeState();
        },

        openPalette() {
            openCommandPalette('');
        },

        handleQuickSearch() {
            const q = this.quickQuery.trim();
            if (!q) return;

            if (/^v?\d+\.\d+/.test(q)) {
                const cleanVer = q.replace(/^v/, '');
                window.location.href = `/releases/${cleanVer}/`;
            } else {
                window.location.href = `/services/${slugifyService(q)}/`;
            }
        },

        async copyPip() {
            const ok = await copyToClipboardText('pip install --upgrade boto3');
            if (ok) {
                this.copied = true;
                emitToast('Copied pip install --upgrade boto3');
                setTimeout(() => {
                    this.copied = false;
                }, 2000);
            }
        }
    }));
</script>
