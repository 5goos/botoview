---
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import {
    formatDate,
    formatDescription,
    getServiceColorClass,
    normalizeChangeType,
    trimDescription
} from '../../utils/formatting';
import { loadServiceUpdates, serviceModules, type ServiceUpdateItem } from '../../utils/data';
import { computeServiceTelemetry } from '../../utils/serviceTelemetry';
import trackData from '../../../public/data/track.json';

export async function getStaticPaths() {
    const versionDates: Record<string, string> = {};
    if (trackData && trackData.versions) {
        for (const v of trackData.versions) {
            if (v.id) versionDates[v.id] = v.date || '';
        }
    }

    return Object.entries(serviceModules).map(([pathKey, changes]) => {
        const match = pathKey.match(/\/([^/]+)\.json$/);
        const service = match ? match[1] : '';
        const list = Array.isArray(changes) ? changes : [];

        const scopedDates: Record<string, string> = {};
        for (const item of list) {
            if (item.v && versionDates[item.v]) {
                scopedDates[item.v] = versionDates[item.v];
            }
        }

        const latestVersion = list[0]?.v || '';
        const latestDate = versionDates[latestVersion] || '';

        return {
            params: { service },
            props: {
                service,
                changes: list,
                versionDates: scopedDates,
                latestVersion,
                latestDate,
                totalUpdates: list.length
            }
        };
    });
}

const service = Astro.props.service || Astro.params.service || '';

let versionDates: Record<string, string> = Astro.props.versionDates;
if (!versionDates && trackData?.versions) {
    versionDates = {};
    for (const v of trackData.versions) {
        if (v.id) versionDates[v.id] = v.date || '';
    }
}
versionDates = versionDates || {};

let changes: ServiceUpdateItem[] = Astro.props.changes;
if (!changes || changes.length === 0) {
    changes = loadServiceUpdates(service);
}
changes = changes || [];

const scopedVersionDates: Record<string, string> = {};
for (const c of changes) {
    if (c.v && versionDates[c.v]) {
        scopedVersionDates[c.v] = versionDates[c.v];
    }
}

const latestVersion = Astro.props.latestVersion || changes[0]?.v || '';
const latestDate = Astro.props.latestDate || scopedVersionDates[latestVersion] || '';
const totalUpdates = Astro.props.totalUpdates || changes.length;

const telemetry = computeServiceTelemetry(service, changes, scopedVersionDates);
const isIndexable = telemetry.isIndexable;
const robots = isIndexable ? "index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" : "noindex, follow";

const serviceUpper = service.toUpperCase();
const baseTitle = `AWS Boto3 ${serviceUpper} Changelog`;
const fullTitle = `${baseTitle} & SDK Telemetry | BotoView`;
let pageTitle = fullTitle;
if (pageTitle.length > 60) {
    pageTitle = `${baseTitle} | BotoView`;
}
if (pageTitle.length > 60) {
    pageTitle = `${serviceUpper} Changelog | BotoView`;
}
if (pageTitle.length > 60) {
    pageTitle = `${serviceUpper.slice(0, 45)}... | BotoView`;
}

const pageDescription = trimDescription(
    `AWS Boto3 SDK updates for ${serviceUpper}. Explore ${totalUpdates} changes (${telemetry.updates365d} in past year), API diff breakdowns, client quickstart, and release history.`,
    155
);
const canonicalUrl = `https://botoview.5goos.com/services/${service}/`;

const PAGE_SIZE = 30;
const initialSsrUpdates = changes.slice(0, PAGE_SIZE);
const popularServices = ['s3', 'bedrock', 'dynamodb', 'lambda', 'ec2', 'iam', 'cloudwatch', 'sqs', 'rds', 'secretsmanager'].filter((s) => s !== service);

let apiCount = 0;
let featureCount = 0;
let enhancementCount = 0;
let fixCount = 0;
for (const c of changes) {
    const key = normalizeChangeType('', c.t).key;
    if (key === 'api-change') apiCount++;
    else if (key === 'feature') featureCount++;
    else if (key === 'enhancement') enhancementCount++;
    else fixCount++;
}

const breadcrumbSchema = {
    "@type": "BreadcrumbList",
    "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://botoview.5goos.com/" },
        { "@type": "ListItem", "position": 2, "name": "Services", "item": "https://botoview.5goos.com/services/" },
        { "@type": "ListItem", "position": 3, "name": serviceUpper, "item": canonicalUrl }
    ]
};

const publishedDate = (changes.length > 0 && scopedVersionDates[changes[changes.length - 1]?.v]) || latestDate || "2020-01-01";

const serviceArticleSchema = {
    "@type": "TechArticle",
    "@id": `${canonicalUrl}#article`,
    "headline": `AWS Boto3 ${serviceUpper} Changelog & Release Notes`,
    "description": pageDescription,
    "url": canonicalUrl,
    "inLanguage": "en-US",
    "mainEntityOfPage": { "@type": "WebPage", "@id": canonicalUrl },
    "image": "https://botoview.5goos.com/og-image.png",
    "datePublished": publishedDate,
    "dateModified": latestDate || new Date().toISOString().split('T')[0],
    "author": { "@type": "Organization", "@id": "https://5goos.com/#organization", "name": "5goos", "url": "https://5goos.com/" },
    "publisher": {
        "@type": "Organization",
        "@id": "https://5goos.com/#organization",
        "name": "5goos",
        "url": "https://5goos.com/",
        "logo": { "@type": "ImageObject", "url": "https://botoview.5goos.com/favicon.png" }
    }
};

const serviceFaqSchema = {
    "@type": "FAQPage",
    "mainEntity": [
        {
            "@type": "Question",
            "name": `What is the latest update for AWS ${serviceUpper} in Boto3?`,
            "acceptedAnswer": {
                "@type": "Answer",
                "text": changes[0]
                    ? `The latest update for ${serviceUpper} was added in Boto3 release ${changes[0].v}: ${changes[0].t}`
                    : `No recent changes logged for ${serviceUpper}.`
            }
        },
        {
            "@type": "Question",
            "name": `How do I filter Boto3 release notes for ${serviceUpper}?`,
            "acceptedAnswer": {
                "@type": "Answer",
                "text": `Use BotoView at https://botoview.5goos.com/?s=${service} to search, filter, and compare all ${serviceUpper} SDK changes across Boto3 and Botocore.`
            }
        },
        {
            "@type": "Question",
            "name": `How do I install the latest Boto3 with ${serviceUpper} support?`,
            "acceptedAnswer": {
                "@type": "Answer",
                "text": `Upgrade your Python Boto3 library using pip: pip install --upgrade boto3`
            }
        }
    ]
};

const softwareAppSchema = {
    "@type": "SoftwareApplication",
    "@id": `${canonicalUrl}#software`,
    "name": `AWS Boto3 ${serviceUpper} SDK`,
    "applicationCategory": "DeveloperApplication",
    "operatingSystem": "Python / Cross-platform",
    "softwareVersion": latestVersion || trackData?.versions?.[0]?.id || "latest",
    "dateModified": latestDate || new Date().toISOString().split('T')[0],
    "author": { "@type": "Organization", "name": "Amazon Web Services" },
    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
};
---

<Layout
    title={pageTitle}
    description={pageDescription}
    canonical={canonicalUrl}
    robots={robots}
    includeDefaultApp={false}
    bodyClass="min-h-screen w-full overflow-y-auto text-[var(--text-secondary)] transition-colors duration-200"
    jsonLd={[breadcrumbSchema, serviceArticleSchema, softwareAppSchema, serviceFaqSchema]}
>
    <div class="min-h-screen flex flex-col bg-transparent relative"
         x-data="servicePage"
         @scroll.window="isScrolled = window.scrollY > 10"
         @boto:theme-changed.window="isDarkMode = $event.detail.isDark"
         @keydown.window="handleKeydown($event)">
        <div class="pointer-events-none fixed inset-0 z-0 ambient-glow" aria-hidden="true"></div>

        <header class="h-14 glass-header sticky top-0 z-40 flex items-center transition-all duration-200" :class="isScrolled ? 'glass-header-scrolled' : ''">
            <div class="w-full max-w-5xl mx-auto px-3 sm:px-6 flex items-center justify-between gap-2 min-w-0">
                <div class="flex items-center gap-1.5 sm:gap-2.5 min-w-0">
                    <a href="/" class="flex items-center gap-2 group cursor-pointer shrink-0" aria-label="BotoView Home">
                        <img src="/favicon.svg" width="22" height="22" alt="BotoView logo" class="w-5 h-5 group-hover:scale-105 transition-transform" />
                        <span class="text-[15px] font-semibold tracking-tight text-slate-900 dark:text-slate-100 leading-none">BotoView</span>
                    </a>
                    <span class="text-slate-300 dark:text-white/10 hidden sm:inline">/</span>
                    <a href="/services/" class="hidden sm:inline text-xs mono font-semibold uppercase tracking-wider text-slate-500 hover:text-indigo-600 dark:text-slate-400 dark:hover:text-indigo-400 transition-colors">
                        Services
                    </a>
                    <span class="text-slate-300 dark:text-white/10">/</span>
                    <span class="text-xs mono font-bold uppercase text-indigo-600 dark:text-indigo-400 truncate max-w-[100px] sm:max-w-none">
                        {service}
                    </span>
                </div>

                <div class="flex items-center gap-1 sm:gap-1.5 shrink-0">
                    <button type="button"
                            @click="openPalette()"
                            aria-label="Open command search (Cmd/Ctrl+K)"
                            title="Quick jump (Cmd/Ctrl + K)"
                            class="inline-flex items-center gap-1.5 px-2.5 py-1.5 rounded-full text-xs font-medium text-slate-600 dark:text-slate-300 bg-black/[0.04] dark:bg-white/[0.06] hover:bg-black/[0.08] dark:hover:bg-white/[0.1] transition-colors cursor-pointer shrink-0 min-h-[40px] sm:min-h-0">
                        <svg class="w-3.5 h-3.5 text-slate-500 dark:text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
                        <kbd class="kbd-badge hidden sm:inline-flex">⌘K</kbd>
                    </button>

                    <a href={`/?s=${service}`}
                       title="Open this service in interactive explorer"
                       class="inline-flex items-center gap-1 px-2.5 sm:px-3.5 py-1.5 bg-indigo-600 hover:bg-indigo-700 text-white rounded-full text-xs font-semibold transition-all active:scale-95 shadow-sm shadow-indigo-500/25 shrink-0">
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
                        <span class="hidden sm:inline">Explorer</span>
                        <span class="sm:hidden text-[11px]">App</span>
                    </a>

                    <button type="button"
                            @click="toggleTheme()"
                            aria-label="Toggle dark mode"
                            title="Toggle dark / light theme (t)"
                            class="rounded-full text-slate-500 hover:text-slate-900 dark:text-slate-400 dark:hover:text-slate-100 hover:bg-black/[0.04] dark:hover:bg-white/[0.07] transition-colors cursor-pointer shrink-0 tap-target flex items-center justify-center">
                        <svg x-show="!isDarkMode" x-cloak class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.9" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path></svg>
                        <svg x-show="isDarkMode" class="w-4 h-4 text-amber-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.9" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path></svg>
                    </button>

                    <a href="https://github.com/5goos/botoview" target="_blank" rel="noopener noreferrer" aria-label="GitHub repository" class="hidden sm:flex rounded-full text-slate-500 hover:text-slate-900 dark:text-slate-400 dark:hover:text-slate-100 hover:bg-black/[0.04] dark:hover:bg-white/[0.07] transition-colors shrink-0 tap-target items-center justify-center">
                        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
                    </a>
                </div>
            </div>
        </header>

        <main id="mainScrollArea" tabindex="-1" class="relative z-10 flex-1 max-w-5xl w-full mx-auto px-4 sm:px-6 py-6 sm:py-10 space-y-6 min-w-0">
            <nav class="flex items-center gap-2 text-xs mono text-slate-500 dark:text-slate-400" aria-label="Breadcrumb">
                <a href="/" class="hover:text-indigo-600 dark:hover:text-indigo-400">Home</a>
                <span>/</span>
                <a href="/services/" class="hover:text-indigo-600 dark:hover:text-indigo-400">Services</a>
                <span>/</span>
                <span class="text-slate-800 dark:text-slate-200 font-bold truncate">{serviceUpper}</span>
            </nav>

            <header class="soft-card p-5 sm:p-6 rounded-2xl space-y-4">
                <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 min-w-0">
                    <div class="space-y-1 min-w-0">
                        <div class="flex items-center gap-2.5 flex-wrap">
                            <div class={`w-8 h-8 rounded-xl flex items-center justify-center font-bold mono text-xs shrink-0 ${getServiceColorClass(service)}`}>
                                {service.substring(0, 2).toUpperCase()}
                            </div>
                            <h1 class="text-2xl sm:text-3xl font-bold mono text-slate-900 dark:text-white tracking-tight break-words">
                                AWS {serviceUpper}
                            </h1>
                            <span class="px-2.5 py-0.5 rounded-full bg-indigo-500/12 text-indigo-700 dark:text-indigo-300 text-xs mono font-semibold">
                                {totalUpdates} updates
                            </span>
                        </div>
                        {latestVersion && (
                            <p class="text-xs sm:text-sm mono text-slate-500 dark:text-slate-400">
                                Latest release: <strong class="text-slate-700 dark:text-slate-300 font-semibold">v{latestVersion}</strong>
                                {latestDate && <time datetime={latestDate} class="ml-1">({formatDate(latestDate)})</time>}
                            </p>
                        )}
                    </div>

                    <div class="inline-flex items-center gap-1 p-1 bg-black/[0.04] dark:bg-white/[0.05] rounded-xl mono text-xs self-start md:self-auto max-w-full overflow-x-auto hide-scrollbar">
                        <button type="button"
                                @click="pinTool = pinTool === 'pip' ? 'uv' : 'pip'"
                                title="Switch package manager"
                                class="px-2 py-1 rounded-lg text-[10px] mono font-semibold uppercase bg-black/[0.05] dark:bg-white/[0.08] text-slate-600 dark:text-slate-300 cursor-pointer shrink-0">
                            <span x-text="pinTool">pip</span>
                        </button>
                        <code class="px-1.5 text-indigo-700 dark:text-indigo-300 font-semibold whitespace-nowrap select-all"
                              x-text="pinTool === 'uv' ? 'uv add boto3==' + (latestVersion || 'latest') : 'pip install --upgrade boto3'">
                            pip install --upgrade boto3
                        </code>
                        <button type="button"
                                @click="copyInstallCmd()"
                                aria-label="Copy install command"
                                class="inline-flex items-center gap-1 px-2 py-1 rounded-lg text-[10.5px] mono font-medium text-slate-500 hover:text-indigo-600 dark:text-slate-400 dark:hover:text-indigo-300 cursor-pointer shrink-0">
                            <svg x-show="!pinCopied" class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path></svg>
                            <span x-show="pinCopied" x-cloak class="text-emerald-600 dark:text-emerald-400 font-semibold">Copied</span>
                        </button>
                    </div>
                </div>
            </header>

            <section aria-label="AWS SDK Telemetry" class="grid grid-cols-2 sm:grid-cols-4 gap-3">
                <div class="soft-card p-4 rounded-2xl space-y-1 min-w-0">
                    <span class="text-[10px] mono uppercase font-semibold text-slate-500 dark:text-slate-400">Total Updates</span>
                    <p class="text-xl sm:text-2xl font-bold mono text-indigo-600 dark:text-indigo-400 tabular-nums">{telemetry.totalUpdates}</p>
                    <span class="text-[10px] text-slate-500 dark:text-slate-400 block truncate">{telemetry.cadenceText}</span>
                </div>
                <div class="soft-card p-4 rounded-2xl space-y-1 min-w-0">
                    <span class="text-[10px] mono uppercase font-semibold text-slate-500 dark:text-slate-400">Last 30 Days</span>
                    <p class="text-xl sm:text-2xl font-bold mono text-emerald-600 dark:text-emerald-400 tabular-nums">+{telemetry.updates30d}</p>
                    <span class="text-[10px] text-slate-500 dark:text-slate-400 block">+{telemetry.updates90d} in 90 days</span>
                </div>
                <div class="soft-card p-4 rounded-2xl space-y-1 min-w-0">
                    <span class="text-[10px] mono uppercase font-semibold text-slate-500 dark:text-slate-400">Past 12 Months</span>
                    <p class="text-xl sm:text-2xl font-bold mono text-sky-600 dark:text-sky-400 tabular-nums">+{telemetry.updates365d}</p>
                    <span class="text-[10px] text-slate-500 dark:text-slate-400 block">Annual velocity</span>
                </div>
                <div class="soft-card p-4 rounded-2xl space-y-1 min-w-0">
                    <span class="text-[10px] mono uppercase font-semibold text-slate-500 dark:text-slate-400">Release Span</span>
                    <p class="text-xs sm:text-sm font-bold mono text-slate-800 dark:text-slate-200 truncate">v{telemetry.firstVersion} &rarr; v{telemetry.latestVersion}</p>
                    <span class="text-[10px] text-slate-500 dark:text-slate-400 block truncate">{telemetry.firstDate ? formatDate(telemetry.firstDate) : 'Historical'}</span>
                </div>
            </section>

            <section aria-label="Changelog Composition" class="soft-card p-4 sm:p-5 rounded-2xl space-y-3">
                <div class="flex items-center justify-between gap-2 flex-wrap">
                    <h2 class="text-xs font-bold uppercase tracking-wider text-slate-800 dark:text-slate-200 mono">
                        API Diff Composition &amp; Update Types
                    </h2>
                    <span class="text-[10px] mono text-slate-500 dark:text-slate-400">Parsed from upstream Boto3 commits</span>
                </div>
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-2.5">
                    <div class="p-3 rounded-xl bg-emerald-500/10 flex items-center justify-between">
                        <div>
                            <span class="text-xs font-bold text-emerald-700 dark:text-emerald-300 block">Features &amp; API Changes</span>
                            <span class="text-[10px] text-emerald-700/80 dark:text-emerald-400/80">New operations &amp; models</span>
                        </div>
                        <span class="text-lg font-bold mono text-emerald-700 dark:text-emerald-300 tabular-nums">{telemetry.featuresCount}</span>
                    </div>
                    <div class="p-3 rounded-xl bg-rose-500/10 flex items-center justify-between">
                        <div>
                            <span class="text-xs font-bold text-rose-700 dark:text-rose-300 block">Fixes &amp; Patches</span>
                            <span class="text-[10px] text-rose-700/80 dark:text-rose-400/80">Bug fixes &amp; resolutions</span>
                        </div>
                        <span class="text-lg font-bold mono text-rose-700 dark:text-rose-300 tabular-nums">{telemetry.fixesCount}</span>
                    </div>
                    <div class="p-3 rounded-xl bg-sky-500/10 flex items-center justify-between">
                        <div>
                            <span class="text-xs font-bold text-sky-700 dark:text-sky-300 block">Enhancements &amp; Docs</span>
                            <span class="text-[10px] text-sky-700/80 dark:text-sky-400/80">Documentation &amp; SDK core</span>
                        </div>
                        <span class="text-lg font-bold mono text-sky-700 dark:text-sky-300 tabular-nums">{telemetry.enhancementsCount}</span>
                    </div>
                </div>
            </section>

            <section aria-label="Developer Quickstart" class="soft-card p-4 sm:p-5 rounded-2xl space-y-3 min-w-0">
                <h2 class="text-xs font-bold uppercase tracking-wider text-slate-800 dark:text-slate-200 mono">
                    Python Developer Quickstart for AWS {serviceUpper}
                </h2>
                <div class="grid grid-cols-1 lg:grid-cols-2 gap-3 pt-1 min-w-0">
                    <div class="space-y-1.5 min-w-0">
                        <div class="flex items-center justify-between">
                            <span class="text-[10px] mono text-slate-500 dark:text-slate-400 font-semibold uppercase">Client Initialization</span>
                            <button type="button"
                                    @click="copySnippet()"
                                    class="text-[10px] mono font-semibold text-indigo-600 dark:text-indigo-400 hover:underline cursor-pointer">
                                <span x-show="!snippetCopied">Copy snippet</span>
                                <span x-show="snippetCopied" x-cloak class="text-emerald-600 dark:text-emerald-400">Copied</span>
                            </button>
                        </div>
                        <pre class="p-3 rounded-xl bg-[#0d111a] text-slate-100 font-mono text-[11px] overflow-x-auto max-w-full select-all"><code>{telemetry.clientSnippet}</code></pre>
                    </div>
                    <div class="space-y-2.5 min-w-0">
                        <div class="space-y-1.5 min-w-0">
                            <span class="text-[10px] mono text-slate-500 dark:text-slate-400 font-semibold uppercase">Exact Boto3 Pin</span>
                            <div class="p-2.5 rounded-xl bg-black/[0.04] dark:bg-white/[0.04] flex items-center justify-between gap-2 overflow-x-auto hide-scrollbar">
                                <code class="text-xs mono font-semibold text-indigo-700 dark:text-indigo-300 whitespace-nowrap select-all">{telemetry.installSnippet}</code>
                            </div>
                        </div>
                        {telemetry.relatedServices.length > 0 && (
                            <div class="space-y-1.5 pt-1 min-w-0">
                                <span class="text-[10px] mono text-slate-500 dark:text-slate-400 font-semibold uppercase">Related AWS Services</span>
                                <div class="flex items-center gap-1.5 flex-wrap">
                                    {telemetry.relatedServices.map((rel) => (
                                        <a href={`/services/${rel}/`}
