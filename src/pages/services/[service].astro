                                        <svg x-show="copiedIndex !== 'p-' + idx" class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path></svg>
                                        <span x-show="copiedIndex === 'p-' + idx" x-cloak class="inline-flex items-center gap-1 text-[10.5px] mono font-semibold text-emerald-600 dark:text-emerald-400">
