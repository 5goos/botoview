</Layout>

<script is:inline id="boto-service-init" type="application/json" set:html={JSON.stringify({ initialUpdatesJson: changes, versionDatesJson: scopedVersionDates, serviceSlug: service, serviceUpper, latestVersion, clientSnippet: telemetry.clientSnippet })} />

<script>
    import {
        copyToClipboardText,
        emitToast,
        formatDate,
        formatDescription,
        highlightText,
        isTypingTarget,
        normalizeChangeType,
        openCommandPalette,
        readPageData,
        registerAlpineComponent,
        toggleThemeState
    } from '../../utils/client';
    import type { ServiceUpdateItem } from '../../utils/data';

    interface ServiceInitPayload {
        initialUpdatesJson: ServiceUpdateItem[];
        versionDatesJson: Record<string, string>;
        serviceSlug: string;
        serviceUpper: string;
        latestVersion: string;
        clientSnippet: string;
    }

    const payload = readPageData<ServiceInitPayload>('boto-service-init', {
        initialUpdatesJson: [],
        versionDatesJson: {},
        serviceSlug: '',
        serviceUpper: '',
        latestVersion: '',
        clientSnippet: ''
    });

    registerAlpineComponent('servicePage', () => ({
        isScrolled: false,
        isDarkMode: document.documentElement.classList.contains('dark'),
        searchQuery: '',
        activeFilter: 'all',
        pageSize: 30,
        currentPage: 1,
        copiedIndex: null as string | number | null,
        pinTool: 'pip' as 'pip' | 'uv',
        pinCopied: false,
        snippetCopied: false,
        expandedMap: {} as Record<string, boolean>,
        allUpdates: payload.initialUpdatesJson || [],
        versionDates: payload.versionDatesJson || {},
        serviceSlug: payload.serviceSlug,
        serviceUpper: payload.serviceUpper,
        latestVersion: payload.latestVersion,

        get hasActiveFilter(): boolean {
            return Boolean((this.searchQuery && this.searchQuery.trim()) || this.activeFilter !== 'all' || this.currentPage > 1);
        },

        async init() {
            this.isDarkMode = document.documentElement.classList.contains('dark');
            const params = new URLSearchParams(window.location.search);
            const q = params.get('q');
            const type = params.get('type');
            const p = Number(params.get('page'));
            if (q) this.searchQuery = q;
            if (type && ['all', 'api-change', 'feature', 'enhancement', 'bugfix'].includes(type)) {
                this.activeFilter = type;
            }
            if (p > 1 && Number.isFinite(p)) {
                this.currentPage = p;
            }

            if (!this.allUpdates || this.allUpdates.length === 0) {
                try {
                    const res = await fetch(`/data/services/${this.serviceSlug}.json`);
                    if (res.ok) {
                        this.allUpdates = await res.json();
                    }
                } catch {}
            }

            const syncUrl = () => this.syncQueryParams();
            const watchable = this as unknown as { $watch: (k: string, cb: () => void) => void };
            watchable.$watch('searchQuery', syncUrl);
            watchable.$watch('activeFilter', syncUrl);
            watchable.$watch('currentPage', syncUrl);
        },

        syncQueryParams() {
            const params = new URLSearchParams();
            if (this.activeFilter !== 'all') params.set('type', this.activeFilter);
            if (this.searchQuery.trim()) params.set('q', this.searchQuery.trim());
            if (this.currentPage > 1) params.set('page', String(this.currentPage));
            const qs = params.toString();
            const nextUrl = qs ? `?${qs}${window.location.hash}` : `${window.location.pathname}${window.location.hash}`;
            window.history.replaceState(window.history.state, '', nextUrl);
        },

        toggleTheme() {
            this.isDarkMode = toggleThemeState();
        },

        openPalette() {
            openCommandPalette('');
        },

        isExpanded(key: string): boolean {
            return Boolean(this.expandedMap[key]);
        },

        toggleExpand(key: string) {
            this.expandedMap[key] = !this.expandedMap[key];
        },

        async copyInstallCmd() {
            const cmd = this.pinTool === 'uv'
                ? `uv add boto3==${this.latestVersion || 'latest'}`
                : 'pip install --upgrade boto3';
            const ok = await copyToClipboardText(cmd);
            if (ok) {
                this.pinCopied = true;
                emitToast(`Copied ${cmd}`);
                setTimeout(() => {
                    this.pinCopied = false;
                }, 2000);
            }
        },

        async copySnippet() {
            const ok = await copyToClipboardText(payload.clientSnippet);
            if (ok) {
                this.snippetCopied = true;
                emitToast('Copied Python quickstart');
                setTimeout(() => {
                    this.snippetCopied = false;
                }, 2000);
            }
        },

        async copyAnchorLink(anchorId: string) {
            const url = new URL(window.location.href);
            url.hash = anchorId;
            window.history.replaceState(window.history.state, '', url.toString());
            const ok = await copyToClipboardText(url.toString());
            if (ok) emitToast('Copied deep link');
        },

        handleKeydown(e: KeyboardEvent) {
            if (e.metaKey || e.ctrlKey) return;
            if (!isTypingTarget(e.target)) {
                if (e.key === '/') {
                    e.preventDefault();
                    document.getElementById('serviceFilterSearch')?.focus();
                } else if (e.key === 't' || e.key === 'T') {
                    e.preventDefault();
                    this.toggleTheme();
                }
            } else if (e.key === 'Escape') {
                (e.target as HTMLElement).blur();
                if (this.searchQuery) this.searchQuery = '';
            }
        },

        get serviceCounts() {
            let apiChanges = 0;
            let features = 0;
            let enhancements = 0;
            let fixes = 0;
            for (const u of this.allUpdates) {
                const key = normalizeChangeType('', u?.t).key;
                if (key === 'api-change') apiChanges++;
                else if (key === 'feature') features++;
                else if (key === 'enhancement') enhancements++;
                else fixes++;
            }
            return {
                total: this.allUpdates.length,
                apiChanges,
                features,
                enhancements,
                fixes
            };
        },

        getTypeMeta(rawType?: string, description?: string) {
            return normalizeChangeType(rawType, description);
        },

        get filteredUpdates(): ServiceUpdateItem[] {
            let list = this.allUpdates;
            if (this.activeFilter !== 'all') {
                list = list.filter((u) => normalizeChangeType('', u.t).key === this.activeFilter);
            }
            if (this.searchQuery && this.searchQuery.trim()) {
                const q = this.searchQuery.toLowerCase().trim();
                list = list.filter((u) => (u.v && u.v.toLowerCase().includes(q)) || (u.t && u.t.toLowerCase().includes(q)));
            }
            return list;
        },

        get totalPages(): number {
            return Math.max(1, Math.ceil(this.filteredUpdates.length / this.pageSize));
        },

        get paginatedUpdates(): ServiceUpdateItem[] {
            const start = (this.currentPage - 1) * this.pageSize;
            return this.filteredUpdates.slice(start, start + this.pageSize);
        },

        get visiblePageNumbers(): number[] {
            const total = this.totalPages;
            const cur = this.currentPage;
            if (total <= 5) {
                return Array.from({ length: total }, (_, i) => i + 1);
            }
            let start = Math.max(1, cur - 2);
            const end = Math.min(total, start + 4);
            if (end - start < 4) {
                start = Math.max(1, end - 4);
            }
            const pages: number[] = [];
            for (let i = start; i <= end; i++) pages.push(i);
            return pages;
        },

        nextPage() {
            if (this.currentPage < this.totalPages) {
                this.currentPage++;
                this.scrollToFeed();
            }
        },

        prevPage() {
            if (this.currentPage > 1) {
                this.currentPage--;
                this.scrollToFeed();
            }
        },

        setPage(p: number) {
            this.currentPage = p;
            this.scrollToFeed();
        },

        scrollToFeed() {
            document.getElementById('changelog-feed')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
        },

        formatDateStr(dateStr: string): string {
            return formatDate(dateStr);
        },

        highlight(text: string, search?: string): string {
            return highlightText(text, search);
        },

        formatDescription(text: string, search?: string): string {
            return formatDescription(text, search);
        },

        async copyUpdate(text: string, idx: string | number) {
            const ok = await copyToClipboardText(text);
            if (ok) {
                this.copiedIndex = idx;
                emitToast('Copied changelog entry');
                setTimeout(() => {
                    if (this.copiedIndex === idx) this.copiedIndex = null;
                }, 2000);
            }
        }
    }));
</script>
