                    </button>
                    <button type="button"
                            @click="activeFilter = 'feature'; currentPage = 1"
                            :class="activeFilter === 'feature' ? 'bg-emerald-500/15 dark:bg-emerald-500/20 text-emerald-700 dark:text-emerald-300 font-semibold' : 'text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white'"
                            class="px-2.5 py-1.5 sm:py-1 rounded-lg uppercase transition-all cursor-pointer whitespace-nowrap">
                        Features (<span x-text="serviceCounts.features">{featureCount}</span>)
                    </button>
                    <button type="button"
                            @click="activeFilter = 'enhancement'; currentPage = 1"
                            :class="activeFilter === 'enhancement' ? 'bg-sky-500/15 dark:bg-sky-500/20 text-sky-700 dark:text-sky-300 font-semibold' : 'text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white'"
                            class="px-2.5 py-1.5 sm:py-1 rounded-lg uppercase transition-all cursor-pointer whitespace-nowrap">
                        Enhance (<span x-text="serviceCounts.enhancements">{enhancementCount}</span>)
                    </button>
                    <button type="button"
                            @click="activeFilter = 'bugfix'; currentPage = 1"
                            :class="activeFilter === 'bugfix' ? 'bg-rose-500/15 dark:bg-rose-500/20 text-rose-700 dark:text-rose-300 font-semibold' : 'text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white'"
                            class="px-2.5 py-1.5 sm:py-1 rounded-lg uppercase transition-all cursor-pointer whitespace-nowrap">
                        Fixes (<span x-text="serviceCounts.fixes">{fixCount}</span>)
                    </button>
                </div>
            </div>

            <section id="changelog-feed" class="space-y-4">
                <div x-show="!hasActiveFilter" class="space-y-3" id="ssr-history">
                    {initialSsrUpdates.map((change, idx) => {
                        const date = scopedVersionDates[change.v];
                        const meta = normalizeChangeType('', change.t);
                        const anchorId = `v${change.v.replace(/\./g, '-')}-${idx}`;
                        return (
                            <article id={anchorId} class="changelog-card rounded-2xl p-4 sm:p-5 group scroll-mt-24 content-auto">
                                <div class="flex items-center justify-between gap-2 mb-2 flex-wrap">
                                    <div class="flex items-center gap-2">
                                        <a href={`/releases/${change.v}/`}
                                           title={`AWS Boto3 release v${change.v}`}
