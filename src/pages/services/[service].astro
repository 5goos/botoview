                    <div class="text-xs mono text-slate-500 dark:text-slate-400 tabular-nums">
                        Page <strong class="text-slate-900 dark:text-white" x-text="currentPage">1</strong> of <strong class="text-slate-900 dark:text-white" x-text="totalPages"></strong>
                    </div>

                    <div class="flex items-center gap-1.5 flex-wrap justify-center">
                        <button type="button"
                                @click="prevPage()"
                                :disabled="currentPage === 1"
                                :class="currentPage === 1 ? 'opacity-40 cursor-not-allowed' : 'hover:bg-black/[0.06] dark:hover:bg-white/10 active:scale-95 cursor-pointer'"
                                class="px-3.5 py-2 sm:py-1.5 rounded-full bg-black/[0.04] dark:bg-white/[0.06] text-xs mono font-semibold text-slate-700 dark:text-slate-300 flex items-center gap-1 transition-all">
                            &larr; Prev
                        </button>

                        <template x-for="p in visiblePageNumbers" :key="p">
                            <button type="button"
                                    @click="setPage(p)"
                                    :class="currentPage === p ? 'bg-indigo-600 text-white font-bold shadow-xs' : 'bg-black/[0.04] dark:bg-white/[0.06] hover:bg-black/[0.08] dark:hover:bg-white/10 text-slate-700 dark:text-slate-300 font-medium'"
                                    class="w-9 h-9 sm:w-8 sm:h-8 rounded-full text-xs mono transition-all active:scale-95 cursor-pointer flex items-center justify-center"
                                    x-text="p">
                            </button>
                        </template>

                        <button type="button"
                                @click="nextPage()"
                                :disabled="currentPage === totalPages"
                                :class="currentPage === totalPages ? 'opacity-40 cursor-not-allowed' : 'hover:bg-black/[0.06] dark:hover:bg-white/10 active:scale-95 cursor-pointer'"
                                class="px-3.5 py-2 sm:py-1.5 rounded-full bg-black/[0.04] dark:bg-white/[0.06] text-xs mono font-semibold text-slate-700 dark:text-slate-300 flex items-center gap-1 transition-all">
                            Next &rarr;
                        </button>
                    </div>
                </div>
            </section>

            <section class="p-6 sm:p-8 rounded-2xl soft-card">
                <h2 class="text-sm font-bold uppercase tracking-wider text-slate-900 dark:text-white mb-4">
