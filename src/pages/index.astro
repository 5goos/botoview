---
export const prerender = true;

import Layout from '../layouts/Layout.astro';
import LeftRail from '../components/LeftRail.astro';
import MainView from '../components/MainView.astro';
import trackData from '../../public/data/track.json';
import { loadReleaseChanges } from '../utils/data';

const latestVersion = trackData?.versions?.[0] || { id: 'latest', date: '' };
const totalVersionsCount = trackData?.versions?.length || 0;
const totalServicesCount = trackData?.allServices?.length || 0;
const initialChanges = loadReleaseChanges(latestVersion.id);

const pageTitle = "BotoView — AWS Boto3 Changelogs & Release Notes";
const pageDescription = `Browse AWS Boto3 changelogs and release notes by service with BotoView. Search API changes, bug fixes, and SDK updates across ${totalServicesCount}+ AWS services.`;
const canonicalUrl = "https://botoview.5goos.com/";

const homeWebPageSchema = {
    "@type": "WebPage",
    "@id": `${canonicalUrl}#webpage`,
    "url": canonicalUrl,
    "name": pageTitle,
    "description": pageDescription,
    "inLanguage": "en-US",
    "isPartOf": { "@id": "https://botoview.5goos.com/#website" },
    "about": [
        { "@type": "Thing", "name": "AWS Boto3" },
        { "@type": "Thing", "name": "Botocore" },
        { "@type": "Thing", "name": "AWS Python SDK Changelogs" }
    ],
    "dateModified": latestVersion.date || new Date().toISOString().split('T')[0],
    "mainEntity": {
        "@type": "Dataset",
        "name": "BotoView AWS Boto3 & Botocore Changelog Archive",
        "description": `Structured history of ${totalVersionsCount.toLocaleString('en-US')} AWS Boto3 SDK releases across ${totalServicesCount} AWS services.`,
        "url": canonicalUrl,
        "creator": { "@id": "https://5goos.com/#organization" },
        "license": "https://opensource.org/licenses/MIT"
    }
};
---

<Layout title={pageTitle} description={pageDescription} canonical={canonicalUrl} jsonLd={homeWebPageSchema}>
    <div class="flex h-screen w-full overflow-hidden bg-transparent text-[var(--text-secondary)] transition-all"
         style="height: 100dvh;"
         x-data="botoCore"
         @keydown.window="handleGlobalKeydown($event)"
         @boto:palette-select.window="handlePaletteSelection($event.detail)"
         @boto:theme-changed.window="isDarkMode = $event.detail.isDark">

        <div x-show="showMobileVersions"
             x-cloak
             x-transition:enter="transition-opacity ease-out duration-200"
             x-transition:enter-start="opacity-0"
             x-transition:enter-end="opacity-100"
             x-transition:leave="transition-opacity ease-in duration-150"
             x-transition:leave-start="opacity-100"
             x-transition:leave-end="opacity-0"
             class="fixed inset-0 bg-slate-900/40 dark:bg-black/65 backdrop-blur-xs z-40 lg:hidden"
             @click="showMobileVersions = false"></div>

        <template x-if="error">
            <div class="fixed inset-0 z-[150] flex items-center justify-center p-6 bg-slate-950/80 backdrop-blur-xl">
                <div class="command-modal text-slate-900 dark:text-white p-8 rounded-3xl max-w-md w-full text-center relative overflow-hidden space-y-5">
                    <div class="w-14 h-14 bg-rose-500/12 rounded-2xl flex items-center justify-center mx-auto">
                        <svg class="w-7 h-7 text-rose-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
                    </div>
                    <div class="space-y-1.5">
                        <div class="text-lg font-semibold tracking-tight" x-text="errorTitle"></div>
                        <p class="text-slate-500 dark:text-slate-400 leading-relaxed text-xs mono" x-text="error"></p>
                    </div>
                    <button type="button" @click="location.reload()" class="w-full bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-3 px-6 rounded-xl transition-all active:scale-95 text-xs cursor-pointer">
                        Retry Loading
                    </button>
                </div>
            </div>
        </template>

        <div class="flex h-full w-full min-w-0">
            <LeftRail />
            <MainView initialChanges={initialChanges} latestVersion={latestVersion} />
        </div>
    </div>
</Layout>

<script is:inline id="boto-home-init" type="application/json" set:html={JSON.stringify({ latestId: latestVersion.id, changes: initialChanges })} />

<script>
    import {
        copyToClipboardText,
        emitToast,
        formatDate,
        formatDescription,
        getMonthYear,
        getRelativeDate,
        getServiceColorClass,
        highlightText,
        isTypingTarget,
        loadTrackIndex,
        makeEntryAnchorId,
        normalizeChangeType,
        openCommandPalette,
        readPageData,
        registerAlpineComponent,
        slugifyService,
        toggleThemeState
    } from '../utils/client';
    import type { ChangelogItem, ServiceUpdateItem } from '../utils/data';

    interface HomeInitPayload {
        latestId: string;
        changes: ChangelogItem[];
    }

    const initData = readPageData<HomeInitPayload>('boto-home-init', { latestId: '', changes: [] });
    const initialLatestId = initData.latestId || '';
    const initialChangesJson = initData.changes || [];

    registerAlpineComponent('botoCore', () => ({
        errorTitle: 'Unable to load release data',
        sidebarTab: 'versions',
        viewMode: 'release' as 'release' | 'service',
        selectedVersion: initialLatestId,
        navigatedFromVersion: null as string | null,
        versions: [] as Array<{ id: string; date: string }>,
        allServices: [] as string[],
        serviceCounts: {} as Record<string, number>,
        serviceSort: 'popular' as 'popular' | 'alpha',
        serviceLimit: 40,
        currentVersionData: initialChangesJson as ChangelogItem[],
        isClientHydrated: true,
        serviceSearch: '',
        versionSearch: '',
        versionRailSearch: '',
        releaseServiceFilter: '',
        activeFilter: 'all',
        railLimit: 50,
        activeService: null as string | null,
        serviceHistory: [] as ServiceUpdateItem[],
        serviceHistorySearch: '',
        serviceHistoryFilter: 'all',
        serviceVersionFilter: 'all',
        serviceHistoryLimit: 40,
        serviceHistoryLoading: false,
        showMobileVersions: false,
        showBackToTop: false,
        isScrolled: false,
        error: null as string | null,
        versionCache: (initialLatestId ? { [initialLatestId]: initialChangesJson } : {}) as Record<string, unknown>,
        copiedItemIndex: null as string | number | null,
        showPipCopied: false,
        pinTool: 'pip' as 'pip' | 'uv',
        expandedEntries: {} as Record<string, boolean>,
        isDarkMode: document.documentElement.classList.contains('dark'),
        _versionDateMap: null as Map<string, string> | null,
        _serviceColorCache: {} as Record<string, string>,

        get hasActiveFilter(): boolean {
            return Boolean(
                (this.versionSearch && this.versionSearch.trim()) ||
                this.activeFilter !== 'all' ||
                this.releaseServiceFilter ||
                this.selectedVersion !== initialLatestId ||
                this.viewMode !== 'release'
            );
        },

        toggleTheme() {
            this.isDarkMode = toggleThemeState();
        },

        openPalette() {
            this.syncPaletteEntries();
            openCommandPalette('');
        },

        handlePaletteSelection(detail?: { type: string; value: string }) {
            if (!detail) return;
            if (detail.type === 'service') {
                this.openService(detail.value, true, false);
            } else if (detail.type === 'version') {
                this.selectVersion(detail.value, true);
            }
        },

        syncPaletteEntries() {
            const win = window as unknown as {
                __BOTO_ACTIVE_ENTRIES__?: Array<{ id: string; label: string; text: string; anchor: string }>;
            };
            if (this.viewMode === 'release') {
                win.__BOTO_ACTIVE_ENTRIES__ = this.currentVersionData.map((c, idx) => ({
                    id: `${idx}`,
                    label: c.category || 'core',
                    text: c.description || '',
                    anchor: makeEntryAnchorId(c.category, idx)
                }));
            } else {
                win.__BOTO_ACTIVE_ENTRIES__ = this.serviceHistory.slice(0, 120).map((item, idx) => ({
                    id: `${idx}`,
                    label: `v${item.v}`,
                    text: item.t || '',
                    anchor: `svc-${item.v.replace(/\./g, '-')}-${idx}`
                }));
            }
        },

        isMobile(breakpoint = 768): boolean {
            return window.matchMedia(`(max-width: ${breakpoint - 1}px)`).matches;
        },

        highlight(text: string, search?: string): string {
            return highlightText(text, search);
        },

        formatDescription(text: string, search?: string): string {
            return formatDescription(text, search);
        },

        slugifyService(name: string): string {
            return slugifyService(name);
        },

        makeEntryAnchorId(prefix: string, idx: number): string {
            return makeEntryAnchorId(prefix, idx);
        },

        getTypeMeta(rawType?: string, description?: string) {
            return normalizeChangeType(rawType, description);
        },

        isLongText(text?: string): boolean {
            return Boolean(text && text.length > 280);
        },

        isExpanded(key: string): boolean {
            return Boolean(this.expandedEntries[key]);
        },

        toggleExpand(key: string) {
            this.expandedEntries[key] = !this.expandedEntries[key];
        },

        async copyPipCommand() {
            const ver = this.selectedVersion || initialLatestId;
            const cmd = this.pinTool === 'uv' ? `uv add boto3==${ver}` : `pip install boto3==${ver}`;
            const ok = await copyToClipboardText(cmd);
            if (ok) {
                this.showPipCopied = true;
                emitToast(`Copied ${cmd}`);
                setTimeout(() => {
                    this.showPipCopied = false;
                }, 2000);
            }
        },

        async copyReleaseLink() {
            const url = new URL(window.location.href);
            url.hash = '';
            const ok = await copyToClipboardText(url.toString());
            if (ok) emitToast(`Copied link to v${this.selectedVersion || initialLatestId}`);
        },

        async copyAnchorLink(anchorId: string) {
            const url = new URL(window.location.href);
            url.hash = anchorId;
            window.history.replaceState(window.history.state, '', url.toString());
            const ok = await copyToClipboardText(url.toString());
            if (ok) emitToast('Copied deep link');
        },

        async copyItem(item: { category?: string; description: string; version?: string }, index: string | number) {
            const cat = (item.category || '').toUpperCase();
            const ver = item.version || this.selectedVersion || initialLatestId;
            const text = `${cat}: ${item.description} (${ver})`;
            const ok = await copyToClipboardText(text);
            if (ok) {
                this.copiedItemIndex = index;
                emitToast('Copied changelog entry');
                setTimeout(() => {
                    if (this.copiedItemIndex === index) this.copiedItemIndex = null;
                }, 2000);
            }
        },

        resetReleaseFilters() {
            this.versionSearch = '';
            this.activeFilter = 'all';
            this.releaseServiceFilter = '';
        },

        get versionCounts() {
            let apiChanges = 0;
            let features = 0;
            let enhancements = 0;
            let fixes = 0;
            for (const item of this.currentVersionData) {
                const key = normalizeChangeType(item.type, item.description).key;
                if (key === 'api-change') apiChanges++;
                else if (key === 'feature') features++;
                else if (key === 'enhancement') enhancements++;
                else fixes++;
            }
            return {
                total: this.currentVersionData.length,
                apiChanges,
                features,
                enhancements,
                fixes
            };
        },

        get serviceHistoryCounts() {
            let apiChanges = 0;
            let features = 0;
            let enhancements = 0;
            let fixes = 0;
            for (const item of this.serviceHistory) {
                const key = normalizeChangeType('', item.t).key;
                if (key === 'api-change') apiChanges++;
                else if (key === 'feature') features++;
                else if (key === 'enhancement') enhancements++;
                else fixes++;
            }
            return {
                total: this.serviceHistory.length,
                apiChanges,
                features,
                enhancements,
                fixes
            };
        },

        switchSidebarTab(tab: string) {
            this.sidebarTab = tab;
            if (tab === 'versions' && this.viewMode === 'service') {
                this.backToRelease();
            } else if (tab === 'services' && this.viewMode === 'release' && this.activeService) {
                this.openService(this.activeService, true, false);
            }
        },

        get currentVersionServices() {
            const s = new Set<string>();
            for (const c of this.currentVersionData) {
                if (c && c.category) s.add(c.category.toLowerCase().trim());
            }
            return s;
        },

        get adjacentVersions() {
            if (!this.versions.length || !this.selectedVersion) return { newer: null, older: null };
            const idx = this.versions.findIndex((v) => v.id === this.selectedVersion);
            if (idx === -1) return { newer: null, older: null };
            return {
                newer: idx > 0 ? this.versions[idx - 1].id : null,
                older: idx < this.versions.length - 1 ? this.versions[idx + 1].id : null
            };
        },

        handleGlobalKeydown(e: KeyboardEvent) {
            if (e.metaKey || e.ctrlKey) return;

            if (isTypingTarget(e.target)) {
                if (e.key === 'Escape') {
                    (e.target as HTMLElement).blur();
                }
                return;
            }

            if (e.key === 'Escape') {
                this.showMobileVersions = false;
                if (this.viewMode === 'service') {
                    this.backToRelease();
                }
                return;
            }

            if (e.key === 't' || e.key === 'T') {
                e.preventDefault();
                this.toggleTheme();
                return;
            }

            if (e.key === 'j' || e.key === 'ArrowDown') {
                if (this.adjacentVersions.older) {
                    e.preventDefault();
                    this.selectVersion(this.adjacentVersions.older, true);
                }
                return;
            }

            if (e.key === 'k' || e.key === 'ArrowUp') {
                if (this.adjacentVersions.newer) {
                    e.preventDefault();
                    this.selectVersion(this.adjacentVersions.newer, true);
                }
                return;
            }

            if (e.key === '/') {
                e.preventDefault();
                const searchId = this.viewMode === 'service' ? 'serviceHistorySearch' : 'versionSearch';
                document.getElementById(searchId)?.focus();
            }
        },

        get selectedDate(): string {
            return this.getVersionDate(this.selectedVersion);
        },

        getVersionDate(id: string): string {
            if (!id || !this._versionDateMap) return '';
            return this._versionDateMap.get(id) || '';
        },

        getRelativeDate(dateStr: string): string {
            return getRelativeDate(dateStr);
        },

        formatDate(dateStr: string): string {
            return formatDate(dateStr);
        },

        getMonthYear(dateStr: string): string {
            return getMonthYear(dateStr);
        },

        getServiceColorClass(serviceName: string): string {
            if (!serviceName) return 'bg-slate-500/10 text-slate-700 dark:text-slate-300';
            if (this._serviceColorCache[serviceName]) return this._serviceColorCache[serviceName];
            const result = getServiceColorClass(serviceName);
            this._serviceColorCache[serviceName] = result;
            return result;
        },

        async prefetchVersion(id: string) {
            if (this.versionCache[id] || this.selectedVersion === id) return;
            try {
                const res = await fetch(`/data/versions/${id}.json`);
                if (res.ok) {
                    this.versionCache[id] = await res.json();
                }
            } catch {}
        },

        async prefetchService(svc: string) {
            const serviceId = this.slugifyService(svc);
            if (!serviceId) return;
            const cacheKey = `svc_${serviceId}`;
            if (this.versionCache[cacheKey]) return;
            try {
                const res = await fetch(`/data/services/${serviceId}.json`);
                if (res.ok) {
                    this.versionCache[cacheKey] = await res.json();
                }
            } catch {}
        },

        async init() {
            this.isDarkMode = document.documentElement.classList.contains('dark');
            try {
                const data = await loadTrackIndex();
                this.versions = data.versions || [];
                this.allServices = data.allServices || [];
                this.serviceCounts = data.serviceCounts || {};

                this._versionDateMap = new Map();
                for (const v of this.versions) {
                    this._versionDateMap.set(v.id, v.date || '');
                }

                await this.applyUrlParams(window.location.search);
                this.syncPaletteEntries();

                const syncWatcher = () => {
                    this.updateUrl(false);
                };
                const watchable = this as unknown as { $watch: (k: string, cb: () => void) => void };
                watchable.$watch('versionSearch', syncWatcher);
                watchable.$watch('activeFilter', syncWatcher);
                watchable.$watch('releaseServiceFilter', syncWatcher);
                watchable.$watch('serviceHistorySearch', syncWatcher);
                watchable.$watch('serviceHistoryFilter', syncWatcher);
                watchable.$watch('serviceVersionFilter', syncWatcher);

                window.addEventListener('popstate', () => {
                    this.applyUrlParams(window.location.search);
                });
            } catch (e) {
                this.error = e instanceof Error ? e.message : 'Unable to fetch changelog index.';
            }
        },

        async applyUrlParams(searchStr: string) {
            const params = new URLSearchParams(searchStr);
            const vParam = params.get('v');
            const sParam = params.get('s');
            const svcParam = params.get('svc');
            const typeParam = params.get('type');
            const qParam = params.get('q');
            const sSlug = sParam ? this.slugifyService(sParam) : '';

            if (sSlug && this.allServices.includes(sSlug)) {
                await this.openService(sSlug, false, vParam || null);
                if (typeParam && ['all', 'api-change', 'feature', 'enhancement', 'bugfix'].includes(typeParam)) {
                    this.serviceHistoryFilter = typeParam;
                }
                if (qParam) {
                    this.serviceHistorySearch = qParam;
                }
            } else {
                this.viewMode = 'release';
                this.activeService = null;
                this.navigatedFromVersion = null;
                if (vParam && vParam !== this.selectedVersion && this.versions.find((v) => v.id === vParam)) {
                    await this.selectVersion(vParam, false);
                } else if (!vParam && this.versions.length > 0 && this.selectedVersion !== this.versions[0].id) {
                    await this.selectVersion(this.versions[0].id, false);
                }
                if (svcParam) {
                    this.releaseServiceFilter = this.slugifyService(svcParam);
                } else {
                    this.releaseServiceFilter = '';
                }
                if (typeParam && ['all', 'api-change', 'feature', 'enhancement', 'bugfix'].includes(typeParam)) {
                    this.activeFilter = typeParam;
                } else {
                    this.activeFilter = 'all';
                }
                if (qParam) {
                    this.versionSearch = qParam;
                } else if (sParam && sParam.trim()) {
                    this.versionSearch = sParam.trim();
                } else {
                    this.versionSearch = '';
                }
            }
        },

        updateUrl(push = false) {
            const params = new URLSearchParams();
            if (this.viewMode === 'service') {
                if (this.activeService) params.set('s', this.activeService);
                if (this.navigatedFromVersion) params.set('v', this.navigatedFromVersion);
                if (this.serviceHistoryFilter !== 'all') params.set('type', this.serviceHistoryFilter);
                if (this.serviceHistorySearch.trim()) params.set('q', this.serviceHistorySearch.trim());
            } else {
                if (this.selectedVersion && this.versions[0] && this.selectedVersion !== this.versions[0].id) {
                    params.set('v', this.selectedVersion);
                }
                if (this.releaseServiceFilter) params.set('svc', this.releaseServiceFilter);
                if (this.activeFilter !== 'all') params.set('type', this.activeFilter);
                if (this.versionSearch.trim()) params.set('q', this.versionSearch.trim());
            }
            const qs = params.toString();
            const hash = window.location.hash || '';
            const newUrl = qs ? `?${qs}${hash}` : `${window.location.pathname}${hash}`;
            const state = {
                v: this.selectedVersion,
                s: this.activeService,
                navigatedFromVersion: this.navigatedFromVersion,
                viewMode: this.viewMode
            };
            if (push) {
                window.history.pushState(state, '', newUrl);
            } else {
                window.history.replaceState(state, '', newUrl);
            }
        },

        backToRelease() {
            const targetVersion = this.navigatedFromVersion || this.selectedVersion || (this.versions[0]?.id ?? '');
            this.viewMode = 'release';
            this.activeService = null;
            this.navigatedFromVersion = null;
            this.sidebarTab = 'versions';
            if (targetVersion && targetVersion !== this.selectedVersion) {
                this.selectVersion(targetVersion, true);
            } else {
                this.updateUrl(true);
                document.title = `AWS Boto3 v${this.selectedVersion} Changelog & Release Notes | BotoView`;
                document.getElementById('mainScrollArea')?.scrollTo({ top: 0, behavior: 'instant' as ScrollBehavior });
                this.syncIndicator(this.selectedVersion, true);
                this.syncPaletteEntries();
            }
        },

        prefetchAdjacent(currentIndex: number) {
            if (currentIndex === -1) return;
            if (currentIndex > 0 && this.versions[currentIndex - 1]) {
                this.prefetchVersion(this.versions[currentIndex - 1].id);
            }
            if (currentIndex < this.versions.length - 1 && this.versions[currentIndex + 1]) {
                this.prefetchVersion(this.versions[currentIndex + 1].id);
            }
        },

        async selectVersion(id: string, push = true) {
            if (this.isMobile(1024)) this.showMobileVersions = false;
            this.viewMode = 'release';
            this.sidebarTab = 'versions';
            this.activeService = null;
            this.navigatedFromVersion = null;
            this.releaseServiceFilter = '';
            this.expandedEntries = {};

            if (this.selectedVersion === id && this.currentVersionData.length > 0) {
                this.updateUrl(push);
                this.syncPaletteEntries();
                return;
            }

            const prevVersion = this.selectedVersion;
            this.selectedVersion = id;

            const idx = this.versions.findIndex((v) => v.id === id);
            if (idx !== -1 && idx >= this.railLimit) {
                this.railLimit = idx + 20;
            }

            this.updateUrl(push);

            if (this.versionCache[id]) {
                this.currentVersionData = this.versionCache[id] as ChangelogItem[];
                document.title = `AWS Boto3 v${id} Changelog & Release Notes | BotoView`;
                this.syncIndicator(id);
                this.prefetchAdjacent(idx);
                this.syncPaletteEntries();
                return;
            }

            this.currentVersionData = [];
            document.title = `AWS Boto3 v${id} Changelog & Release Notes | BotoView`;
            this.syncIndicator(id, false);

            try {
                const res = await fetch(`/data/versions/${id}.json`);
                if (!res.ok) throw new Error(`Release ${id} unavailable`);
                const data = (await res.json()) as ChangelogItem[];
                this.versionCache[id] = data;

                if (this.selectedVersion === id) {
                    this.currentVersionData = data;
                    this.syncIndicator(id, true);
                    this.prefetchAdjacent(idx);
                    this.syncPaletteEntries();
                }
            } catch {
                this.error = `Failed to load release v${id}`;
                this.selectedVersion = prevVersion;
                if (prevVersion && this.versionCache[prevVersion]) {
                    this.currentVersionData = this.versionCache[prevVersion] as ChangelogItem[];
                }
                this.updateUrl(false);
            }
        },

        syncIndicator(id: string, scroll = true) {
            if (scroll) {
                document.getElementById('mainScrollArea')?.scrollTo({ top: 0, behavior: 'instant' as ScrollBehavior });
            }

            requestAnimationFrame(() => {
                const active = document.querySelector(`a[data-version="${id}"]`);
                active?.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
            });
        },

        async openService(svc: string, push = true, fromVersion: string | boolean | null = null) {
            this.activeService = svc;
            this.viewMode = 'service';
            this.sidebarTab = 'services';
            this.expandedEntries = {};

            if (typeof fromVersion === 'string') {
                this.navigatedFromVersion = fromVersion;
            } else if (fromVersion === true) {
                this.navigatedFromVersion = this.selectedVersion || null;
            } else if (fromVersion === false) {
                this.navigatedFromVersion = null;
            }

            this.serviceHistoryFilter = 'all';
            this.serviceVersionFilter = 'all';
            this.serviceHistoryLimit = 40;
            this.serviceHistorySearch = '';
            this.serviceHistory = [];
            this.serviceHistoryLoading = true;
            this.updateUrl(push);

            document.title = `AWS Boto3 ${svc.toUpperCase()} Changelog | BotoView`;
            document.getElementById('mainScrollArea')?.scrollTo({ top: 0, behavior: 'instant' as ScrollBehavior });

            requestAnimationFrame(() => {
                const activeSvcEl = document.querySelector(`[data-service="${svc.toLowerCase().trim()}"]`);
                activeSvcEl?.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
            });

            const serviceId = this.slugifyService(svc);
            const cacheKey = `svc_${serviceId}`;

            if (this.versionCache[cacheKey]) {
                this.serviceHistory = this.versionCache[cacheKey] as ServiceUpdateItem[];
                this.serviceHistoryLoading = false;
                this.syncPaletteEntries();
                return;
            }

            try {
                const res = await fetch(`/data/services/${serviceId}.json`);
                if (!res.ok) throw new Error('Service data unavailable');
                const data = (await res.json()) as ServiceUpdateItem[];
                this.versionCache[cacheKey] = data;
                if (this.activeService === svc) {
                    this.serviceHistory = data;
                    this.syncPaletteEntries();
                }
            } catch {
                if (this.activeService === svc) this.serviceHistory = [];
            } finally {
                if (this.activeService === svc) this.serviceHistoryLoading = false;
            }
        },

        get hasMoreServices(): boolean {
            return this.serviceLimit < this._getFilteredServicesBase().length;
        },

        loadMoreServices() {
            this.serviceLimit += 40;
        },

        _getFilteredServicesBase(): string[] {
            let list = this.allServices || [];
            if (this.serviceSearch) {
                const s = this.serviceSearch.toLowerCase().trim();
                list = list.filter((svc) => svc.toLowerCase().includes(s));
            }
            if (this.serviceSort === 'popular') {
                return [...list].sort((a, b) => {
                    const countA = this.serviceCounts[a] || 0;
                    const countB = this.serviceCounts[b] || 0;
                    if (countB !== countA) return countB - countA;
                    return a.localeCompare(b);
                });
            }
            return [...list].sort((a, b) => a.localeCompare(b));
        },

        get filteredServices(): string[] {
            return this._getFilteredServicesBase().slice(0, this.serviceLimit);
        },

        _getFilteredVersionsBase() {
            const s = this.versionRailSearch.toLowerCase();
            if (!s) return this.versions;
            return this.versions.filter((v) => {
                const monthYear = this.getMonthYear(v.date).toLowerCase();
                return v.id.includes(s) || monthYear.includes(s);
            });
        },

        get filteredRailVersions() {
            return this._getFilteredVersionsBase().slice(0, this.railLimit);
        },

        get groupedRailVersions() {
            const groups: Array<{ label: string; versions: Array<{ id: string; date: string }> }> = [];
            for (const v of this.filteredRailVersions) {
                const label = this.getMonthYear(v.date);
                let group = groups.find((g) => g.label === label);
                if (!group) {
                    group = { label, versions: [] };
                    groups.push(group);
                }
                group.versions.push(v);
            }
            return groups;
        },

        get hasMoreVersions(): boolean {
            return this.railLimit < this._getFilteredVersionsBase().length;
        },

        loadMoreVersions() {
            this.railLimit += 50;
        },

        get availableServiceVersionPrefixes(): string[] {
            const s = new Set<string>();
            for (const item of this.serviceHistory) {
                if (item.v) {
                    const parts = item.v.split('.');
                    if (parts.length >= 2) {
                        s.add(`${parts[0]}.${parts[1]}`);
                    }
                }
            }
            return Array.from(s).slice(0, 10);
        },

        get filteredServiceHistory(): ServiceUpdateItem[] {
            let list = this.serviceHistory;
            if (this.serviceHistoryFilter !== 'all') {
                list = list.filter((item) => normalizeChangeType('', item.t).key === this.serviceHistoryFilter);
            }

            if (this.serviceVersionFilter && this.serviceVersionFilter !== 'all') {
                list = list.filter((item) => item.v && item.v.startsWith(this.serviceVersionFilter));
            }

            if (!this.serviceHistorySearch || !this.serviceHistorySearch.trim()) {
                return list;
            }
            const s = this.serviceHistorySearch.toLowerCase().trim();
            return list.filter((log) => (log.v && log.v.toLowerCase().includes(s)) || (log.t && log.t.toLowerCase().includes(s)));
        },

        get visibleServiceHistory(): ServiceUpdateItem[] {
            return this.filteredServiceHistory.slice(0, this.serviceHistoryLimit);
        },

        get hasMoreServiceHistory(): boolean {
            return this.serviceHistoryLimit < this.filteredServiceHistory.length;
        },

        loadMoreServiceHistory() {
            this.serviceHistoryLimit += 40;
        },

        toggleReleaseServiceFilter(svc: string) {
            this.releaseServiceFilter = this.releaseServiceFilter === svc ? '' : svc;
        },

        get filteredVersionData(): ChangelogItem[] {
            let data = this.currentVersionData;
            if (this.activeFilter !== 'all') {
                data = data.filter((item) => normalizeChangeType(item.type, item.description).key === this.activeFilter);
            }

            if (this.releaseServiceFilter) {
                const s = this.releaseServiceFilter.toLowerCase().trim();
                data = data.filter((i) => i.category && i.category.toLowerCase().trim() === s);
            }

            if (!this.versionSearch || !this.versionSearch.trim()) return data;
            const s = this.versionSearch.toLowerCase().trim();
            return data.filter((i) =>
                (i.category && i.category.toLowerCase().includes(s)) ||
                (i.description && i.description.toLowerCase().includes(s))
            );
        }
    }));
</script>
