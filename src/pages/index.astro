---
export const prerender = true;

import Layout from '../layouts/Layout.astro';
import LeftRail from '../components/LeftRail.astro';
import MainView from '../components/MainView.astro';
import trackData from '../../public/data/track.json';

const latestVersion = trackData?.versions?.[0] || { id: 'latest', date: '' };

const versionModules = import.meta.glob<Array<{ category: string; description: string; type: string }>>('../../public/data/versions/*.json', { eager: true, import: 'default' });

const latestKey = `../../public/data/versions/${latestVersion.id}.json`;
const initialChanges = versionModules[latestKey] || [];
const pageTitle = "BotoView — AWS Boto3 Changelog Explorer & Release Tracker";
const pageDescription = "Explore and filter AWS Boto3 changelogs by service (S3, Bedrock, Lambda, EC2). Track SDK version updates, API changes, and release notes in real time.";
const canonicalUrl = "https://botoview.5goos.com/";
---

<Layout title={pageTitle} description={pageDescription} canonical={canonicalUrl}>
    <div class="flex h-screen w-full overflow-hidden bg-transparent text-[var(--text-secondary)] transition-all" 
         x-data="botoCore" 
         @keydown.window="handleGlobalKeydown($event)">
        
        <div x-show="showMobileVersions" 
             x-cloak
             x-transition:enter="transition-opacity ease-out duration-300"
             x-transition:enter-start="opacity-0"
             x-transition:enter-end="opacity-100"
             x-transition:leave="transition-opacity ease-in duration-200"
             x-transition:leave-start="opacity-100"
             x-transition:leave-end="opacity-0"
             class="fixed inset-0 bg-slate-900/30 dark:bg-black/60 backdrop-blur-xs z-40 lg:hidden" 
             @click="showMobileVersions = false"></div>

        <div x-show="error" x-cloak x-transition.opacity class="fixed inset-0 z-[150] flex items-center justify-center p-6 bg-[#050505]/90 backdrop-blur-xl">
            <div class="bg-white dark:bg-[#0e131f] border border-red-500/20 text-slate-900 dark:text-white p-8 sm:p-10 rounded-[28px] max-w-lg w-full text-center shadow-2xl relative overflow-hidden">
                <div class="w-16 h-16 bg-red-500/10 rounded-2xl flex items-center justify-center mx-auto mb-6 border border-red-500/20">
                    <svg class="w-8 h-8 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
                </div>
                <h2 class="text-2xl font-black italic uppercase tracking-tight mb-2">Connection Override</h2>
                <p class="text-slate-500 dark:text-slate-400 mb-8 leading-relaxed text-sm mono" x-text="error"></p>
                <button @click="location.reload()" class="w-full bg-indigo-600 hover:bg-indigo-700 text-white font-black py-3.5 px-6 rounded-xl transition-all active:scale-95 shadow-md shadow-indigo-500/25 uppercase tracking-wider text-xs cursor-pointer">
                    Reboot Application
                </button>
            </div>
        </div>

        <div x-show="loading" x-cloak style="display: none;" class="fixed inset-0 z-[140] flex flex-col items-center justify-center bg-white dark:bg-[#07090e] transition-colors duration-500">
            <div class="relative w-16 h-16 mb-6">
                <div class="absolute inset-0 border-3 border-indigo-500/15 rounded-2xl"></div>
                <div class="absolute inset-0 border-3 border-t-indigo-600 dark:border-t-indigo-400 rounded-2xl animate-spin"></div>
                <img src="/favicon.svg" class="absolute inset-0 m-auto w-7 h-7 opacity-80 animate-pulse" alt="Loading" />
            </div>
            <span class="text-xs mono uppercase tracking-widest text-slate-400 font-bold">Initializing Core...</span>
        </div>

        <div class="flex h-full w-full">
            <LeftRail />
            <MainView initialChanges={initialChanges} latestVersion={latestVersion} allServices={trackData.allServices} />
        </div>
    </div>
</Layout>

<script define:vars={{ initialLatestId: latestVersion.id, initialChangesJson: initialChanges, initialServiceCounts: trackData?.serviceCounts || {}, initialAllServices: trackData?.allServices || [] }}>
    document.addEventListener('alpine:init', () => {
        Alpine.data('botoCore', () => ({
            sidebarTab: 'versions', // 'versions' | 'services'
            viewMode: 'release',    // 'release' | 'service'
            selectedVersion: initialLatestId || '',
            navigatedFromVersion: null,
            versions: [],
            allServices: initialAllServices || [],
            serviceCounts: initialServiceCounts || {},
            serviceSort: 'popular',
            currentVersionData: initialChangesJson || [],
            isClientHydrated: true,
            serviceSearch: '',
            versionSearch: '',
            versionRailSearch: '',
            releaseServiceFilter: '',
            activeFilter: 'all',
            railLimit: 50,
            activeService: null,
            serviceHistory: [],
            serviceHistorySearch: '',
            serviceHistoryFilter: 'all',
            serviceVersionFilter: 'all',
            serviceHistoryLimit: 40,
            serviceHistoryLoading: false,
            showMobileVersions: false,
            showBackToTop: false,
            error: null,
            loading: false,
            versionCache: initialLatestId ? { [initialLatestId]: initialChangesJson } : {},
            copyStatus: false,
            copiedItemIndex: null,
            showPipCopied: false,
            isDarkMode: false,
            _versionDateMap: null,
            _serviceColorCache: {},
            stats: {
                avgReleasesPerWeek: 0,
                recentChangesCount: 0
            },

            toggleTheme() {
                this.isDarkMode = !this.isDarkMode;
                document.documentElement.classList.toggle('dark', this.isDarkMode);
                try {
                    localStorage.setItem('theme', this.isDarkMode ? 'dark' : 'light');
                } catch(e) {}
                const themeColor = this.isDarkMode ? '#07090e' : '#f8fafc';
                const metaTheme = document.querySelector('meta[name="theme-color"]');
                if (metaTheme) metaTheme.setAttribute('content', themeColor);
            },

            isMobile(breakpoint = 768) {
                return window.matchMedia(`(max-width: ${breakpoint-1}px)`).matches;
            },

            escapeHtml(str) {
                if (!str) return '';
                return String(str)
                    .replace(/&/g, '&amp;')
                    .replace(/</g, '&lt;')
                    .replace(/>/g, '&gt;')
                    .replace(/"/g, '&quot;')
                    .replace(/'/g, '&#39;');
            },

            highlight(text, search) {
                if (!text) return '';
                let escaped = this.escapeHtml(text);
                if (!search || !search.trim()) return escaped;
                const s = search.trim();
                const regex = new RegExp(`(${s.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')})`, 'gi');
                return escaped.replace(regex, '<mark class="search-highlight">$1</mark>');
            },

            formatDescription(text, search) {
                if (!text) return '';
                let formatted = this.escapeHtml(text);

                formatted = formatted.replace(
                    /`([^`]+?)\s*&lt;(https?:\/\/[^&>]+?)&gt;`_+/g,
                    '<a href="$2" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-0.5 text-indigo-600 dark:text-indigo-400 hover:text-indigo-700 dark:hover:text-indigo-300 font-semibold underline decoration-indigo-400/40 hover:decoration-indigo-500 transition-colors">$1<svg class="w-2.5 h-2.5 opacity-70 inline ml-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg></a>'
                );

                formatted = formatted.replace(
                    /``([^`]+?)``/g,
                    '<code class="px-1.5 py-0.5 rounded-md bg-slate-200/50 dark:bg-white/10 text-[11px] mono text-indigo-700 dark:text-indigo-300 font-medium">$1</code>'
                );

                formatted = formatted.replace(
                    /`([^`]+?)`/g,
                    '<code class="px-1.5 py-0.5 rounded-md bg-slate-200/50 dark:bg-white/10 text-[11px] mono text-indigo-700 dark:text-indigo-300 font-medium">$1</code>'
                );

                formatted = formatted.replace(
                    /(^|[^"'])(https?:\/\/[a-zA-Z0-9\-\._~:\/\?#\[\]@!$&'()*+,;=%]+)/g,
                    '$1<a href="$2" target="_blank" rel="noopener noreferrer" class="text-indigo-600 dark:text-indigo-400 hover:underline font-medium break-all">$2</a>'
                );

                if (search && search.trim()) {
                    const s = search.trim();
                    const escapedSearch = s.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
                    const regex = new RegExp(`(?![^<]*>)(${escapedSearch})`, 'gi');
                    formatted = formatted.replace(regex, '<mark class="search-highlight">$1</mark>');
                }

                return formatted;
            },

            async copyItem(item, index) {
                try {
                    const text = `${item.category.toUpperCase()}: ${item.description} (${this.selectedVersion})`;
                    await navigator.clipboard.writeText(text);
                    this.copiedItemIndex = index;
                    setTimeout(() => {
                        if (this.copiedItemIndex === index) this.copiedItemIndex = null;
                    }, 2000);
                } catch (e) {}
            },

            get versionCounts() {
                let features = 0;
                let fixes = 0;
                for (const i of this.currentVersionData) {
                    if (i.type && i.type.toLowerCase().includes('fix')) {
                        fixes++;
                    } else {
                        features++;
                    }
                }
                return {
                    total: this.currentVersionData.length,
                    features,
                    fixes
                };
            },

            get serviceHistoryCounts() {
                let features = 0;
                let fixes = 0;
                for (const item of this.serviceHistory) {
                    const text = (item.t || '').toLowerCase();
                    if (text.includes('fix')) {
                        fixes++;
                    } else {
                        features++;
                    }
                }
                return {
                    total: this.serviceHistory.length,
                    features,
                    fixes
                };
            },

            get currentActiveFilter() {
                return this.viewMode === 'release' ? this.activeFilter : this.serviceHistoryFilter;
            },

            get currentActiveCounts() {
                return this.viewMode === 'release' ? this.versionCounts : this.serviceHistoryCounts;
            },

            setMainFilter(filter) {
                if (this.viewMode === 'release') {
                    this.activeFilter = filter;
                } else {
                    this.serviceHistoryFilter = filter;
                    this.serviceHistoryLimit = 40;
                }
            },

            switchSidebarTab(tab) {
                this.sidebarTab = tab;
                if (tab === 'versions' && this.viewMode === 'service') {
                    this.backToRelease();
                } else if (tab === 'services' && this.viewMode === 'release' && this.activeService) {
                    this.openService(this.activeService, true, false);
                }
            },

            get currentVersionServices() {
                const s = new Set();
                for (const c of this.currentVersionData) {
                    if (c && c.category) s.add(c.category.toLowerCase().trim());
                }
                return s;
            },

            get adjacentVersions() {
                if (!this.versions.length || !this.selectedVersion) return { newer: null, older: null };
                const idx = this.versions.findIndex(v => v.id === this.selectedVersion);
                if (idx === -1) return { newer: null, older: null };
                return {
                    newer: idx > 0 ? this.versions[idx - 1].id : null,
                    older: idx < this.versions.length - 1 ? this.versions[idx + 1].id : null
                };
            },

            handleGlobalKeydown(e) {
                if (['INPUT', 'TEXTAREA', 'SELECT'].includes(e.target.tagName) || e.target.isContentEditable) {
                    if (e.key === 'Escape') {
                        e.target.blur();
                    }
                    return;
                }

                if (e.key === 'Escape') {
                    this.showMobileVersions = false;
                    if (this.viewMode === 'service') {
                        this.backToRelease();
                    }
                    return;
                }

                if (e.key === 't' || e.key === 'T') {
                    e.preventDefault();
                    this.toggleTheme();
                    return;
                }

                if (e.key === 'j' || e.key === 'ArrowDown') {
                    if (this.adjacentVersions.older) {
                        e.preventDefault();
                        this.selectVersion(this.adjacentVersions.older, true);
                    }
                    return;
                }

                if (e.key === 'k' || e.key === 'ArrowUp') {
                    if (this.adjacentVersions.newer) {
                        e.preventDefault();
                        this.selectVersion(this.adjacentVersions.newer, true);
                    }
                    return;
                }

                if (e.key === '/') {
                    e.preventDefault();
                    const searchInput = document.getElementById('versionSearch') || document.getElementById('serviceHistorySearch');
                    if (searchInput) searchInput.focus();
                    return;
                }
            },

            get selectedDate() {
                return this.getVersionDate(this.selectedVersion);
            },

            getVersionDate(id) {
                if (!id || !this._versionDateMap) return '';
                return this._versionDateMap.get(id) || '';
            },

            getRelativeDate(dateStr) {
                if (!dateStr) return '';
                const date = new Date(dateStr);
                const now = new Date();
                const diffTime = Math.abs(now - date);
                const diffDays = Math.floor(diffTime / (1000 * 60 * 60 * 24));
                
                if (diffDays === 0) return 'Today';
                if (diffDays === 1) return 'Yesterday';
                if (diffDays < 7) return `${diffDays}d ago`;
                if (diffDays < 30) return `${Math.floor(diffDays / 7)}w ago`;
                if (diffDays < 365) return `${Math.floor(diffDays / 30)}mo ago`;
                return `${Math.floor(diffDays / 365)}y ago`;
            },

            formatDate(dateStr) {
                if (!dateStr) return '';
                try {
                    const parts = dateStr.split('-');
                    if (parts.length === 3) {
                        const date = new Date(Date.UTC(Number(parts[0]), Number(parts[1]) - 1, Number(parts[2])));
                        return date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
                    }
                    return dateStr;
                } catch (e) {
                    return dateStr;
                }
            },

            getMonthYear(dateStr) {
                if (!dateStr) return 'Unknown Date';
                const date = new Date(dateStr);
                return date.toLocaleString('default', { month: 'long', year: 'numeric' });
            },

            getServiceColorClass(serviceName) {
                if (!serviceName) return 'bg-slate-500/10 text-slate-700 dark:text-slate-300';
                if (this._serviceColorCache[serviceName]) return this._serviceColorCache[serviceName];
                const classes = [
                    'bg-indigo-500/10 text-indigo-700 dark:text-indigo-300 hover:bg-indigo-500/15',
                    'bg-sky-500/10 text-sky-700 dark:text-sky-300 hover:bg-sky-500/15',
                    'bg-emerald-500/10 text-emerald-700 dark:text-emerald-300 hover:bg-emerald-500/15',
                    'bg-violet-500/10 text-violet-700 dark:text-violet-300 hover:bg-violet-500/15',
                    'bg-rose-500/10 text-rose-700 dark:text-rose-300 hover:bg-rose-500/15',
                    'bg-amber-500/10 text-amber-700 dark:text-amber-300 hover:bg-amber-500/15',
                    'bg-cyan-500/10 text-cyan-700 dark:text-cyan-300 hover:bg-cyan-500/15',
                    'bg-teal-500/10 text-teal-700 dark:text-teal-300 hover:bg-teal-500/15'
                ];
                let hash = 0;
                for (let i = 0; i < serviceName.length; i++) {
                    hash = serviceName.charCodeAt(i) + ((hash << 5) - hash);
                }
                const result = classes[Math.abs(hash) % classes.length];
                this._serviceColorCache[serviceName] = result;
                return result;
            },

            async copyToClipboard(text) {
                try {
                    await navigator.clipboard.writeText(text);
                    this.copyStatus = true;
                    setTimeout(() => this.copyStatus = false, 2000);
                } catch (err) {}
            },

            async prefetchVersion(id) {
                if (this.versionCache[id] || this.selectedVersion === id) return;
                try {
                    const res = await fetch(`/data/versions/${id}.json`);
                    if (res.ok) {
                        this.versionCache[id] = await res.json();
                    }
                } catch (e) {}
            },

            async prefetchService(svc) {
                const serviceId = svc.toLowerCase().trim().replace(/[\._\s]+/g, '-').replace(/-+/g, '-');
                const cacheKey = `svc_${serviceId}`;
                if (this.versionCache[cacheKey]) return;
                try {
                    const res = await fetch(`/data/services/${serviceId}.json`);
                    if (res.ok) {
                        this.versionCache[cacheKey] = await res.json();
                    }
                } catch (e) {}
            },

            async init() {
                this.isDarkMode = document.documentElement.classList.contains('dark');
                try {
                    const res = await fetch('/data/track.json');
                    if (!res.ok) throw new Error('Primary track data missing');
                    const data = await res.json();
                    this.versions = data.versions;
                    this.allServices = data.allServices;
                    if (data.serviceCounts) {
                        this.serviceCounts = data.serviceCounts;
                    }

                    this._versionDateMap = new Map();
                    for (const v of this.versions) {
                        this._versionDateMap.set(v.id, v.date || '');
                    }

                    this.calculateStats();

                    const params = new URLSearchParams(window.location.search);
                    const vParam = params.get('v');
                    const sParam = params.get('s');

                    if (sParam && this.allServices.includes(sParam)) {
                        await this.openService(sParam, false, vParam || null);
                    } else if (vParam && vParam !== initialLatestId && this.versions.find(v => v.id === vParam)) {
                        await this.selectVersion(vParam, false);
                    } else if (vParam === initialLatestId) {
                        this.selectedVersion = initialLatestId;
                        this.currentVersionData = initialChangesJson;
                    } else if (this.versions.length > 0 && !this.selectedVersion) {
                        await this.selectVersion(this.versions[0].id, false);
                    }

                    window.addEventListener('popstate', (e) => {
                        const curParams = new URLSearchParams(window.location.search);
                        const v = curParams.get('v') || (this.versions[0] ? this.versions[0].id : null);
                        const s = curParams.get('s');
                        if (s && this.allServices.includes(s)) {
                            this.openService(s, false, curParams.get('v') || (e.state && e.state.navigatedFromVersion) || null);
                        } else if (v) {
                            this.viewMode = 'release';
                            this.navigatedFromVersion = null;
                            this.selectVersion(v, false);
                        }
                    });
                } catch (e) {
                    this.error = e.message;
                } finally {
                    this.loading = false;
                }
            },

            calculateStats() {
                if (!this.versions.length) return;
                
                const now = new Date();
                const threeMonthsAgo = new Date();
                threeMonthsAgo.setDate(now.getDate() - 90);
                
                const recentVersions = this.versions.filter(v => new Date(v.date) >= threeMonthsAgo);
                const weeks = 90 / 7;
                this.stats.avgReleasesPerWeek = (recentVersions.length / weeks).toFixed(1);

                const thirtyDaysAgo = new Date();
                thirtyDaysAgo.setDate(now.getDate() - 30);
                this.stats.recentChangesCount = this.versions.filter(v => new Date(v.date) >= thirtyDaysAgo).length;
            },

            updateUrl(push = false) {
                const params = new URLSearchParams();
                if (this.viewMode === 'service') {
                    if (this.activeService) params.set('s', this.activeService);
                    if (this.navigatedFromVersion) params.set('v', this.navigatedFromVersion);
                } else {
                    if (this.selectedVersion && this.versions[0] && this.selectedVersion !== this.versions[0].id) {
                        params.set('v', this.selectedVersion);
                    }
                }
                const newUrl = params.toString() ? `?${params.toString()}` : window.location.pathname;
                if (push) {
                    window.history.pushState({ v: this.selectedVersion, s: this.activeService, navigatedFromVersion: this.navigatedFromVersion, viewMode: this.viewMode }, '', newUrl);
                } else {
                    window.history.replaceState({ v: this.selectedVersion, s: this.activeService, navigatedFromVersion: this.navigatedFromVersion, viewMode: this.viewMode }, '', newUrl);
                }
            },

            backToRelease() {
                const targetVersion = this.navigatedFromVersion || this.selectedVersion || (this.versions[0] ? this.versions[0].id : '');
                this.viewMode = 'release';
                this.activeService = null;
                this.navigatedFromVersion = null;
                this.sidebarTab = 'versions';
                if (targetVersion && targetVersion !== this.selectedVersion) {
                    this.selectVersion(targetVersion, true);
                } else {
                    this.updateUrl(true);
                    document.title = `BotoView by 5goos — Release ${this.selectedVersion} | AWS Boto3 Changelog`;
                    const mainArea = document.getElementById('mainScrollArea');
                    if (mainArea) mainArea.scrollTo({ top: 0, behavior: 'instant' });
                    this.syncIndicator(this.selectedVersion, true);
                }
            },

            prefetchAdjacent(currentIndex) {
                if (currentIndex === -1) return;
                if (currentIndex > 0 && this.versions[currentIndex - 1]) {
                    this.prefetchVersion(this.versions[currentIndex - 1].id);
                }
                if (currentIndex < this.versions.length - 1 && this.versions[currentIndex + 1]) {
                    this.prefetchVersion(this.versions[currentIndex + 1].id);
                }
            },

            async selectVersion(id, push = true) {
                if (this.isMobile(1024)) this.showMobileVersions = false;
                this.viewMode = 'release';
                this.sidebarTab = 'versions';
                this.activeService = null;
                this.navigatedFromVersion = null;
                this.releaseServiceFilter = '';
                if (this.selectedVersion === id && this.currentVersionData.length > 0) {
                    this.updateUrl(push);
                    return;
                }
                
                const prevVersion = this.selectedVersion;
                this.selectedVersion = id;

                const idx = this.versions.findIndex(v => v.id === id);
                if (idx !== -1 && idx >= this.railLimit) {
                    this.railLimit = idx + 20;
                }

                this.updateUrl(push);

                if (this.versionCache[id]) {
                    this.currentVersionData = this.versionCache[id];
                    document.title = `BotoView by 5goos — Release ${id} | AWS Boto3 Changelog & Release Notes`;
                    this.syncIndicator(id);
                    this.prefetchAdjacent(idx);
                    return;
                }

                this.currentVersionData = []; 
                document.title = `BotoView by 5goos — Release ${id} | AWS Boto3 Changelog & Release Notes`;
                this.syncIndicator(id, false); 

                try {
                    const res = await fetch(`/data/versions/${id}.json`);
                    if (!res.ok) throw new Error(`Release dossier ${id} missing`);
                    const data = await res.json();
                    this.versionCache[id] = data;
                    
                    if (this.selectedVersion === id) {
                        this.currentVersionData = data;
                        this.syncIndicator(id, true);
                        this.prefetchAdjacent(idx);
                    }
                } catch (e) { 
                    this.error = `Connection lost: ${id}`;
                    this.selectedVersion = prevVersion;
                    if (prevVersion && this.versionCache[prevVersion]) {
                        this.currentVersionData = this.versionCache[prevVersion];
                    }
                    this.updateUrl(false);
                }
            },

            syncIndicator(id, scroll = true) {
                if (scroll) {
                    const mainContent = document.getElementById('mainScrollArea');
                    if (mainContent) mainContent.scrollTo({ top: 0, behavior: 'instant' });
                }

                requestAnimationFrame(() => {
                    this.$nextTick(() => {
                        const active = document.querySelector(`a[data-version="${id}"]`);
                        if (active) {
                            active.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
                        }
                    });
                });
            },

            async openService(svc, push = true, fromVersion = null) {
                this.activeService = svc;
                this.viewMode = 'service';
                this.sidebarTab = 'services';
                if (typeof fromVersion === 'string') {
                    this.navigatedFromVersion = fromVersion;
                } else if (fromVersion === true) {
                    this.navigatedFromVersion = this.selectedVersion || null;
                } else if (fromVersion === false) {
                    this.navigatedFromVersion = null;
                }
                this.serviceHistoryFilter = 'all';
                this.serviceVersionFilter = 'all';
                this.serviceHistoryLimit = 40;
                this.serviceHistorySearch = '';
                this.serviceHistory = [];
                this.serviceHistoryLoading = true;
                this.updateUrl(push);

                document.title = `AWS ${svc.toUpperCase()} Boto3 Changelog & Release Notes | BotoView by 5goos`;

                const mainArea = document.getElementById('mainScrollArea');
                if (mainArea) mainArea.scrollTo({ top: 0, behavior: 'instant' });

                requestAnimationFrame(() => {
                    this.$nextTick(() => {
                        const activeSvcEl = document.querySelector(`[data-service="${svc.toLowerCase().trim()}"]`);
                        if (activeSvcEl) {
                            activeSvcEl.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
                        }
                    });
                });

                const serviceId = svc.toLowerCase().trim().replace(/[\._\s]+/g, '-').replace(/-+/g, '-');
                const cacheKey = `svc_${serviceId}`;

                if (this.versionCache[cacheKey]) {
                    this.serviceHistory = this.versionCache[cacheKey];
                    this.serviceHistoryLoading = false;
                    return;
                }
                
                try {
                    const res = await fetch(`/data/services/${serviceId}.json`);
                    if (!res.ok) throw new Error('Service data unavailable');
                    const data = await res.json();
                    this.versionCache[cacheKey] = data;
                    if (this.activeService === svc) {
                        this.serviceHistory = data;
                    }
                } catch (e) { 
                    if (this.activeService === svc) this.serviceHistory = []; 
                } finally {
                    if (this.activeService === svc) this.serviceHistoryLoading = false;
                }
            },

            get filteredServices() {
                let list = this.allServices || [];
                if (this.serviceSearch) {
                    const s = this.serviceSearch.toLowerCase().trim();
                    list = list.filter(svc => svc.toLowerCase().includes(s));
                }
                if (this.serviceSort === 'popular') {
                    return [...list].sort((a, b) => {
                        const countA = this.serviceCounts[a] || 0;
                        const countB = this.serviceCounts[b] || 0;
                        if (countB !== countA) return countB - countA;
                        return a.localeCompare(b);
                    });
                }
                return [...list].sort((a, b) => a.localeCompare(b));
            },

            _getFilteredVersionsBase() {
                const s = this.versionRailSearch.toLowerCase();
                if (!s) return this.versions;
                return this.versions.filter(v => {
                    const monthYear = this.getMonthYear(v.date).toLowerCase();
                    return v.id.includes(s) || monthYear.includes(s);
                });
            },

            get filteredRailVersions() {
                return this._getFilteredVersionsBase().slice(0, this.railLimit);
            },

            get groupedRailVersions() {
                const groups = [];
                const versions = this.filteredRailVersions;
                
                versions.forEach(v => {
                    const label = this.getMonthYear(v.date);
                    let group = groups.find(g => g.label === label);
                    if (!group) {
                        group = { label, versions: [] };
                        groups.push(group);
                    }
                    group.versions.push(v);
                });
                
                return groups;
            },

            get hasMoreVersions() {
                return this.railLimit < this._getFilteredVersionsBase().length;
            },

            loadMoreVersions() {
                this.railLimit += 50;
            },

            get availableServiceVersionPrefixes() {
                const s = new Set();
                for (const item of this.serviceHistory) {
                    if (item.v) {
                        const parts = item.v.split('.');
                        if (parts.length >= 2) {
                            s.add(`${parts[0]}.${parts[1]}`);
                        }
                    }
                }
                return Array.from(s).slice(0, 10);
            },

            get filteredServiceHistory() {
                let list = this.serviceHistory;
                if (this.serviceHistoryFilter === 'feature') {
                    list = list.filter(item => !(item.t && item.t.toLowerCase().includes('fix')));
                } else if (this.serviceHistoryFilter === 'fix') {
                    list = list.filter(item => item.t && item.t.toLowerCase().includes('fix'));
                }

                if (this.serviceVersionFilter && this.serviceVersionFilter !== 'all') {
                    list = list.filter(item => item.v && item.v.startsWith(this.serviceVersionFilter));
                }

                if (!this.serviceHistorySearch || !this.serviceHistorySearch.trim()) {
                    return list;
                }
                const s = this.serviceHistorySearch.toLowerCase().trim();
                return list.filter(log => (log.v && log.v.toLowerCase().includes(s)) || (log.t && log.t.toLowerCase().includes(s)));
            },

            get visibleServiceHistory() {
                return this.filteredServiceHistory.slice(0, this.serviceHistoryLimit);
            },

            get hasMoreServiceHistory() {
                return this.serviceHistoryLimit < this.filteredServiceHistory.length;
            },

            loadMoreServiceHistory() {
                this.serviceHistoryLimit += 40;
            },

            toggleReleaseServiceFilter(svc) {
                if (this.releaseServiceFilter === svc) {
                    this.releaseServiceFilter = '';
                } else {
                    this.releaseServiceFilter = svc;
                }
            },

            get filteredVersionData() {
                let data = this.currentVersionData;
                if (this.activeFilter === 'feature') {
                    data = data.filter(i => !(i.type && i.type.includes('fix')));
                } else if (this.activeFilter === 'fix') {
                    data = data.filter(i => i.type && i.type.includes('fix'));
                }

                if (this.releaseServiceFilter) {
                    const s = this.releaseServiceFilter.toLowerCase().trim();
                    data = data.filter(i => i.category && i.category.toLowerCase().trim() === s);
                }

                if (!this.versionSearch) return data;
                const s = this.versionSearch.toLowerCase();
                return data.filter(i => 
                    (i.category && i.category.includes(s)) || 
                    (i.description && i.description.toLowerCase().includes(s))
                );
            }
        }));
    });
</script>
